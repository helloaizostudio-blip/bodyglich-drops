# ─────────────────────────────────────────────────────────────
# Pinterest Affiliate Autopilot: environment configuration
# Copy to .env.local (for `npm run dev`) or .env (for the worker)
# and fill in only the integrations you have. NEVER commit real values.
# ─────────────────────────────────────────────────────────────

# Public URL where this app is reachable from the internet.
# Zapier must be able to download pin images from  <PUBLIC_BASE_URL>/api/media/...
PUBLIC_BASE_URL=http://localhost:3000

# Dashboard login. Required when the app is reachable from the internet.
DASHBOARD_PASSWORD=
# Random 32+ char string used to sign sessions and encrypt stored OAuth tokens.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Database. Leave empty for SQLite at ./data/autopilot.db
# For PostgreSQL:  DATABASE_URL=postgres://user:pass@host:5432/autopilot
DATABASE_URL=
SQLITE_PATH=./data/autopilot.db

# Timezone used for the posting schedule
APP_TIMEZONE=Asia/Kolkata

# ── Amazon Associates (amazon.in) ────────────────────────────
# Your Associates tracking ID, e.g. yourname-21. Used to validate affiliate links.
AMAZON_PARTNER_TAG=

# Amazon Creators API (only if your Associates account is eligible).
# Create credentials in Associates Central → Tools → Creators API.
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
# Credential version shown next to your credential (e.g. 3.1 or 2.2)
AMAZON_CREATORS_CREDENTIAL_VERSION=3.1
# Token endpoint for your credential version/region. Check your credential page.
# v3.x (Login with Amazon, EU region incl. India): https://api.amazon.co.uk/auth/o2/token
AMAZON_CREATORS_TOKEN_URL=https://api.amazon.co.uk/auth/o2/token
# v3.x uses "creatorsapi::default"; v2.x uses "creatorsapi/default"
AMAZON_CREATORS_SCOPE=creatorsapi::default
AMAZON_CREATORS_API_BASE=https://creatorsapi.amazon
AMAZON_MARKETPLACE=www.amazon.in

# ── Claude (AI copywriting) ──────────────────────────────────
# Without a key the app falls back to clearly labelled template copy.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ── Higgsfield (optional AI background images) ──────────────
# Key ID and secret from Higgsfield Cloud. Without them, pins use original
# vector/typographic templates rendered locally.
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
HIGGSFIELD_API_BASE=https://platform.higgsfield.ai
HIGGSFIELD_MODEL=higgsfield-ai/soul/standard

# ── Zapier (publishing) ──────────────────────────────────────
# "Catch Hook" URL from a Zap: Webhooks by Zapier (Catch Hook) → Pinterest (Create Pin)
ZAPIER_WEBHOOK_URL=
# Shared secret your Zap sends back to /api/zapier/callback (see README)
ZAPIER_CALLBACK_SECRET=
# Preferred: webhook of a Make scenario (hook.<region>.make.com) or a Zapier Catch Hook.
# Takes precedence over ZAPIER_WEBHOOK_URL.
PIN_WEBHOOK_URL=
# Daily windows (APP_TIMEZONE) when no pin is sent, e.g. 20:15-20:50
PUBLISH_BLACKOUT=

# ── Pinterest API v5 (optional, read-only: boards, analytics, trends) ──
# Create an app at developers.pinterest.com. Redirect URI:
#   <PUBLIC_BASE_URL>/api/pinterest/oauth/callback
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_TRENDS_REGION=IN
