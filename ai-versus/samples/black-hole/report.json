  "script": {
    "title": "Black Hole",
    "hookTop": "5 AIs. 1 black hole.",
    "hookBottom": "Who survives?",
    "narratorIntro": "[urgent, dramatic] Five AIs. One spaceship. And it's getting sucked into a black hole! Who saves the day?",
    "narratorOutro": "[curious] So... which AI would you trust to fly?",
    "endingCaption": "Which AI would you trust to fly?",
    "environment": {
      "prompt": "tiny spaceship cockpit, huge window showing a swirling black hole with an orange-purple accretion disk, blinking consoles, alarm lights",
      "hazard": "space",
      "palette": "deep purple, orange, teal"
    },
    "disclaimer": "Fictional parody · not real AI outputs",
    "lines": [
      {
        "characterId": "chatgpt",
        "text": "[proud, clueless] Easy! Step one: open the window and let the black hole out. Step two... wait, why am I stretching?",
        "emphasis": [
          "window",
          "stretching?"
        ],
        "mood": "cheerful",
        "listenerReaction": "confused",
        "caption": "Easy! Step one: open the window and let the black hole out. Step two... wait, why am I stretching?"
      },
      {
        "characterId": "claude",
        "text": "[calm, determined] Everyone, grab on. We fire the engines right at the edge and slingshot out. I'll steer. I've got you.",
        "emphasis": [
          "slingshot",
          "got"
        ],
        "mood": "calm",
        "listenerReaction": "happy",
        "caption": "Everyone, grab on. We fire the engines right at the edge and slingshot out. I'll steer. I've got you."
      },
      {
        "characterId": "gemini",
        "text": "[sassy, unimpressed] He just tried to open a window in space. Iconic. Move, sweetie. I'll fix the orbit before he helps again.",
        "emphasis": [
          "Iconic.",
          "sweetie."
        ],
        "mood": "smug",
        "listenerReaction": "surprised",
        "caption": "He just tried to open a window in space. Iconic. Move, sweetie. I'll fix the orbit before he helps again."
      },
      {
        "characterId": "grok",
        "text": "[playful, laughing] Relax, guys. Near a black hole, time slows down. So technically... I'm still on my lunch break!",
        "emphasis": [
          "lunch",
          "break!"
        ],
        "mood": "excited",
        "listenerReaction": "happy",
        "caption": "Relax, guys. Near a black hole, time slows down. So technically... I'm still on my lunch break!"
      },
      {
        "characterId": "meta",
        "text": "[whiny, clingy] Nobody let go of me! Promise we stay together forever? Okay, group hug... and one last selfie!",
        "emphasis": [
          "forever?",
          "selfie!"
        ],
        "mood": "worried",
        "listenerReaction": "surprised",
        "caption": "Nobody let go of me! Promise we stay together forever? Okay, group hug... and one last selfie!"
      }
    ]
  },
