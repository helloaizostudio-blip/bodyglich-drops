  "script": {
    "title": "Flooding Elevator",
    "hookTop": "What would 5 AIs do",
    "hookBottom": "if they were trapped in a flooding elevator?",
    "narratorIntro": "[excited] Five AIs are trapped in an elevator... and the water is rising! What would each one do?",
    "narratorOutro": "[curious] So... which AI had the best answer?",
    "endingCaption": "Which AI had the best answer?",
    "environment": {
      "prompt": "interior of a cramped stuck elevator cabin, brushed steel walls, closed doors, glowing control panel, flickering red emergency light, murky blue-green flood water filling the bottom third with ripples, water trickling through the door seam, a floating rubber duck, ceiling emergency hatch",
      "hazard": "water",
      "palette": "steel grey, emergency red, teal water"
    },
    "disclaimer": "Fictional parody · not real AI outputs",
    "lines": [
      {
        "characterId": "chatgpt",
        "text": "[confident, friendly] Okay team, stay calm! Step one: press the alarm. Step two: climb onto the handrail. Step three... I've drafted a fourteen-point escape plan!",
        "emphasis": [
          "calm!",
          "alarm.",
          "fourteen-point"
        ],
        "mood": "cheerful",
        "listenerReaction": "surprised",
        "caption": "Okay team, stay calm! Step one: press the alarm. Step two: climb onto the handrail. Step three... I've drafted a fourteen-point escape plan!"
      },
      {
        "characterId": "claude",
        "text": "[calm, gentle] Before anyone panics, is everyone okay? Good. The ceiling hatch is our way out. Let's lift the smallest of us up... together.",
        "emphasis": [
          "okay?",
          "hatch",
          "together."
        ],
        "mood": "calm",
        "listenerReaction": "happy",
        "caption": "Before anyone panics, is everyone okay? Good. The ceiling hatch is our way out. Let's lift the smallest of us up... together."
      },
      {
        "characterId": "gemini",
        "text": "[fast, excited] Ooh, I just looked it up! Door seals, water pressure, hatch specs... the hatch opens outward! Quick, somebody lift me up!",
        "emphasis": [
          "outward!",
          "Quick,"
        ],
        "mood": "excited",
        "listenerReaction": "surprised",
        "caption": "Ooh, I just looked it up! Door seals, water pressure, hatch specs... the hatch opens outward! Quick, somebody lift me up!"
      },
      {
        "characterId": "grok",
        "text": "[smug, sarcastic] Relax. I already pressed every button. Twice. Worst case? We become the world's first AI submarine.",
        "emphasis": [
          "Twice.",
          "submarine."
        ],
        "mood": "smug",
        "listenerReaction": "confused",
        "caption": "Relax. I already pressed every button. Twice. Worst case? We become the world's first AI submarine."
      },
      {
        "characterId": "meta",
        "text": "[cheerful] Wait, wait, let me post this first! Hashtag elevator pool party! [laughs] Okay, okay... I'm helping!",
        "emphasis": [
          "post",
          "pool",
          "party!"
        ],
        "mood": "cheerful",
        "listenerReaction": "surprised",
        "caption": "Wait, wait, let me post this first! Hashtag elevator pool party! Okay, okay... I'm helping!"
      }
    ]
  },
