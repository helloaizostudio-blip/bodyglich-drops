# ---- AI providers (can also be entered in Dashboard → Settings; dashboard values win) ----
ANTHROPIC_API_KEY=            # Claude: idea generation, scripts, per-AI answers
ELEVENLABS_API_KEY=           # Voices (text-to-speech with timestamps)
FAL_KEY=                      # fal.ai: backgrounds, character sheets, bg removal, optional image-to-video

# ---- Queue ----
REDIS_URL=redis://127.0.0.1:6379
WORKER_CONCURRENCY=1          # renders are CPU heavy; 1 per 4 cores is a good start

# ---- Storage (optional) ----
# Without these, documents + media are stored on local disk under ./data.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=    # server-side only; never expose to the browser
SUPABASE_BUCKET=media

# ---- Paths (optional) ----
# DATA_DIR=data
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
