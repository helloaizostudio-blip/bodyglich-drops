# FRAMEFORGE environment variables. Copy to .env.local for local development.
# Every variable is optional for a first run: with nothing set, FRAMEFORGE uses an embedded
# database and stores uploads on the server disk under ./.data

# --- Security -------------------------------------------------------------------------------
# Long random string. Encrypts saved provider API keys and signs upload links.
# REQUIRED in production if the server disk is not persistent. Generate: openssl rand -hex 32
APP_SECRET=

# One-time code the first-run setup screen asks for. Set it whenever the app is on a public URL.
# SETUP_CODE=

# Set to 1 only if you serve the app over plain http:// in production (not recommended).
# INSECURE_COOKIES=1

# --- Database -------------------------------------------------------------------------------
# PostgreSQL connection string (Neon, Supabase, Railway, RDS…). Leave empty to use the embedded
# database stored in DATA_DIR. Migrations run automatically at startup.
DATABASE_URL=
# DATABASE_POOL_MAX=5

# Where the embedded database, local uploads and the auto-generated secret are stored.
# DATA_DIR=.data

# --- File storage ---------------------------------------------------------------------------
# Leave empty to store uploads on the server disk (DATA_DIR/storage).
# On Netlify set STORAGE_DRIVER=netlify to use Netlify Blobs (no other storage settings needed).
# STORAGE_DRIVER=
# To use any S3-compatible bucket (AWS S3, Cloudflare R2, Supabase Storage, Backblaze B2, MinIO)
# set the four values below. The bucket needs a CORS rule allowing PUT from your site's origin.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=1
# MAX_UPLOAD_MB=1024

# --- AI providers (optional) ----------------------------------------------------------------
# Keys can be entered in the app under Settings → AI providers (stored encrypted), or supplied
# here instead. A key saved in Settings takes priority. Nothing is generated until a provider
# has been verified in Settings, and every generation is billed by the provider to your account.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# FRAMEFORGE_OPENAI_BASE_URL=https://api.openai.com/v1
# FRAMEFORGE_ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# --- Rendering ------------------------------------------------------------------------------
# Path to the ffmpeg binary if it is not on PATH. The included Dockerfile installs ffmpeg.
# FFMPEG_PATH=/usr/bin/ffmpeg
