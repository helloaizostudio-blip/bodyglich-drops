          <Item class="ModuleScript" referent="45">
            <Properties>
              <string name="Name">CustomerRenderer</string>
              <string name="Source"><![CDATA[-- Draws and animates NPC customers on this client.
--
-- The server only replicates one invisible part per customer with attributes
-- describing it (see Server/Services/CustomerService). Here we build the visible
-- Blockhead, walk it along MoveFrom -> MoveTo, and show its order bubble and
-- patience bar. Nothing in this file affects gameplay.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Make = require(Shared.Modules.Make)
local Theme = require(Shared.Config.Theme)
local Customers = require(Shared.Config.Customers)
local Characters = require(Shared.Config.Characters)
local Products = require(Shared.Config.Products)
local BlockheadBuilder = require(Shared.Modules.BlockheadBuilder)

local CustomerRenderer = {}

local TAG = "Customer"
local records: { [BasePart]: any } = {}

local function lookFor(root: BasePart)
	local characterId = root:GetAttribute("CharacterId")
	local character = characterId and Characters.ById[characterId]
	if character then
		return character.Look
	end
	local look = BlockheadBuilder.randomLook(root:GetAttribute("Seed") or 1)
	local customerType = Customers.ById[root:GetAttribute("CType")]
	if customerType then
		if customerType.Shirt then
			look.Shirt = customerType.Shirt
		end
		if customerType.Hat then
			look.Hat = customerType.Hat
			look.HatColor = if customerType.Id == "VIP" then Theme.Yellow else Theme.Dark
		end
	end
	return look
end

local function orderEmojis(root: BasePart): string
	local text = ""
	for _, productId in string.split(root:GetAttribute("Order") or "", ",") do
		local product = Products.ById[productId]
		if product then
			text ..= product.Emoji
		end
	end
	return text
end

local function buildBubble(root: BasePart, record)
	local customerType = Customers.ById[root:GetAttribute("CType")]
	local gui = Make("BillboardGui", {
		Name = "Bubble",
		Size = UDim2.fromScale(4.6, 2.6),
		StudsOffsetWorldSpace = Vector3.new(0, 8.4, 0),
		MaxDistance = 85,
		LightInfluence = 0,
		Parent = root,
	})
	local bubble = Make("Frame", {
		Size = UDim2.fromScale(1, 0.7),
		BackgroundColor3 = Theme.White,
		BorderSizePixel = 0,
		Parent = gui,
	})
	Make("UICorner", { CornerRadius = UDim.new(0.3, 0), Parent = bubble })
	Make("UIStroke", { Thickness = 2.5, Color = Theme.Dark, Parent = bubble })
	local order = Make("TextLabel", {
		Size = UDim2.fromScale(0.94, 0.9),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		Text = orderEmojis(root),
		TextScaled = true,
		Font = Theme.Font,
		TextColor3 = Theme.Dark,
		Parent = bubble,
	})
	if customerType and customerType.Id ~= "Normal" then
		Make("TextLabel", {
			Name = "Badge",
			Size = UDim2.fromScale(0.32, 0.6),
			Position = UDim2.fromScale(1, 0),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundTransparency = 1,
			Text = customerType.Emoji,
			TextScaled = true,
			Font = Theme.Font,
			Parent = bubble,
		})
	end
	local barBack = Make("Frame", {
		Size = UDim2.fromScale(0.9, 0.16),
		Position = UDim2.fromScale(0.05, 0.8),
		BackgroundColor3 = Theme.Dark,
		BorderSizePixel = 0,
		Visible = false,
		Parent = gui,
	})
	Make("UICorner", { CornerRadius = UDim.new(1, 0), Parent = barBack })
	local fill = Make("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Green,
		BorderSizePixel = 0,
		Parent = barBack,
	})
	Make("UICorner", { CornerRadius = UDim.new(1, 0), Parent = fill })

	record.Bubble = bubble
	record.OrderLabel = order
	record.BarBack = barBack
	record.BarFill = fill
end

local function readAttributes(root: BasePart, record)
	record.MoveFrom = root:GetAttribute("MoveFrom")
	record.MoveTo = root:GetAttribute("MoveTo")
	record.MoveStart = root:GetAttribute("MoveStart") or 0
	record.MoveDur = root:GetAttribute("MoveDur") or 0
	record.Face = root:GetAttribute("Face")
	record.PatienceStart = root:GetAttribute("PatienceStart")
	record.PatienceDur = root:GetAttribute("PatienceDur") or 0
	local mood = root:GetAttribute("Mood")
	if mood ~= record.Mood then
		record.Mood = mood
		if mood and record.OrderLabel then
			record.OrderLabel.Text = if mood == "Happy" then "😄" else "😡"
			record.Bubble.BackgroundColor3 = if mood == "Happy" then Color3.fromRGB(214, 255, 220) else Color3.fromRGB(255, 214, 214)
		end
	end
	record.Settled = false
end

local function onAdded(root: Instance)
	if records[root :: BasePart] or not root:IsA("BasePart") then
		return
	end
	local record = { Root = root, Settled = false, Phase = math.random() * 6 }
	records[root] = record
	BlockheadBuilder.attach(root, lookFor(root))
	buildBubble(root, record)
	readAttributes(root, record)
	record.Connection = root.AttributeChanged:Connect(function()
		readAttributes(root, record)
	end)
end

local function onRemoved(root: Instance)
	local record = records[root :: BasePart]
	if record then
		records[root :: BasePart] = nil
		if record.Connection then
			record.Connection:Disconnect()
		end
	end
end

local function step()
	local now = Workspace:GetServerTimeNow()
	for root, record in records do
		if root.Parent == nil then
			onRemoved(root)
			continue
		end
		-- Walking.
		if not record.Settled and record.MoveFrom and record.MoveTo then
			local from: Vector3, to: Vector3 = record.MoveFrom, record.MoveTo
			local alpha = if record.MoveDur > 0 then math.clamp((now - record.MoveStart) / record.MoveDur, 0, 1) else 1
			local position = from:Lerp(to, alpha)
			local direction = to - from
			if alpha >= 1 then
				record.Settled = true
				-- Standing still: face the counter while queueing.
				local target = if record.Face and not record.Mood then record.Face else position + direction
				local flat = Vector3.new(target.X, position.Y, target.Z)
				if (flat - position).Magnitude > 0.05 then
					root.CFrame = CFrame.lookAt(position, flat)
				else
					root.CFrame = CFrame.new(position)
				end
			else
				local hop = math.abs(math.sin((now + record.Phase) * 9)) * 0.35
				local flat = Vector3.new(direction.X, 0, direction.Z)
				local base = position + Vector3.new(0, hop, 0)
				if flat.Magnitude > 0.05 then
					root.CFrame = CFrame.lookAt(base, base + flat)
				else
					root.CFrame = CFrame.new(base)
				end
			end
		end

		-- Patience bar.
		if record.PatienceDur > 0 and record.PatienceStart and not record.Mood then
			local left = 1 - math.clamp((now - record.PatienceStart) / record.PatienceDur, 0, 1)
			record.BarBack.Visible = true
			record.BarFill.Size = UDim2.fromScale(left, 1)
			record.BarFill.BackgroundColor3 = if left > 0.5 then Theme.Green elseif left > 0.25 then Theme.Orange else Theme.Red
		elseif record.BarBack.Visible then
			record.BarBack.Visible = false
		end
	end
end

function CustomerRenderer.Start()
	CollectionService:GetInstanceAddedSignal(TAG):Connect(onAdded)
	CollectionService:GetInstanceRemovedSignal(TAG):Connect(onRemoved)
	for _, root in CollectionService:GetTagged(TAG) do
		onAdded(root)
	end
	RunService.RenderStepped:Connect(step)
end

return CustomerRenderer
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[-- Turns server notifications into feedback: floating coin popups, sounds, toasts
-- and big banners. Purely cosmetic.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Make = require(Shared.Modules.Make)
local Theme = require(Shared.Config.Theme)
local Characters = require(Shared.Config.Characters)
local Format = require(Shared.Modules.Format)
local Kit = require(script.Parent.Parent.UI.Kit)
local State = require(script.Parent.State)
local Hud = require(script.Parent.Hud)

local Effects = {}

-- Text that floats up from a point in the world and fades out.
local function floatText(position: Vector3, text: string, color: Color3, scale: number?)
	local anchor = Make("Part", {
		Name = "PopupAnchor",
		Size = Vector3.new(0.2, 0.2, 0.2),
		CFrame = CFrame.new(position + Vector3.new(0, 6, 0)),
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Transparency = 1,
		Parent = Workspace,
	})
	local size = scale or 1
	local gui = Make("BillboardGui", {
		Size = UDim2.fromScale(7 * size, 2 * size),
		StudsOffset = Vector3.new(0, 0, 0),
		AlwaysOnTop = true,
		MaxDistance = 120,
		LightInfluence = 0,
		Parent = anchor,
	})
	local label = Make("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = text,
		TextScaled = true,
		Font = Theme.Font,
		TextColor3 = color,
		Parent = gui,
	})
	local stroke = Make("UIStroke", { Thickness = 3, Color = Theme.Dark, Parent = label })
	Kit.tween(gui, 1.1, { StudsOffset = Vector3.new(0, 4.5, 0) })
	task.delay(0.6, function()
		Kit.tween(label, 0.5, { TextTransparency = 1 })
		Kit.tween(stroke, 0.5, { Transparency = 1 })
	end)
	task.delay(1.2, function()
		anchor:Destroy()
	end)
end

local handlers = {}

function handlers.Sale(data)
	local text = "+" .. Format.coins(data.Amount)
	if data.Fast then
		text ..= " ⚡"
	end
	local special = data.Type == "VIP" or data.Type == "Rich" or data.Type == "Character"
	floatText(data.Position, text, if special then Theme.Orange else Theme.Yellow, if special then 1.3 else 1)
	-- The coin sound climbs in pitch with the combo.
	Kit.playSound("Coin", 1 + math.min(data.Combo or 0, 12) * 0.04)
end

function handlers.Lost(data)
	floatText(data.Position, "😡 Left!", Theme.Red)
	Kit.playSound("Lost")
end

function handlers.Collect(data)
	floatText(data.Position, "+" .. Format.coins(data.Amount) .. " collected", Theme.Green, 1.2)
	Kit.playSound("Purchase")
end

function handlers.Toast(data)
	Hud.toast(data.Text, data.Kind)
end

function handlers.LevelUp(data)
	Hud.banner(`⭐ LEVEL {data.Level}!`, "Bonus +" .. Format.coins(data.Reward), Theme.Purple, "LevelUp")
end

function handlers.Reward(data)
	Hud.banner(data.Title, "+" .. Format.coins(data.Coins), Theme.Green, "LevelUp")
end

function handlers.RushWarning()
	Hud.banner("CUSTOMER RUSH STARTING!", "Race to your shop and serve fast!", Theme.Red, "Rush", 3.2)
end

function handlers.RushResult(data)
	local medal = if data.Rank == 1 then "🥇 1st place!" elseif data.Rank == 2 then "🥈 2nd place!" elseif data.Rank == 3 then "🥉 3rd place!" else `#{data.Rank}`
	local prize = if data.Coins > 0 then `  +{Format.coins(data.Coins)}` else ""
	Hud.banner("Rush over - " .. medal, `{data.Points} points{prize}`, Theme.Orange, "LevelUp", 3.4)
end

function handlers.CharacterUnlocked(data)
	local character = Characters.ById[data.Id]
	if character then
		Hud.banner("NEW BLOCKHEAD!", `{character.Name} - {character.Rarity}`, Characters.Rarities[character.Rarity].Color, "LevelUp", 3.2)
	end
end

function Effects.Start()
	State.Notified:Connect(function(kind, data)
		local handler = handlers[kind]
		if handler then
			handler(data)
		end
	end)
	State.Message:Connect(function(_, kind)
		if kind == "Success" then
			Kit.playSound("Purchase")
		end
	end)
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[-- The always-visible HUD (coins, level, menu buttons, rush banner, toasts) and the
-- manager for pop-up panels. Everything is created from code into one ScreenGui in
-- PlayerGui called "BlockheadsUI" - there is nothing to set up in StarterGui.
--
-- Layout (kept clear of the mobile thumbstick and jump button):
--   top centre    coins, level + XP, combo, rush banner, toasts
--   top left      Quests, Daily, Rush, My Shop, Settings
--   bottom centre Shop, Team, Upgrades, Collection

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Theme = require(Shared.Config.Theme)
local Format = require(Shared.Modules.Format)
local Formulas = require(Shared.Modules.Formulas)
local Kit = require(script.Parent.Parent.UI.Kit)
local State = require(script.Parent.State)

local Hud = {
	Gui = nil :: ScreenGui?,
	Root = nil :: Frame?,
	Panels = {} :: { [string]: any },
	OpenName = nil :: string?,
}

local player = Players.LocalPlayer
local uiScale: UIScale
local backdrop: TextButton
local coinLabel: TextLabel
local levelLabel: TextLabel
local xpFill: Frame
local comboLabel: TextLabel
local rushBanner: Frame
local rushTitle: TextLabel
local rushLine: TextLabel
local toastHolder: Frame
local bannerFrame: Frame
local bannerTitle: TextLabel
local bannerSub: TextLabel
local hintFrame: Frame
local hintLabel: TextLabel
local badges: { [string]: Frame } = {}
local bannerQueue: { any } = {}
local bannerBusy = false
local lastCoins: number? = nil

---------------------------------------------------------------------------------------
-- Scaling
---------------------------------------------------------------------------------------

local function rescale()
	local camera = Workspace.CurrentCamera
	local size = if camera then camera.ViewportSize else Vector2.new(1280, 720)
	local scale = math.clamp(math.min(size.X / 1280, size.Y / 720), 0.6, 1.35)
	uiScale.Scale = scale
	-- The root is sized up by 1/scale so that after scaling it still fills the screen.
	Hud.Root.Size = UDim2.fromScale(1 / scale, 1 / scale)
end

---------------------------------------------------------------------------------------
-- Panels
---------------------------------------------------------------------------------------

-- Creates an empty pop-up panel. Returns the content frame to fill in.
function Hud.newPanel(name: string, title: string, size: Vector2?): Frame
	local dimensions = size or Vector2.new(660, 470)
	-- A text-less button rather than a Frame: it swallows clicks, so tapping the
	-- panel background (or a disabled button) does not fall through to the backdrop
	-- and close the panel.
	local frame = Kit.make("TextButton", {
		Name = name .. "Panel",
		Size = UDim2.fromOffset(dimensions.X, dimensions.Y),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Theme.Panel,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		Visible = false,
		ZIndex = 20,
		Parent = Hud.Root,
	})
	Kit.round(frame, 22)
	Kit.stroke(frame, 4)
	Kit.make("UIScale", { Name = "Pop", Parent = frame })

	local header = Kit.frame({
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 58),
		BackgroundColor3 = Theme.Yellow,
		Parent = frame,
	})
	Kit.round(header, 22)
	-- Square off the header's bottom corners.
	Kit.frame({ Size = UDim2.new(1, 0, 0, 22), Position = UDim2.new(0, 0, 1, -22), BackgroundColor3 = Theme.Yellow, Parent = header })
	Kit.frame({ Size = UDim2.new(1, 0, 0, 4), Position = UDim2.new(0, 0, 1, -2), BackgroundColor3 = Theme.Dark, Parent = header })
	Kit.title({
		Name = "Title",
		Size = UDim2.new(1, -120, 1, 0),
		Position = UDim2.fromOffset(60, 0),
		Text = title,
		TextSize = 30,
		Parent = header,
	})
	Kit.button({
		Name = "Close",
		Size = UDim2.fromOffset(44, 44),
		Position = UDim2.new(1, -8, 0, 7),
		AnchorPoint = Vector2.new(1, 0),
		Color = Theme.Red,
		Text = "X",
		TextSize = 24,
		OnClick = function()
			Hud.close()
		end,
		Parent = header,
	})

	return Kit.frame({
		Name = "Content",
		Size = UDim2.new(1, -28, 1, -86),
		Position = UDim2.fromOffset(14, 72),
		BackgroundTransparency = 1,
		Parent = frame,
	})
end

-- Adds a row of tab buttons to a panel content frame.
-- Returns { [tabName] = pageFrame } and a function select(tabName).
function Hud.newTabs(content: Frame, names: { string })
	local bar = Kit.frame({ Name = "Tabs", Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, Parent = content })
	Kit.list(bar, 8, true)
	local pages, buttons = {}, {}
	local function selectTab(target: string)
		for name, page in pages do
			page.Visible = name == target
			buttons[name].BackgroundColor3 = if name == target then Theme.Blue else Theme.Grey
		end
	end
	for index, name in names do
		buttons[name] = Kit.button({
			Size = UDim2.fromOffset(150, 40),
			LayoutOrder = index,
			Color = Theme.Grey,
			Text = name,
			TextSize = 18,
			OnClick = function()
				selectTab(name)
			end,
			Parent = bar,
		})
		pages[name] = Kit.frame({
			Name = name,
			Size = UDim2.new(1, 0, 1, -52),
			Position = UDim2.fromOffset(0, 52),
			BackgroundTransparency = 1,
			Visible = false,
			Parent = content,
		})
	end
	selectTab(names[1])
	return pages, selectTab
end

function Hud.registerPanel(name: string, panel: any)
	Hud.Panels[name] = panel
end

function Hud.close()
	local name = Hud.OpenName
	if not name then
		return
	end
	Hud.OpenName = nil
	Hud.Panels[name].Frame.Visible = false
	backdrop.Visible = false
end

-- Opens a panel by name. "Shop:Style" opens the Shop panel on its Style tab.
function Hud.open(target: string)
	local name, tab = target, nil
	local split = string.find(target, ":", 1, true)
	if split then
		name, tab = string.sub(target, 1, split - 1), string.sub(target, split + 1)
	end
	local panel = Hud.Panels[name]
	if not panel then
		return
	end
	if Hud.OpenName and Hud.OpenName ~= name then
		Hud.close()
	end
	Hud.OpenName = name
	backdrop.Visible = true
	panel.Frame.Visible = true
	if panel.Opened then
		panel.Opened(tab)
	end
	if State.Profile and panel.Refresh then
		panel.Refresh(State.Profile)
	end
	local pop = panel.Frame:FindFirstChild("Pop")
	if pop then
		pop.Scale = 0.85
		Kit.tween(pop, 0.18, { Scale = 1 }, Enum.EasingStyle.Back)
	end
end

function Hud.toggle(target: string)
	local name = string.split(target, ":")[1]
	if Hud.OpenName == name then
		Hud.close()
	else
		Hud.open(target)
	end
end

---------------------------------------------------------------------------------------
-- Toasts, banners, hints
---------------------------------------------------------------------------------------

local TOAST_COLORS = {
	Success = Theme.Green,
	Error = Theme.Red,
	Reward = Theme.Orange,
	Info = Theme.Blue,
}

function Hud.toast(text: string, kind: string?)
	local children = toastHolder:GetChildren()
	local count = 0
	for _, child in children do
		if child:IsA("Frame") then
			count += 1
		end
	end
	if count >= 4 then
		return
	end
	local toast = Kit.frame({
		Size = UDim2.fromOffset(440, 40),
		BackgroundColor3 = TOAST_COLORS[kind or "Info"] or Theme.Blue,
		Parent = toastHolder,
	})
	Kit.round(toast, 12)
	Kit.stroke(toast, 2.5)
	Kit.title({ Size = UDim2.new(1, -16, 1, 0), Position = UDim2.fromOffset(8, 0), Text = text, TextSize = 18, TextScaled = true, Parent = toast })
	Kit.make("UITextSizeConstraint", { MaxTextSize = 18, MinTextSize = 10, Parent = toast:FindFirstChildOfClass("TextLabel") })
	if kind == "Error" then
		Kit.playSound("Error")
	end
	task.delay(3, function()
		toast:Destroy()
	end)
end

local function showNextBanner()
	if bannerBusy then
		return
	end
	local item = table.remove(bannerQueue, 1)
	if not item then
		return
	end
	bannerBusy = true
	bannerTitle.Text = item.Title
	bannerSub.Text = item.Subtitle or ""
	bannerFrame.BackgroundColor3 = item.Color or Theme.Orange
	bannerFrame.Visible = true
	local pop = bannerFrame:FindFirstChild("Pop") :: UIScale
	pop.Scale = 0.6
	Kit.tween(pop, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	if item.Sound then
		Kit.playSound(item.Sound)
	end
	task.delay(item.Seconds or 2.6, function()
		bannerFrame.Visible = false
		bannerBusy = false
		showNextBanner()
	end)
end

-- A big centred announcement. Banners queue up and show one at a time.
function Hud.banner(title: string, subtitle: string?, color: Color3?, sound: string?, seconds: number?)
	table.insert(bannerQueue, { Title = title, Subtitle = subtitle, Color = color, Sound = sound, Seconds = seconds })
	showNextBanner()
end

-- The tutorial / helper line above the bottom buttons. nil hides it.
function Hud.setHint(text: string?)
	hintFrame.Visible = text ~= nil
	if text then
		hintLabel.Text = text
	end
end

---------------------------------------------------------------------------------------
-- HUD construction
---------------------------------------------------------------------------------------

local function menuButton(parent: Instance, order: number, emoji: string, caption: string, color: Color3, onClick: () -> (), small: boolean?): TextButton
	local button = Kit.button({
		Name = caption,
		Size = if small then UDim2.fromOffset(66, 62) else UDim2.fromOffset(78, 72),
		LayoutOrder = order,
		Color = color,
		Text = "",
		OnClick = onClick,
		Parent = parent,
	})
	Kit.text({
		Size = UDim2.new(1, 0, 0, if small then 34 else 40),
		Position = UDim2.fromOffset(0, 4),
		Text = emoji,
		TextSize = if small then 28 else 34,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = button,
	})
	Kit.title({
		Size = UDim2.new(1, 0, 0, 22),
		Position = UDim2.new(0, 0, 1, -26),
		Text = caption,
		TextSize = if small then 13 else 15,
		Parent = button,
	})
	local badge = Kit.frame({
		Name = "Badge",
		Size = UDim2.fromOffset(20, 20),
		Position = UDim2.new(1, -4, 0, 4),
		AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = Theme.Red,
		Visible = false,
		Parent = button,
	})
	Kit.round(badge, 10)
	Kit.stroke(badge, 2, Theme.White)
	badges[caption] = badge
	return button
end

local function build()
	local gui = Kit.make("ScreenGui", {
		Name = "BlockheadsUI",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 10,
	})
	Hud.Gui = gui
	local root = Kit.frame({ Name = "Root", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = gui })
	Hud.Root = root
	uiScale = Kit.make("UIScale", { Parent = root })

	-- Top bar: coins + level.
	local top = Kit.frame({
		Name = "Top",
		Size = UDim2.fromOffset(460, 50),
		Position = UDim2.new(0.5, 0, 0, 8),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 1,
		Parent = root,
	})
	Kit.list(top, 12, true, { HorizontalAlignment = Enum.HorizontalAlignment.Center })

	local coinPill = Kit.frame({ Name = "Coins", Size = UDim2.fromOffset(220, 50), LayoutOrder = 1, BackgroundColor3 = Theme.Yellow, Parent = top })
	Kit.round(coinPill, 25)
	Kit.stroke(coinPill, 3)
	Kit.make("UIScale", { Name = "Pulse", Parent = coinPill })
	coinLabel = Kit.title({ Size = UDim2.new(1, -20, 1, 0), Position = UDim2.fromOffset(10, 0), Text = "🪙 0", TextSize = 26, Parent = coinPill })

	local levelPill = Kit.frame({ Name = "Level", Size = UDim2.fromOffset(200, 50), LayoutOrder = 2, BackgroundColor3 = Theme.Blue, ClipsDescendants = true, Parent = top })
	Kit.round(levelPill, 25)
	Kit.stroke(levelPill, 3)
	xpFill = Kit.frame({ Name = "XP", Size = UDim2.fromScale(0, 1), BackgroundColor3 = Theme.Purple, Parent = levelPill })
	Kit.round(xpFill, 25) -- ClipsDescendants does not clip to rounded corners
	levelLabel = Kit.title({ Size = UDim2.fromScale(1, 1), Text = "⭐ Level 1", TextSize = 22, ZIndex = 2, Parent = levelPill })

	comboLabel = Kit.title({
		Name = "Combo",
		Size = UDim2.fromOffset(460, 28),
		Position = UDim2.new(0.5, 0, 0, 62),
		AnchorPoint = Vector2.new(0.5, 0),
		Text = "",
		TextSize = 22,
		TextColor3 = Theme.Orange,
		Visible = false,
		Parent = root,
	})

	-- Rush banner.
	rushBanner = Kit.frame({
		Name = "Rush",
		Size = UDim2.fromOffset(480, 70),
		Position = UDim2.new(0.5, 0, 0, 94),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Theme.Red,
		Visible = false,
		Parent = root,
	})
	Kit.round(rushBanner, 16)
	Kit.stroke(rushBanner, 3)
	rushTitle = Kit.title({ Size = UDim2.new(1, 0, 0, 36), Position = UDim2.fromOffset(0, 2), Text = "", TextSize = 26, Parent = rushBanner })
	rushLine = Kit.title({ Size = UDim2.new(1, -16, 0, 26), Position = UDim2.fromOffset(8, 38), Text = "", TextSize = 16, TextTruncate = Enum.TextTruncate.AtEnd, Parent = rushBanner })

	-- Toasts.
	toastHolder = Kit.frame({
		Name = "Toasts",
		Size = UDim2.fromOffset(440, 200),
		Position = UDim2.new(0.5, 0, 0, 172),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 1,
		ZIndex = 40,
		Parent = root,
	})
	Kit.list(toastHolder, 6)

	-- Top-left row. It sits along the top edge on purpose: on phones the lower-left
	-- of the screen is the movement thumbstick area and must stay empty.
	local left = Kit.frame({
		Name = "TopLeft",
		Size = UDim2.fromOffset(360, 62),
		Position = UDim2.fromOffset(12, 8),
		BackgroundTransparency = 1,
		Parent = root,
	})
	Kit.list(left, 6, true)
	menuButton(left, 1, "📜", "Quests", Theme.Purple, function()
		Hud.toggle("Quests")
	end, true)
	menuButton(left, 2, "🎁", "Daily", Theme.Green, function()
		Hud.toggle("Daily")
	end, true)
	menuButton(left, 3, "⚡", "Rush", Theme.Red, function()
		Hud.toggle("Rush")
	end, true)
	menuButton(left, 4, "🏠", "My Shop", Theme.Blue, function()
		State.action("TeleportHome")
	end, true)
	menuButton(left, 5, "⚙️", "Settings", Theme.Grey, function()
		Hud.toggle("Settings")
	end, true)

	-- Bottom row.
	local bottom = Kit.frame({
		Name = "Bottom",
		Size = UDim2.fromOffset(360, 72),
		Position = UDim2.new(0.5, 0, 1, -10),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundTransparency = 1,
		Parent = root,
	})
	Kit.list(bottom, 10, true, { HorizontalAlignment = Enum.HorizontalAlignment.Center })
	menuButton(bottom, 1, "🛒", "Shop", Theme.Orange, function()
		Hud.toggle("Shop")
	end)
	menuButton(bottom, 2, "🧱", "Team", Theme.Blue, function()
		Hud.toggle("Characters:Team")
	end)
	menuButton(bottom, 3, "⬆️", "Upgrades", Theme.Green, function()
		Hud.toggle("Upgrades")
	end)
	menuButton(bottom, 4, "📖", "Collection", Theme.Pink, function()
		Hud.toggle("Characters:Collection")
	end)

	-- Tutorial hint.
	hintFrame = Kit.frame({
		Name = "Hint",
		Size = UDim2.fromOffset(520, 50),
		Position = UDim2.new(0.5, 0, 1, -92),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundColor3 = Theme.Dark,
		BackgroundTransparency = 0.15,
		Visible = false,
		Parent = root,
	})
	Kit.round(hintFrame, 14)
	Kit.stroke(hintFrame, 2.5, Theme.Yellow)
	hintLabel = Kit.text({
		Size = UDim2.new(1, -20, 1, -8),
		Position = UDim2.fromOffset(10, 4),
		TextColor3 = Theme.White,
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = hintFrame,
	})

	-- Dark backdrop behind panels; clicking it closes the open panel.
	backdrop = Kit.make("TextButton", {
		Name = "Backdrop",
		Modal = true, -- frees the mouse in first person / shift-lock while a panel is open
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.55,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		Visible = false,
		ZIndex = 15,
		Parent = root,
	})
	backdrop.Activated:Connect(function()
		Hud.close()
	end)

	-- Announcement banner.
	bannerFrame = Kit.frame({
		Name = "Banner",
		Size = UDim2.fromOffset(560, 120),
		Position = UDim2.fromScale(0.5, 0.3),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Theme.Orange,
		Visible = false,
		ZIndex = 50,
		Parent = root,
	})
	Kit.round(bannerFrame, 22)
	Kit.stroke(bannerFrame, 4)
	Kit.make("UIScale", { Name = "Pop", Parent = bannerFrame })
	bannerTitle = Kit.title({ Size = UDim2.new(1, -20, 0, 60), Position = UDim2.fromOffset(10, 8), TextSize = 36, TextScaled = true, ZIndex = 51, Parent = bannerFrame })
	Kit.make("UITextSizeConstraint", { MaxTextSize = 36, MinTextSize = 14, Parent = bannerTitle })
	bannerSub = Kit.title({ Size = UDim2.new(1, -20, 0, 40), Position = UDim2.fromOffset(10, 70), TextSize = 22, TextScaled = true, ZIndex = 51, Parent = bannerFrame })
	Kit.make("UITextSizeConstraint", { MaxTextSize = 22, MinTextSize = 12, Parent = bannerSub })

	gui.Parent = player:WaitForChild("PlayerGui")
end

---------------------------------------------------------------------------------------
-- Live updates
---------------------------------------------------------------------------------------

function Hud.setBadge(caption: string, visible: boolean)
	local badge = badges[caption]
	if badge then
		badge.Visible = visible
	end
end

local function refresh(profile)
	coinLabel.Text = Format.coins(profile.Coins)
	if lastCoins and profile.Coins > lastCoins then
		local pulse = coinLabel.Parent:FindFirstChild("Pulse")
		if pulse then
			pulse.Scale = 1.12
			Kit.tween(pulse, 0.25, { Scale = 1 })
		end
	end
	lastCoins = profile.Coins

	levelLabel.Text = `⭐ Level {profile.Level}`
	local needed = Formulas.xpForLevel(profile.Level)
	xpFill.Size = UDim2.fromScale(math.clamp(profile.XP / needed, 0, 1), 1)

	Kit.SfxEnabled = profile.Settings.Sfx ~= false

	-- Notification dots.
	local questReady = false
	for _, quest in profile.Quests.List do
		if quest.Progress >= quest.Goal and not quest.Claimed then
			questReady = true
		end
	end
	Hud.setBadge("Quests", questReady)
	Hud.setBadge("Daily", profile.Daily.LastDay < Formulas.dayNumber(os.time()))

	local open = Hud.OpenName and Hud.Panels[Hud.OpenName]
	if open and open.Refresh then
		open.Refresh(profile)
	end
end

local function refreshCombo()
	local combo = player:GetAttribute("Combo") or 0
	if combo >= 2 then
		comboLabel.Text = `🔥 x{combo} COMBO  +{Format.percent(Formulas.comboBonus(combo - 1))}`
		comboLabel.Visible = true
	else
		comboLabel.Visible = false
	end
end

local function place(rank: number): string
	return if rank == 1 then "🥇" elseif rank == 2 then "🥈" elseif rank == 3 then "🥉" else `#{rank}`
end

local function refreshRush()
	local rush = State.Rush
	local now = Workspace:GetServerTimeNow()
	Hud.setBadge("Rush", rush.Phase ~= "Idle")
	if rush.Phase == "Active" then
		rushBanner.Visible = true
		rushBanner.BackgroundColor3 = Theme.Red
		rushTitle.Text = `⚡ CUSTOMER RUSH!  {Format.clock(rush.EndsAt - now)}`
		local parts = {}
		for index, entry in rush.Scores do
			if index > 3 then
				break
			end
			local name = if entry.UserId == player.UserId then "You" else entry.Name
			table.insert(parts, `{place(index)} {name} {entry.Points}`)
		end
		rushLine.Text = if #parts > 0 then table.concat(parts, "   ") else "Serve customers to score!"
	elseif rush.Phase == "Countdown" then
		rushBanner.Visible = true
		rushBanner.BackgroundColor3 = Theme.Orange
		rushTitle.Text = `CUSTOMER RUSH STARTING!  {math.max(0, math.ceil(rush.EndsAt - now))}`
		rushLine.Text = "Get to your shop!"
	else
		rushBanner.Visible = false
	end
end

function Hud.Start()
	build()
	rescale()
	local camera = Workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	end

	State.Changed:Connect(refresh)
	if State.Profile then
		refresh(State.Profile)
	end
	State.Message:Connect(Hud.toast)
	State.RushChanged:Connect(refreshRush)
	player:GetAttributeChangedSignal("Combo"):Connect(refreshCombo)

	task.spawn(function()
		while true do
			task.wait(0.25)
			refreshRush()
			local open = Hud.OpenName and Hud.Panels[Hud.OpenName]
			if open and open.Tick then
				open.Tick()
			end
		end
	end)
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">State</string>
              <string name="Source"><![CDATA[-- The client's read-only copy of the player's data, plus the one way to ask the
-- server to do something (State.action). The client never changes its own data:
-- it asks, the server decides, and the new state arrives through StateUpdate.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Modules.Net)
local Signal = require(Shared.Modules.Signal)

local State = {
	Profile = nil :: any,
	Rush = { Phase = "Idle", NextAt = 0, EndsAt = 0, Scores = {}, Results = {} } :: any,

	Changed = Signal.new(), -- (profile)
	RushChanged = Signal.new(), -- (rush)
	Notified = Signal.new(), -- (kind, data) server notifications
	Message = Signal.new(), -- (text, kind) local feedback for action results
}

local actionRemote: RemoteFunction

-- Asks the server to perform an action. Returns ok, message.
-- Shows the server's message as a toast unless `quiet` is true.
function State.action(name: string, ...: any): (boolean, string?)
	local args = table.pack(...)
	local ok, success, message = pcall(function()
		return actionRemote:InvokeServer(name, table.unpack(args, 1, args.n))
	end)
	if not ok then
		State.Message:Fire("Connection problem. Try again.", "Error")
		return false, nil
	end
	if message then
		State.Message:Fire(message, if success then "Success" else "Error")
	end
	return success == true, message
end

function State.Start()
	actionRemote = Net.get("Action")

	Net.get("StateUpdate").OnClientEvent:Connect(function(profile)
		State.Profile = profile
		State.Changed:Fire(profile)
	end)
	Net.get("RushUpdate").OnClientEvent:Connect(function(rush)
		State.Rush = rush
		State.RushChanged:Fire(rush)
	end)
	Net.get("Notify").OnClientEvent:Connect(function(kind, data)
		State.Notified:Fire(kind, data or {})
	end)

	-- Ask for our data until it has loaded (the server also pushes it when ready).
	task.spawn(function()
		while not State.Profile do
			pcall(function()
				actionRemote:InvokeServer("GetState")
			end)
			if not State.Profile then
				task.wait(1)
			end
		end
		pcall(function()
			actionRemote:InvokeServer("GetRush")
		end)
	end)
end

return State
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">World</string>
              <string name="Source"><![CDATA[-- Client-side world interactions:
--   * kiosks: any ProximityPrompt with an "OpenPanel" attribute opens that UI panel
--   * shops: only the owner can use a plot's Serve prompt; your shop gets a marker
--   * tutorial: the hint line and the guide beam to your shop

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Make = require(Shared.Modules.Make)
local Theme = require(Shared.Config.Theme)
local State = require(script.Parent.State)
local Hud = require(script.Parent.Hud)

local World = {}

local player = Players.LocalPlayer
local SERVE_DISTANCE = 11
local myPlot: Model? = nil
local marker: BillboardGui? = nil
local beam: Beam? = nil
local beamStart: Attachment? = nil
local beamEnd: Attachment? = nil

local TUTORIAL_TEXT = {
	[1] = "👉 Go to YOUR SHOP on Business Street, stand behind the counter and hold the Serve button!",
	[2] = "⬆️ Nice! Now open UPGRADES and buy Faster Hands.",
	[3] = "🛒 Open the SHOP and add Strawberry Lemonade to your menu.",
}

local function updatePlot(plot: Instance)
	local servePoint = plot:FindFirstChild("ServePoint")
	local prompt = servePoint and servePoint:FindFirstChild("ServePrompt")
	local mine = plot:GetAttribute("OwnerUserId") == player.UserId
	if prompt and prompt:IsA("ProximityPrompt") then
		-- Local-only change: other players' counters simply never show a prompt.
		prompt.MaxActivationDistance = if mine then SERVE_DISTANCE else 0
	end
	if mine and myPlot ~= plot then
		myPlot = plot :: Model
		local pad = plot:FindFirstChild("Pad")
		if pad then
			if marker then
				marker:Destroy()
			end
			marker = Make("BillboardGui", {
				Name = "MyShopMarker",
				Size = UDim2.fromOffset(150, 44),
				StudsOffsetWorldSpace = Vector3.new(0, 22, 0),
				AlwaysOnTop = true,
				MaxDistance = 600,
				Parent = pad,
			})
			local label = Make("TextLabel", {
				Size = UDim2.fromScale(1, 1),
				BackgroundColor3 = Theme.Yellow,
				Text = "⭐ YOUR SHOP",
				Font = Theme.Font,
				TextSize = 20,
				TextColor3 = Theme.Dark,
				Parent = marker,
			})
			Make("UICorner", { CornerRadius = UDim.new(0, 12), Parent = label })
			Make("UIStroke", { Thickness = 2.5, Color = Theme.Dark, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = label })
		end
	elseif not mine and myPlot == plot then
		myPlot = nil
		if marker then
			marker:Destroy()
			marker = nil
		end
	end
end

local function watchPlot(plot: Instance)
	task.spawn(function()
		-- The plot's children may arrive after the plot itself.
		plot:WaitForChild("Pad", 30)
		local servePoint = plot:WaitForChild("ServePoint", 30)
		if servePoint then
			servePoint:WaitForChild("ServePrompt", 30)
		end
		updatePlot(plot)
		plot:GetAttributeChangedSignal("OwnerUserId"):Connect(function()
			updatePlot(plot)
		end)
	end)
end

local function clearBeam()
	if beam then
		beam:Destroy()
		beam = nil
	end
	if beamStart then
		beamStart:Destroy()
		beamStart = nil
	end
	if beamEnd then
		beamEnd:Destroy()
		beamEnd = nil
	end
end

local function updateGuide()
	local profile = State.Profile
	local step = if profile then profile.Tutorial else 0
	Hud.setHint(TUTORIAL_TEXT[step])

	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	local pad = myPlot and myPlot:FindFirstChild("Pad")
	local wanted = step == 1
		and rootPart ~= nil
		and pad ~= nil
		and (rootPart.CFrame.Position - pad.CFrame.Position).Magnitude > 28

	if not wanted then
		clearBeam()
		return
	end
	if beam and beamStart and beamStart.Parent == rootPart then
		return
	end
	clearBeam()
	beamStart = Make("Attachment", { Name = "GuideStart", Parent = rootPart })
	beamEnd = Make("Attachment", { Name = "GuideEnd", Position = Vector3.new(0, 3, 0), Parent = pad })
	beam = Make("Beam", {
		Name = "GuideBeam",
		Attachment0 = beamStart,
		Attachment1 = beamEnd,
		Width0 = 1.6,
		Width1 = 1.6,
		FaceCamera = true,
		Color = ColorSequence.new(Theme.Yellow),
		Transparency = NumberSequence.new(0.25),
		LightEmission = 0.6,
		Segments = 1,
		Parent = pad,
	})
end

function World.Start()
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		local panel = prompt:GetAttribute("OpenPanel")
		if typeof(panel) == "string" then
			Hud.open(panel)
		end
	end)

	task.spawn(function()
		local plots = Workspace:WaitForChild("ShopPlots")
		plots.ChildAdded:Connect(watchPlot)
		for _, plot in plots:GetChildren() do
			watchPlot(plot)
		end
	end)

	State.Changed:Connect(updateGuide)
	task.spawn(function()
		while true do
			task.wait(0.5)
			updateGuide()
		end
	end)
end

return World
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="50">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- BLOCKHEADS: HUSTLE & COLLECT - client entry point.
-- Starts the controllers, then builds the UI panels. All client code is cosmetic or
-- input: every decision that matters is made by the server.

local Controllers = script.Parent:WaitForChild("Controllers")
local UI = script.Parent:WaitForChild("UI")

local State = require(Controllers.State)
local Hud = require(Controllers.Hud)
local CustomerRenderer = require(Controllers.CustomerRenderer)
local Effects = require(Controllers.Effects)
local World = require(Controllers.World)

local InfoPanels = require(UI.InfoPanels)

State.Start()
Hud.Start()

Hud.registerPanel("Shop", require(UI.ShopPanel).create(Hud))
Hud.registerPanel("Upgrades", require(UI.UpgradesPanel).create(Hud))
Hud.registerPanel("Characters", require(UI.CharactersPanel).create(Hud))
Hud.registerPanel("Quests", InfoPanels.createQuests(Hud))
Hud.registerPanel("Daily", InfoPanels.createDaily(Hud))
Hud.registerPanel("Rush", InfoPanels.createRush(Hud))
Hud.registerPanel("Settings", InfoPanels.createSettings(Hud))

CustomerRenderer.Start()
Effects.Start()
World.Start()
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="51">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">CharactersPanel</string>
              <string name="Source"><![CDATA[-- Characters panel: "Team" (equip collected Blockheads) and "Collection" (all of
-- them, how to get each one, and the buy button for coin characters).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Theme = require(Shared.Config.Theme)
local Characters = require(Shared.Config.Characters)
local Businesses = require(Shared.Config.Businesses)
local Format = require(Shared.Modules.Format)
local Formulas = require(Shared.Modules.Formulas)
local BlockheadBuilder = require(Shared.Modules.BlockheadBuilder)
local Kit = require(script.Parent.Kit)
local State = require(script.Parent.Parent.Controllers.State)

local CharactersPanel = {}

local STAT_TEXT = {
	Served = "Serve %s customers",
	RushPoints = "Score %s total Rush points",
	RushWins = "Win %s Customer Rushes",
}

local function bonusText(character): string
	local parts = {}
	for kind, amount in character.Bonus do
		table.insert(parts, `+{Format.percent(amount)} {Characters.BonusLabels[kind] or kind}`)
	end
	table.sort(parts)
	return table.concat(parts, ", ")
end

-- Replaces a row's emoji icon with the character's face (or a mystery silhouette).
local function portrait(row, character)
	row.Icon.Text = ""
	local face = Kit.frame({
		Name = "Face",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = character.Look.Skin,
		Parent = row.Icon,
	})
	Kit.round(face, 12)
	Kit.stroke(face, 3, Characters.Rarities[character.Rarity].Color)
	BlockheadBuilder.drawFace(face, character.Look)
	local mystery = Kit.frame({
		Name = "Mystery",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Dark,
		Visible = false,
		ZIndex = 5,
		Parent = row.Icon,
	})
	Kit.round(mystery, 12)
	Kit.title({ Size = UDim2.fromScale(1, 1), Text = "?", TextSize = 34, ZIndex = 6, Parent = mystery })
	return mystery
end

function CharactersPanel.create(Hud)
	local content = Hud.newPanel("Characters", "🧱 BLOCKHEADS")
	local pages, selectTab = Hud.newTabs(content, { "Team", "Collection" })
	local updaters = {}

	-- Team -------------------------------------------------------------------------
	local teamInfo = Kit.text({
		Size = UDim2.new(1, 0, 0, 40),
		TextSize = 15,
		Font = Theme.BodyFont,
		Parent = pages.Team,
	})
	local teamScroll = Kit.scroll({ Size = UDim2.new(1, 0, 1, -44), Position = UDim2.fromOffset(0, 44), Parent = pages.Team })
	for _, character in Characters.List do
		local row = Kit.row(teamScroll, character.Order, function()
			local profile = State.Profile
			if not profile then
				return
			end
			if table.find(profile.Equipped, character.Id) then
				State.action("UnequipCharacter", character.Id)
			else
				State.action("EquipCharacter", character.Id)
			end
		end)
		portrait(row, character)
		row.Title.Text = character.Name
		row.Title.TextColor3 = Characters.Rarities[character.Rarity].Color
		row.Subtitle.Text = `{character.Rarity}  •  {bonusText(character)}`
		table.insert(updaters, function(profile)
			row.Frame.Visible = profile.Characters[character.Id] == true
			local onTeam = table.find(profile.Equipped, character.Id) ~= nil
			local full = #profile.Equipped >= Formulas.teamSlots(profile)
			if onTeam then
				row.Frame.LayoutOrder = character.Order - 100
				Kit.setButton(row.Button, "Remove", Theme.Red, true)
			else
				row.Frame.LayoutOrder = character.Order
				Kit.setButton(row.Button, if full then "Team Full" else "Add to Team", Theme.Green, not full)
			end
		end)
	end
	table.insert(updaters, function(profile)
		local parts = {}
		for kind, amount in Formulas.bonuses(profile) do
			if amount > 0 then
				table.insert(parts, `+{Format.percent(amount)} {Characters.BonusLabels[kind] or kind}`)
			end
		end
		table.sort(parts)
		local slots = Formulas.teamSlots(profile)
		teamInfo.Text = `Team {#profile.Equipped}/{slots}  (bigger shops unlock more slots)\nBonuses: {if #parts > 0 then table.concat(parts, ", ") else "none"}`
	end)

	-- Collection -------------------------------------------------------------------
	local collectionInfo = Kit.text({
		Size = UDim2.new(1, 0, 0, 24),
		TextSize = 16,
		Parent = pages.Collection,
	})
	local collectionScroll = Kit.scroll({ Size = UDim2.new(1, 0, 1, -28), Position = UDim2.fromOffset(0, 28), Parent = pages.Collection })
	for _, character in Characters.List do
		local row = Kit.row(collectionScroll, character.Order, function()
			State.action("BuyCharacter", character.Id)
		end)
		local mystery = portrait(row, character)
		row.Title.TextColor3 = Characters.Rarities[character.Rarity].Color
		table.insert(updaters, function(profile)
			local owned = profile.Characters[character.Id] == true
			local rule = character.Unlock
			mystery.Visible = not owned
			row.Title.Text = `{character.Name}  •  {character.Rarity}`
			if owned then
				row.Subtitle.Text = `{character.Personality}. {character.Description}`
				Kit.setButton(row.Button, "✔ Collected", Theme.Grey, false)
			elseif rule.Kind == "Coins" then
				row.Subtitle.Text = `{character.Personality}. {bonusText(character)}`
				Kit.setButton(row.Button, Format.coins(rule.Amount), Theme.Green, profile.Coins >= rule.Amount)
			elseif rule.Kind == "Befriend" then
				local count = profile.Befriend[character.Id] or 0
				row.Subtitle.Text = `Visits shops as a 💛 customer. Serve them {rule.Amount} times ({count}/{rule.Amount}).`
				Kit.setButton(row.Button, "💛 Befriend", Theme.Grey, false)
			elseif rule.Kind == "Stat" then
				local have = profile.Stats[rule.Stat] or 0
				local goal = string.format(STAT_TEXT[rule.Stat] or "Reach %s", Format.number(rule.Amount))
				row.Subtitle.Text = `{goal} ({Format.number(have)}/{Format.number(rule.Amount)}).`
				Kit.setButton(row.Button, "🏆 Earn", Theme.Grey, false)
			elseif rule.Kind == "Tier" then
				row.Subtitle.Text = `Joins when you open a {Businesses[rule.Amount].Name}.`
				Kit.setButton(row.Button, "🏆 Earn", Theme.Grey, false)
			else
				row.Subtitle.Text = character.Description
				Kit.setButton(row.Button, "🔒", Theme.Grey, false)
			end
		end)
	end
	table.insert(updaters, function(profile)
		local owned = 0
		for _, character in Characters.List do
			if profile.Characters[character.Id] then
				owned += 1
			end
		end
		collectionInfo.Text = `Collected {owned} / {#Characters.List} Blockheads`
	end)

	return {
		Frame = content.Parent,
		Opened = function(tab: string?)
			selectTab(tab or "Team")
		end,
		Refresh = function(profile)
			for _, update in updaters do
				update(profile)
			end
		end,
	}
end

return CharactersPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">InfoPanels</string>
              <string name="Source"><![CDATA[-- The smaller panels: daily Quests, Daily reward, Rush info and Settings.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Theme = require(Shared.Config.Theme)
local Quests = require(Shared.Config.Quests)
local RushConfig = require(Shared.Config.Rush)
local Format = require(Shared.Modules.Format)
local Formulas = require(Shared.Modules.Formulas)
local Kit = require(script.Parent.Kit)
local State = require(script.Parent.Parent.Controllers.State)

local InfoPanels = {}

local questDefs = {}
for _, def in Quests.Pool do
	questDefs[def.Id] = def
end

---------------------------------------------------------------------------------------
-- Daily quests
---------------------------------------------------------------------------------------

function InfoPanels.createQuests(Hud)
	local content = Hud.newPanel("Quests", "📜 DAILY QUESTS", Vector2.new(620, 400))
	local holder = Kit.frame({ Size = UDim2.new(1, 0, 1, -30), BackgroundTransparency = 1, Parent = content })
	Kit.list(holder, 8)
	Kit.text({
		Size = UDim2.new(1, 0, 0, 24),
		Position = UDim2.new(0, 0, 1, -24),
		Text = "Three new quests every day. Rewards grow with your shop!",
		TextSize = 14,
		Font = Theme.BodyFont,
		TextColor3 = Theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = content,
	})

	local rows = {}
	for index = 1, Quests.PerDay do
		local row = Kit.row(holder, index, function()
			State.action("ClaimQuest", index)
		end)
		row.Icon.Text = "📜"
		rows[index] = row
	end

	return {
		Frame = content.Parent,
		Refresh = function(profile)
			for index, row in rows do
				local quest = profile.Quests.List[index]
				local def = quest and questDefs[quest.Id]
				row.Frame.Visible = def ~= nil
				if quest and def then
					local reward = def.RewardServes * Formulas.serveWorth(profile)
					row.Title.Text = string.format(def.Text, quest.Goal)
					row.Subtitle.Text = `Progress {Format.number(quest.Progress)}/{Format.number(quest.Goal)}  •  Reward {Format.coins(reward)}`
					if quest.Claimed then
						row.Icon.Text = "✅"
						Kit.setButton(row.Button, "Claimed", Theme.Grey, false)
					elseif quest.Progress >= quest.Goal then
						row.Icon.Text = "🎉"
						Kit.setButton(row.Button, "Claim!", Theme.Green, true)
					else
						row.Icon.Text = "📜"
						Kit.setButton(row.Button, "In progress", Theme.Grey, false)
					end
				end
			end
		end,
	}
end

---------------------------------------------------------------------------------------
-- Daily reward
---------------------------------------------------------------------------------------

function InfoPanels.createDaily(Hud)
	local content = Hud.newPanel("Daily", "🎁 DAILY REWARD", Vector2.new(660, 330))
	local track = Kit.frame({ Size = UDim2.new(1, 0, 0, 130), BackgroundTransparency = 1, Parent = content })
	Kit.list(track, 6, true, { HorizontalAlignment = Enum.HorizontalAlignment.Center })

	local tiles = {}
	for day = 1, #Quests.DailyRewardServes do
		local tile = Kit.frame({ Size = UDim2.fromOffset(82, 124), LayoutOrder = day, Parent = track })
		Kit.round(tile, 14)
		local stroke = Kit.stroke(tile, 3, Theme.CardAlt)
		local dayLabel = Kit.text({ Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 6), Text = "Day " .. day, TextXAlignment = Enum.TextXAlignment.Center, TextSize = 16, Parent = tile })
		local icon = Kit.text({ Size = UDim2.new(1, 0, 0, 44), Position = UDim2.fromOffset(0, 32), Text = "🪙", TextSize = 34, TextXAlignment = Enum.TextXAlignment.Center, Parent = tile })
		local amount = Kit.text({ Size = UDim2.new(1, -6, 0, 30), Position = UDim2.fromOffset(3, 86), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 15, Font = Theme.Font, Parent = tile })
		tiles[day] = { Frame = tile, Stroke = stroke, Day = dayLabel, Icon = icon, Amount = amount }
	end

	local status = Kit.text({
		Size = UDim2.new(1, 0, 0, 26),
		Position = UDim2.fromOffset(0, 140),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextSize = 16,
		Parent = content,
	})
	local claim = Kit.button({
		Size = UDim2.fromOffset(240, 56),
		Position = UDim2.new(0.5, 0, 1, -4),
		AnchorPoint = Vector2.new(0.5, 1),
		Text = "Claim!",
		TextSize = 26,
		OnClick = function()
			State.action("ClaimDaily")
		end,
		Parent = content,
	})

	return {
		Frame = content.Parent,
		Refresh = function(profile)
			local today = Formulas.dayNumber(os.time())
			local daily = profile.Daily
			local canClaim = daily.LastDay < today
			local streak = daily.Streak
			if canClaim then
				streak = if daily.LastDay == today - 1 then daily.Streak + 1 else 1
			end
			local count = #tiles
			local current = (math.max(streak, 1) - 1) % count + 1
			local worth = Formulas.serveWorth(profile)
			for day, tile in tiles do
				local coins = math.max(Quests.DailyMinimumCoins, Quests.DailyRewardServes[day] * worth)
				tile.Amount.Text = Format.number(coins)
				local claimed = day < current or (day == current and not canClaim)
				tile.Icon.Text = if claimed then "✅" elseif day == count then "💰" else "🪙"
				tile.Frame.BackgroundColor3 = if day == current and canClaim then Theme.Yellow elseif claimed then Theme.CardAlt else Theme.Card
				tile.Stroke.Color = if day == current then Theme.Dark else Theme.CardAlt
			end
			status.Text = if canClaim
				then `Day {streak} streak reward is ready!`
				else `Streak: {daily.Streak} day(s). Come back tomorrow to keep it going!`
			Kit.setButton(claim, if canClaim then "Claim!" else "Claimed today", Theme.Green, canClaim)
		end,
	}
end

---------------------------------------------------------------------------------------
-- Rush info
---------------------------------------------------------------------------------------

function InfoPanels.createRush(Hud)
	local content = Hud.newPanel("Rush", "⚡ CUSTOMER RUSH", Vector2.new(620, 430))
	local status = Kit.title({
		Size = UDim2.new(1, 0, 0, 36),
		TextColor3 = Theme.Red,
		TextSize = 28,
		Parent = content,
	})
	Kit.text({
		Size = UDim2.new(1, 0, 0, 86),
		Position = UDim2.fromOffset(0, 40),
		Font = Theme.BodyFont,
		TextSize = 15,
		TextYAlignment = Enum.TextYAlignment.Top,
		Text = `Every few minutes a crowd of customers hits Business Street for {RushConfig.Duration} seconds. `
			.. "Every shop gets the same customers, so it is all about how fast you serve. "
			.. "Only customers YOU serve score points - VIPs and fast service score more. "
			.. "Top 3 win big coin prizes, and 1st place earns the exclusive Rush Champion Gold awning!",
		Parent = content,
	})
	local boardTitle = Kit.text({ Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 130), Font = Theme.Font, TextSize = 20, Parent = content })
	local board = Kit.text({
		Size = UDim2.new(1, 0, 1, -160),
		Position = UDim2.fromOffset(0, 158),
		TextSize = 18,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = content,
	})

	local function update()
		local rush = State.Rush
		local now = Workspace:GetServerTimeNow()
		local localId = Players.LocalPlayer.UserId
		local lines = {}
		if rush.Phase == "Active" then
			status.Text = `RUSH IS LIVE!  {Format.clock(rush.EndsAt - now)}`
			boardTitle.Text = "Live scores"
			for index, entry in rush.Scores do
				table.insert(lines, `{index}. {if entry.UserId == localId then "You" else entry.Name}  -  {entry.Points} pts`)
			end
		else
			status.Text = if rush.Phase == "Countdown"
				then "STARTING NOW - get to your shop!"
				else `Next rush in {Format.clock(rush.NextAt - now)}`
			boardTitle.Text = "Last rush"
			for _, entry in rush.Results do
				table.insert(lines, `{entry.Rank}. {if entry.UserId == localId then "You" else entry.Name}  -  {entry.Points} pts  (+{Format.coins(entry.Coins)})`)
			end
		end
		board.Text = if #lines > 0 then table.concat(lines, "\n") else "No scores yet."
	end

	return { Frame = content.Parent, Refresh = update, Tick = update }
end

---------------------------------------------------------------------------------------
-- Settings + stats
---------------------------------------------------------------------------------------

function InfoPanels.createSettings(Hud)
	local content = Hud.newPanel("Settings", "⚙️ SETTINGS", Vector2.new(520, 400))
	Kit.text({ Size = UDim2.new(1, -170, 0, 52), Text = "Sound effects", Font = Theme.Font, TextSize = 22, Parent = content })
	local sfx = Kit.button({
		Size = UDim2.fromOffset(150, 48),
		Position = UDim2.new(1, 0, 0, 2),
		AnchorPoint = Vector2.new(1, 0),
		OnClick = function()
			local profile = State.Profile
			if profile then
				State.action("SetSetting", "Sfx", not (profile.Settings.Sfx ~= false))
			end
		end,
		Parent = content,
	})
	Kit.text({ Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 70), Text = "Your stats", Font = Theme.Font, TextSize = 22, Parent = content })
	local stats = Kit.text({
		Size = UDim2.new(1, 0, 1, -130),
		Position = UDim2.fromOffset(0, 100),
		Font = Theme.BodyFont,
		TextSize = 17,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = content,
	})
	Kit.text({
		Size = UDim2.new(1, 0, 0, 20),
		Position = UDim2.new(0, 0, 1, -20),
		Text = "Blockheads: Hustle & Collect",
		Font = Theme.BodyFont,
		TextSize = 13,
		TextColor3 = Theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = content,
	})

	return {
		Frame = content.Parent,
		Refresh = function(profile)
			local on = profile.Settings.Sfx ~= false
			Kit.setButton(sfx, if on then "ON" else "OFF", if on then Theme.Green else Theme.Red, true)
			local s = profile.Stats
			stats.Text = table.concat({
				`Total earned: {Format.coins(profile.TotalEarned)}`,
				`Customers served: {Format.number(s.Served)}`,
				`Customers lost: {Format.number(s.Lost)}`,
				`Best combo: x{s.BestCombo}`,
				`Rush points: {Format.number(s.RushPoints)}`,
				`Rush wins: {s.RushWins}`,
			}, "\n")
		end,
	}
end

return InfoPanels
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">Kit</string>
              <string name="Source"><![CDATA[-- UI building blocks shared by the HUD and every panel, so the whole interface has
-- one consistent look: rounded cards, chunky outlined buttons, friendly type.
-- All sizes are in "design pixels"; the HUD scales the whole interface to the screen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Make = require(Shared.Modules.Make)
local Theme = require(Shared.Config.Theme)

local Kit = {}

Kit.make = Make
Kit.SfxEnabled = true

local sounds: { [string]: Sound } = {}

function Kit.playSound(name: string, speed: number?)
	if not Kit.SfxEnabled then
		return
	end
	local sound = sounds[name]
	if not sound then
		local id = Theme.Sounds[name]
		if not id then
			return
		end
		sound = Make("Sound", { Name = "Sfx" .. name, SoundId = id, Volume = 0.5, Parent = SoundService })
		sounds[name] = sound
	end
	sound.PlaybackSpeed = speed or 1
	sound:Play()
end

function Kit.tween(instance: Instance, seconds: number, goal: { [string]: any }, style: Enum.EasingStyle?, direction: Enum.EasingDirection?)
	local tween = TweenService:Create(
		instance,
		TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out),
		goal
	)
	tween:Play()
	return tween
end

function Kit.round(instance: Instance, pixels: number)
	return Make("UICorner", { CornerRadius = UDim.new(0, pixels), Parent = instance })
end

function Kit.stroke(instance: Instance, thickness: number, color: Color3?)
	return Make("UIStroke", {
		Thickness = thickness,
		Color = color or Theme.Dark,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = instance,
	})
end

function Kit.pad(instance: Instance, pixels: number)
	local inset = UDim.new(0, pixels)
	return Make("UIPadding", {
		PaddingLeft = inset,
		PaddingRight = inset,
		PaddingTop = inset,
		PaddingBottom = inset,
		Parent = instance,
	})
end

function Kit.list(parent: Instance, spacing: number, horizontal: boolean?, props: { [string]: any }?)
	local merged = {
		Padding = UDim.new(0, spacing),
		FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = parent,
	}
	if props then
		for key, value in props do
			merged[key] = value
		end
	end
	return Make("UIListLayout", merged)
end

function Kit.frame(props: { [string]: any }): Frame
	local merged = { BackgroundColor3 = Theme.Card, BorderSizePixel = 0 }
	for key, value in props do
		merged[key] = value
	end
	return Make("Frame", merged)
end

function Kit.text(props: { [string]: any }): TextLabel
	local merged = {
		BackgroundTransparency = 1,
		Font = Theme.BoldFont,
		TextColor3 = Theme.Text,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		Text = "",
	}
	for key, value in props do
		merged[key] = value
	end
	return Make("TextLabel", merged)
end

-- Heading-style text: display font, white with a dark outline.
function Kit.title(props: { [string]: any }): TextLabel
	local merged = {
		Font = Theme.Font,
		TextColor3 = Theme.White,
		TextSize = 26,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
	}
	for key, value in props do
		merged[key] = value
	end
	local label = Kit.text(merged)
	Make("UIStroke", { Thickness = 2.5, Color = Theme.Dark, Parent = label })
	return label
end

-- A chunky button. props.OnClick is called on activation (mouse, touch or gamepad).
function Kit.button(props: { [string]: any }): TextButton
	local onClick = props.OnClick
	local color = props.Color or Theme.Green
	local merged = {
		AutoButtonColor = false,
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Font = Theme.Font,
		TextColor3 = Theme.White,
		TextSize = 20,
		TextStrokeColor3 = Theme.Dark,
		TextStrokeTransparency = 0.35,
		Text = "",
	}
	for key, value in props do
		if key ~= "OnClick" and key ~= "Color" and key ~= "Radius" then
			merged[key] = value
		end
	end
	local button = Make("TextButton", merged)
	Kit.round(button, props.Radius or 12)
	Kit.stroke(button, 2.5)
	local scale = Make("UIScale", { Parent = button })

	button.MouseButton1Down:Connect(function()
		Kit.tween(scale, 0.08, { Scale = 0.93 })
	end)
	local function release()
		Kit.tween(scale, 0.12, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	button.MouseButton1Up:Connect(release)
	button.MouseLeave:Connect(release)
	button.Activated:Connect(function()
		if not button.Active then
			return
		end
		Kit.playSound("Click")
		if onClick then
			onClick(button)
		end
	end)
	return button
end

-- Greys a button out (or restores it) and changes its label.
function Kit.setButton(button: TextButton, text: string, color: Color3, enabled: boolean)
	button.Text = text
	button.BackgroundColor3 = if enabled then color else Theme.Grey
	button.Active = enabled
end

-- A scrolling column that grows with its contents.
function Kit.scroll(props: { [string]: any }): ScrollingFrame
	local merged = {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = Theme.Dark,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		ScrollingDirection = Enum.ScrollingDirection.Y,
	}
	for key, value in props do
		merged[key] = value
	end
	local scroll = Make("ScrollingFrame", merged)
	local spacing = 8
	local layout = Kit.list(scroll, spacing)

	-- The canvas height is added up from the rows' own design-pixel heights instead of
	-- using AutomaticCanvasSize, which miscalculates when an ancestor has a UIScale
	-- (the whole HUD does), leaving the last rows unreachable on phones.
	local function resize()
		local height = 12
		for _, child in scroll:GetChildren() do
			if child:IsA("GuiObject") and child.Visible then
				height += child.Size.Y.Offset + spacing
			end
		end
		scroll.CanvasSize = UDim2.fromOffset(0, height)
	end
	layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(resize)
	scroll:GetPropertyChangedSignal("AbsoluteSize"):Connect(resize)
	task.defer(resize)
	Make("UIPadding", { PaddingRight = UDim.new(0, 12), PaddingBottom = UDim.new(0, 8), PaddingTop = UDim.new(0, 2), PaddingLeft = UDim.new(0, 2), Parent = scroll })
	return scroll
end

-- A list row: emoji icon, title, subtitle and an action button on the right.
-- Returns { Frame, Icon, Title, Subtitle, Button }.
function Kit.row(parent: Instance, order: number, onClick: (() -> ())?)
	local frame = Kit.frame({
		Size = UDim2.new(1, 0, 0, 76),
		LayoutOrder = order,
		Parent = parent,
	})
	Kit.round(frame, 14)
	Kit.stroke(frame, 2, Theme.CardAlt)
	local icon = Kit.text({
		Size = UDim2.fromOffset(56, 56),
		Position = UDim2.fromOffset(10, 10),
		TextSize = 38,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = frame,
	})
	local title = Kit.text({
		Size = UDim2.new(1, -230, 0, 26),
		Position = UDim2.fromOffset(76, 10),
		Font = Theme.Font,
		TextSize = 21,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = frame,
	})
	local subtitle = Kit.text({
		Size = UDim2.new(1, -230, 0, 34),
		Position = UDim2.fromOffset(76, 36),
		Font = Theme.BodyFont,
		TextSize = 14,
		TextColor3 = Theme.SubText,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = frame,
	})
	local button = Kit.button({
		Size = UDim2.fromOffset(136, 52),
		Position = UDim2.new(1, -10, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		TextSize = 18,
		OnClick = onClick,
		Parent = frame,
	})
	return { Frame = frame, Icon = icon, Title = title, Subtitle = subtitle, Button = button }
end

return Kit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">ShopPanel</string>
              <string name="Source"><![CDATA[-- Shop panel: Products (menu items + levels), Business (new shop tiers), Style (awnings).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Theme = require(Shared.Config.Theme)
local Products = require(Shared.Config.Products)
local Businesses = require(Shared.Config.Businesses)
local Cosmetics = require(Shared.Config.Cosmetics)
local Format = require(Shared.Modules.Format)
local Formulas = require(Shared.Modules.Formulas)
local Kit = require(script.Parent.Kit)
local State = require(script.Parent.Parent.Controllers.State)

local ShopPanel = {}

function ShopPanel.create(Hud)
	local content = Hud.newPanel("Shop", "🛒 SHOP")
	local pages, selectTab = Hud.newTabs(content, { "Products", "Business", "Style" })
	local updaters = {}

	-- Products ---------------------------------------------------------------------
	local productScroll = Kit.scroll({ Size = UDim2.fromScale(1, 1), Parent = pages.Products })
	for _, product in Products.List do
		local row
		row = Kit.row(productScroll, product.Order, function()
			local profile = State.Profile
			if not profile then
				return
			end
			if profile.Products[product.Id] then
				State.action("UpgradeProduct", product.Id)
			else
				State.action("BuyProduct", product.Id)
			end
		end)
		row.Icon.Text = product.Emoji
		table.insert(updaters, function(profile)
			local level = profile.Products[product.Id]
			row.Frame.Visible = product.Tier <= profile.BusinessTier + 1
			if product.Tier > profile.BusinessTier then
				row.Title.Text = product.Name
				row.Subtitle.Text = `Requires a {Businesses[product.Tier].Name}`
				Kit.setButton(row.Button, "🔒 Locked", Theme.Grey, false)
			elseif not level then
				row.Title.Text = product.Name
				row.Subtitle.Text = `Sells for {Format.coins(Formulas.productPrice(profile, product.Id))}. Add it to your menu!`
				Kit.setButton(row.Button, `Add {Format.coins(product.UnlockCost)}`, Theme.Green, profile.Coins >= product.UnlockCost)
			else
				local price = Formulas.productPrice(profile, product.Id)
				local seconds = Formulas.productTime(profile, product.Id)
				row.Title.Text = `{product.Name}  Lv {level}`
				row.Subtitle.Text = string.format("Sells for %s  •  %.1fs to make", Format.coins(price), seconds)
				local cost = Formulas.productUpgradeCost(product.Id, level)
				if cost then
					Kit.setButton(row.Button, `Level Up\n{Format.coins(cost)}`, Theme.Blue, profile.Coins >= cost)
				else
					Kit.setButton(row.Button, "MAX", Theme.Grey, false)
				end
			end
		end)
	end

	-- Business ---------------------------------------------------------------------
	local businessScroll = Kit.scroll({ Size = UDim2.fromScale(1, 1), Parent = pages.Business })
	for tier, business in Businesses do
		local row = Kit.row(businessScroll, tier, function()
			State.action("UnlockBusiness")
		end)
		row.Icon.Text = business.Emoji
		row.Title.Text = business.Name
		table.insert(updaters, function(profile)
			if tier <= profile.BusinessTier then
				row.Subtitle.Text = business.Description
				Kit.setButton(row.Button, "✔ Owned", Theme.Grey, false)
			elseif tier == profile.BusinessTier + 1 then
				row.Subtitle.Text = business.Description .. " Unlocks new products."
				Kit.setButton(row.Button, `Open\n{Format.coins(business.UnlockCost)}`, Theme.Green, profile.Coins >= business.UnlockCost)
			else
				row.Subtitle.Text = `Open a {Businesses[tier - 1].Name} first.`
				Kit.setButton(row.Button, "🔒 Locked", Theme.Grey, false)
			end
		end)
	end

	-- Style ------------------------------------------------------------------------
	local styleScroll = Kit.scroll({ Size = UDim2.fromScale(1, 1), Parent = pages.Style })
	for index, cosmetic in Cosmetics.List do
		local row
		row = Kit.row(styleScroll, index, function()
			local profile = State.Profile
			if not profile then
				return
			end
			if profile.Cosmetics[cosmetic.Id] then
				State.action("EquipCosmetic", cosmetic.Id)
			else
				State.action("BuyCosmetic", cosmetic.Id)
			end
		end)
		row.Icon.Text = ""
		row.Icon.BackgroundTransparency = 0
		row.Icon.BackgroundColor3 = cosmetic.Color
		Kit.round(row.Icon, 12)
		Kit.stroke(row.Icon, 3, cosmetic.Stripe)
		row.Title.Text = cosmetic.Name
		table.insert(updaters, function(profile)
			local unlock = cosmetic.Unlock
			if profile.EquippedCosmetic == cosmetic.Id then
				row.Subtitle.Text = "Your shop is wearing this awning."
				Kit.setButton(row.Button, "✔ Equipped", Theme.Grey, false)
			elseif profile.Cosmetics[cosmetic.Id] then
				row.Subtitle.Text = "Owned. Tap to use it on your shop."
				Kit.setButton(row.Button, "Equip", Theme.Blue, true)
			elseif unlock.Kind == "Coins" then
				row.Subtitle.Text = "Awning style for your shop."
				Kit.setButton(row.Button, Format.coins(unlock.Amount), Theme.Green, profile.Coins >= unlock.Amount)
			elseif unlock.Kind == "RushWin" then
				row.Subtitle.Text = "Exclusive! Win 1st place in a Customer Rush."
				Kit.setButton(row.Button, "🏆 Earn it", Theme.Grey, false)
			else
				local have = profile.Stats[unlock.Stat] or 0
				row.Subtitle.Text = `Exclusive! Score {Format.number(unlock.Amount)} total Rush points ({Format.number(have)}).`
				Kit.setButton(row.Button, "🏆 Earn it", Theme.Grey, false)
			end
		end)
	end

	return {
		Frame = content.Parent,
		Opened = function(tab: string?)
			selectTab(tab or "Products")
		end,
		Refresh = function(profile)
			for _, update in updaters do
				update(profile)
			end
		end,
	}
end

return ShopPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">UpgradesPanel</string>
              <string name="Source"><![CDATA[-- Business upgrades panel.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Theme = require(Shared.Config.Theme)
local Upgrades = require(Shared.Config.Upgrades)
local Format = require(Shared.Modules.Format)
local Formulas = require(Shared.Modules.Formulas)
local Kit = require(script.Parent.Kit)
local State = require(script.Parent.Parent.Controllers.State)

local UpgradesPanel = {}

function UpgradesPanel.create(Hud)
	local content = Hud.newPanel("Upgrades", "⬆️ UPGRADES")
	local scroll = Kit.scroll({ Size = UDim2.fromScale(1, 1), Parent = content })
	local updaters = {}

	for index, upgrade in Upgrades.List do
		local row = Kit.row(scroll, index, function()
			State.action("BuyUpgrade", upgrade.Id)
		end)
		row.Icon.Text = upgrade.Emoji
		row.Subtitle.Text = upgrade.Description
		table.insert(updaters, function(profile)
			local level = profile.Upgrades[upgrade.Id] or 0
			row.Title.Text = `{upgrade.Name}  {level}/{upgrade.MaxLevel}`
			local cost = Formulas.upgradeCost(upgrade.Id, level)
			if cost then
				Kit.setButton(row.Button, Format.coins(cost), Theme.Green, profile.Coins >= cost)
			else
				Kit.setButton(row.Button, "MAX", Theme.Grey, false)
			end
		end)
	end

	return {
		Frame = content.Parent,
		Refresh = function(profile)
			for _, update in updaters do
				update(profile)
			end
		end,
	}
end

return UpgradesPanel
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
