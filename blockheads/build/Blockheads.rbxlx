        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">Businesses</string>
            <string name="Source"><![CDATA[-- Business tiers, in unlock order. A player's BusinessTier is an index into this list.
-- To add a new business later: append an entry here and add its products in Products.luau.

export type Business = {
	Id: string,
	Name: string,
	Emoji: string,
	UnlockCost: number,
	Wall: Color3,
	Accent: Color3,
	Description: string,
}

local Businesses: { Business } = {
	{
		Id = "Lemonade",
		Name = "Lemonade Stand",
		Emoji = "🍋",
		UnlockCost = 0,
		Wall = Color3.fromRGB(255, 244, 204),
		Accent = Color3.fromRGB(255, 205, 56),
		Description = "Where every empire starts.",
	},
	{
		Id = "Burger",
		Name = "Burger Shop",
		Emoji = "🍔",
		UnlockCost = 7500,
		Wall = Color3.fromRGB(255, 226, 196),
		Accent = Color3.fromRGB(226, 88, 62),
		Description = "Sizzling burgers. Bigger orders, bigger coins.",
	},
	{
		Id = "Pizza",
		Name = "Pizza Shop",
		Emoji = "🍕",
		UnlockCost = 60000,
		Wall = Color3.fromRGB(255, 240, 220),
		Accent = Color3.fromRGB(64, 160, 92),
		Description = "Hot slices for hungry Blockheads.",
	},
	{
		Id = "IceCream",
		Name = "Ice Cream Shop",
		Emoji = "🍦",
		UnlockCost = 500000,
		Wall = Color3.fromRGB(232, 246, 255),
		Accent = Color3.fromRGB(255, 130, 190),
		Description = "The coolest shop on Business Street.",
	},
	{
		Id = "Restaurant",
		Name = "Restaurant",
		Emoji = "🍽️",
		UnlockCost = 4000000,
		Wall = Color3.fromRGB(245, 236, 255),
		Accent = Color3.fromRGB(122, 84, 214),
		Description = "Fine dining. The top of the food chain.",
	},
}

return Businesses
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">Characters</string>
            <string name="Source"><![CDATA[-- The collectible Blockheads cast.
--
-- !! PLACEHOLDER CAST !!
-- These ten characters are temporary stand-ins so the collection system works today.
-- To swap in your real Blockheads cast:
--   1. Change Name / Description / Personality / Look below to match your reference sheets.
--   2. (Optional) Put a finished Model in ReplicatedStorage > Assets > Characters whose
--      name equals the character Id. BlockheadBuilder uses that model instead of the
--      blocky placeholder automatically. The model needs a PrimaryPart.
-- Keep the Id values stable once players have saved data - Ids are what gets saved.
--
-- Bonus kinds (all small, none purchasable with Robux):
--   Sales     +% sale price            Speed  -% production time
--   Patience  +% customer patience     Staff  +% staff speed
--   Xp        +% XP                    Rush   +% Customer Rush points
--
-- Unlock kinds:
--   Starter   owned from the start
--   Coins     bought in the Collection for Amount coins
--   Befriend  appears as a visiting customer; serve them Amount times
--   Stat      unlocked when Stats[Stat] reaches Amount
--   Tier      unlocked when the player owns business tier Amount

export type Look = {
	Skin: Color3,
	Shirt: Color3,
	Pants: Color3,
	Eyes: string, -- "Dot" | "Wide" | "Sleepy" | "Star"
	Mouth: string, -- "Smile" | "Grin" | "Flat" | "Open"
	Hat: string?, -- "Cap" | "ChefHat" | "TopHat" | "Crown" | "Beanie" | "Headphones" | "Bow"
	HatColor: Color3?,
	Scale: number?,
}

export type Character = {
	Id: string,
	Name: string,
	Rarity: string,
	Personality: string,
	Description: string,
	Bonus: { [string]: number },
	Unlock: { Kind: string, Amount: number?, Stat: string? },
	Look: Look,
	Order: number,
}

local Rarities = {
	Common = { Order = 1, Color = Color3.fromRGB(170, 178, 189) },
	Uncommon = { Order = 2, Color = Color3.fromRGB(88, 196, 108) },
	Rare = { Order = 3, Color = Color3.fromRGB(70, 150, 255) },
	Epic = { Order = 4, Color = Color3.fromRGB(170, 96, 255) },
	Legendary = { Order = 5, Color = Color3.fromRGB(255, 184, 48) },
}

local list: { Character } = {
	{
		Id = "Brix",
		Name = "Brix",
		Rarity = "Common",
		Personality = "Cheerful and dependable",
		Description = "Your first friend in Blockheads Town. Never misses a shift.",
		Bonus = { Sales = 0.03 },
		Unlock = { Kind = "Starter" },
		Look = {
			Skin = Color3.fromRGB(255, 214, 102),
			Shirt = Color3.fromRGB(64, 156, 255),
			Pants = Color3.fromRGB(52, 73, 110),
			Eyes = "Dot",
			Mouth = "Smile",
			Hat = "Cap",
			HatColor = Color3.fromRGB(64, 156, 255),
		},
		Order = 1,
	},
	{
		Id = "Lemmy",
		Name = "Lemmy",
		Rarity = "Common",
		Personality = "Zesty and always in a hurry",
		Description = "Squeezes lemons faster than anyone on Business Street.",
		Bonus = { Speed = 0.03 },
		Unlock = { Kind = "Coins", Amount = 750 },
		Look = {
			Skin = Color3.fromRGB(255, 236, 110),
			Shirt = Color3.fromRGB(120, 200, 80),
			Pants = Color3.fromRGB(70, 110, 60),
			Eyes = "Wide",
			Mouth = "Grin",
			Hat = "Beanie",
			HatColor = Color3.fromRGB(120, 200, 80),
		},
		Order = 2,
	},
	{
		Id = "Dotty",
		Name = "Dotty",
		Rarity = "Common",
		Personality = "Chatty and kind",
		Description = "Keeps the queue smiling with terrible jokes.",
		Bonus = { Patience = 0.06 },
		Unlock = { Kind = "Befriend", Amount = 3 },
		Look = {
			Skin = Color3.fromRGB(255, 196, 170),
			Shirt = Color3.fromRGB(255, 120, 160),
			Pants = Color3.fromRGB(120, 70, 110),
			Eyes = "Dot",
			Mouth = "Open",
			Hat = "Bow",
			HatColor = Color3.fromRGB(255, 90, 140),
		},
		Order = 3,
	},
	{
		Id = "Chip",
		Name = "Chip",
		Rarity = "Uncommon",
		Personality = "Quiet workaholic",
		Description = "Runs the counter while you take a break.",
		Bonus = { Staff = 0.08 },
		Unlock = { Kind = "Coins", Amount = 6000 },
		Look = {
			Skin = Color3.fromRGB(196, 150, 110),
			Shirt = Color3.fromRGB(245, 245, 245),
			Pants = Color3.fromRGB(60, 60, 70),
			Eyes = "Sleepy",
			Mouth = "Flat",
			Hat = "ChefHat",
			HatColor = Color3.fromRGB(255, 255, 255),
		},
		Order = 4,
	},
	{
		Id = "Maple",
		Name = "Maple",
		Rarity = "Uncommon",
		Personality = "Sweet-talking saleswoman",
		Description = "Could sell lemonade to a lemon.",
		Bonus = { Sales = 0.05 },
		Unlock = { Kind = "Stat", Stat = "Served", Amount = 250 },
		Look = {
			Skin = Color3.fromRGB(236, 170, 120),
			Shirt = Color3.fromRGB(214, 90, 50),
			Pants = Color3.fromRGB(110, 60, 40),
			Eyes = "Wide",
			Mouth = "Smile",
			Hat = "Beanie",
			HatColor = Color3.fromRGB(190, 60, 40),
		},
		Order = 5,
	},
	{
		Id = "Zoom",
		Name = "Zoom",
		Rarity = "Rare",
		Personality = "Hyperactive speedster",
		Description = "Has never once walked anywhere.",
		Bonus = { Speed = 0.07 },
		Unlock = { Kind = "Befriend", Amount = 5 },
		Look = {
			Skin = Color3.fromRGB(150, 220, 255),
			Shirt = Color3.fromRGB(255, 80, 80),
			Pants = Color3.fromRGB(40, 40, 60),
			Eyes = "Star",
			Mouth = "Grin",
			Hat = "Cap",
			HatColor = Color3.fromRGB(255, 80, 80),
		},
		Order = 6,
	},
	{
		Id = "ProfessorCube",
		Name = "Professor Cube",
		Rarity = "Rare",
		Personality = "Absent-minded genius",
		Description = "Studied business for forty years. Still forgets his wallet.",
		Bonus = { Xp = 0.15 },
		Unlock = { Kind = "Coins", Amount = 75000 },
		Look = {
			Skin = Color3.fromRGB(220, 220, 235),
			Shirt = Color3.fromRGB(110, 90, 160),
			Pants = Color3.fromRGB(60, 50, 80),
			Eyes = "Sleepy",
			Mouth = "Flat",
			Hat = "TopHat",
			HatColor = Color3.fromRGB(60, 50, 80),
		},
		Order = 7,
	},
	{
		Id = "DJVoxel",
		Name = "DJ Voxel",
		Rarity = "Epic",
		Personality = "Party starter",
		Description = "Turns every Customer Rush into a festival.",
		Bonus = { Rush = 0.10 },
		Unlock = { Kind = "Stat", Stat = "RushPoints", Amount = 3000 },
		Look = {
			Skin = Color3.fromRGB(180, 130, 255),
			Shirt = Color3.fromRGB(30, 30, 40),
			Pants = Color3.fromRGB(50, 220, 200),
			Eyes = "Star",
			Mouth = "Grin",
			Hat = "Headphones",
			HatColor = Color3.fromRGB(50, 220, 200),
		},
		Order = 8,
	},
	{
		Id = "QueenQuartz",
		Name = "Queen Quartz",
		Rarity = "Epic",
		Personality = "Royally dramatic",
		Description = "Only visits the fanciest shops. Tips accordingly.",
		Bonus = { Sales = 0.07, Patience = 0.05 },
		Unlock = { Kind = "Befriend", Amount = 8 },
		Look = {
			Skin = Color3.fromRGB(255, 200, 230),
			Shirt = Color3.fromRGB(150, 70, 200),
			Pants = Color3.fromRGB(90, 40, 130),
			Eyes = "Wide",
			Mouth = "Smile",
			Hat = "Crown",
			HatColor = Color3.fromRGB(255, 205, 60),
		},
		Order = 9,
	},
	{
		Id = "Goldie",
		Name = "Goldie",
		Rarity = "Legendary",
		Personality = "Living legend",
		Description = "The original Blockhead tycoon. Only joins the very best.",
		Bonus = { Sales = 0.08, Speed = 0.08 },
		Unlock = { Kind = "Tier", Amount = 5 },
		Look = {
			Skin = Color3.fromRGB(255, 200, 50),
			Shirt = Color3.fromRGB(255, 240, 180),
			Pants = Color3.fromRGB(200, 140, 30),
			Eyes = "Star",
			Mouth = "Grin",
			Hat = "Crown",
			HatColor = Color3.fromRGB(255, 255, 255),
			Scale = 1.1,
		},
		Order = 10,
	},
}

local byId: { [string]: Character } = {}
for _, character in list do
	byId[character.Id] = character
end

local BonusLabels = {
	Sales = "Sale Price",
	Speed = "Production Speed",
	Patience = "Customer Patience",
	Staff = "Staff Speed",
	Xp = "XP",
	Rush = "Rush Points",
}

return {
	List = list,
	ById = byId,
	Rarities = Rarities,
	BonusLabels = BonusLabels,
	MaxTeamSize = 3,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">Cosmetics</string>
            <string name="Source"><![CDATA[-- Shop awning styles. Purely visual.
--   Unlock.Kind = "Default" | "Coins" | "RushWin" | "Stat"

export type Cosmetic = {
	Id: string,
	Name: string,
	Color: Color3,
	Stripe: Color3,
	Neon: boolean?,
	Unlock: { Kind: string, Amount: number?, Stat: string? },
}

local list: { Cosmetic } = {
	{ Id = "Sunny", Name = "Sunny Yellow", Color = Color3.fromRGB(255, 205, 56), Stripe = Color3.fromRGB(255, 255, 255), Unlock = { Kind = "Default" } },
	{ Id = "Berry", Name = "Berry Red", Color = Color3.fromRGB(232, 72, 85), Stripe = Color3.fromRGB(255, 255, 255), Unlock = { Kind = "Coins", Amount = 500 } },
	{ Id = "Ocean", Name = "Ocean Blue", Color = Color3.fromRGB(58, 134, 255), Stripe = Color3.fromRGB(255, 255, 255), Unlock = { Kind = "Coins", Amount = 500 } },
	{ Id = "Mint", Name = "Fresh Mint", Color = Color3.fromRGB(80, 210, 160), Stripe = Color3.fromRGB(240, 255, 250), Unlock = { Kind = "Coins", Amount = 2500 } },
	{ Id = "Grape", Name = "Grape Soda", Color = Color3.fromRGB(150, 90, 230), Stripe = Color3.fromRGB(240, 225, 255), Unlock = { Kind = "Coins", Amount = 12000 } },
	{ Id = "Midnight", Name = "Midnight", Color = Color3.fromRGB(36, 40, 66), Stripe = Color3.fromRGB(255, 205, 56), Unlock = { Kind = "Coins", Amount = 60000 } },
	{ Id = "Neon", Name = "Neon Rush", Color = Color3.fromRGB(60, 255, 200), Stripe = Color3.fromRGB(255, 70, 200), Neon = true, Unlock = { Kind = "Stat", Stat = "RushPoints", Amount = 5000 } },
	{ Id = "Gold", Name = "Rush Champion Gold", Color = Color3.fromRGB(255, 200, 40), Stripe = Color3.fromRGB(255, 240, 170), Neon = true, Unlock = { Kind = "RushWin" } },
}

local byId: { [string]: Cosmetic } = {}
for _, cosmetic in list do
	byId[cosmetic.Id] = cosmetic
end

return {
	List = list,
	ById = byId,
	Default = "Sunny",
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">Customers</string>
            <string name="Source"><![CDATA[-- Customer personalities.
--   Weight     = relative spawn chance
--   Patience   = seconds they wait at the front of the queue experience (whole wait)
--   PayMult    = multiplier on the order price
--   Items      = how many products they order
--   Xp         = player XP for serving them
--   RushPoints = Customer Rush points for serving them
--   Special    = boosted by the Curb Appeal upgrade

export type CustomerType = {
	Id: string,
	Name: string,
	Emoji: string,
	Weight: number,
	Patience: number,
	PayMult: number,
	Items: number,
	Xp: number,
	RushPoints: number,
	Special: boolean,
	Shirt: Color3?,
	Hat: string?,
}

local list: { CustomerType } = {
	{
		Id = "Normal",
		Name = "Customer",
		Emoji = "🙂",
		Weight = 60,
		Patience = 24,
		PayMult = 1,
		Items = 1,
		Xp = 3,
		RushPoints = 10,
		Special = false,
	},
	{
		Id = "Impatient",
		Name = "Impatient Customer",
		Emoji = "⏰",
		Weight = 14,
		Patience = 11,
		PayMult = 1.4,
		Items = 1,
		Xp = 4,
		RushPoints = 15,
		Special = false,
		Shirt = Color3.fromRGB(230, 80, 70),
	},
	{
		Id = "Hungry",
		Name = "Hungry Customer",
		Emoji = "😋",
		Weight = 12,
		Patience = 26,
		PayMult = 1.1,
		Items = 2,
		Xp = 6,
		RushPoints = 20,
		Special = false,
		Shirt = Color3.fromRGB(255, 150, 60),
	},
	{
		Id = "Rich",
		Name = "Rich Customer",
		Emoji = "🤑",
		Weight = 8,
		Patience = 20,
		PayMult = 2.5,
		Items = 1,
		Xp = 8,
		RushPoints = 25,
		Special = true,
		Shirt = Color3.fromRGB(40, 140, 90),
		Hat = "TopHat",
	},
	{
		Id = "VIP",
		Name = "VIP Customer",
		Emoji = "🌟",
		Weight = 3,
		Patience = 15,
		PayMult = 5,
		Items = 1,
		Xp = 15,
		RushPoints = 50,
		Special = true,
		Shirt = Color3.fromRGB(255, 210, 60),
		Hat = "Crown",
	},
	{
		-- A Blockheads character visiting your shop. Serving them builds friendship
		-- (see Characters.luau, Unlock.Kind = "Befriend").
		Id = "Character",
		Name = "Blockhead Visitor",
		Emoji = "💛",
		Weight = 2,
		Patience = 22,
		PayMult = 3,
		Items = 1,
		Xp = 12,
		RushPoints = 40,
		Special = true,
	},
}

local byId: { [string]: CustomerType } = {}
for _, customerType in list do
	byId[customerType.Id] = customerType
end

return {
	List = list,
	ById = byId,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">GameConfig</string>
            <string name="Source"><![CDATA[-- Core tuning values for the whole game. Change numbers here, not in the services.

local GameConfig = {
	-- Data
	DataStoreName = "BlockheadsPlayerData_v1",
	LeaderboardStoreName = "BlockheadsTopEarners_v1",
	DataVersion = 1,
	AutosaveInterval = 120, -- seconds between background saves
	SessionLockTimeout = 180, -- seconds before another server may take over a stale session

	-- Server
	MaxPlots = 8,
	StartingCoins = 10,

	-- Customers
	BaseSpawnInterval = 3.6, -- seconds between customers at an un-upgraded stand
	SpawnIntervalJitter = 0.35, -- +/- 35% randomness on each spawn
	BaseQueueSize = 3,
	CustomerWalkSpeed = 13, -- studs per second
	SpecialCustomerBoostPerAppearance = 0.25, -- +25% special customer weight per Curb Appeal level
	MultiOrderTimeFactor = 0.8, -- each extra item in an order adds 80% of its time

	-- Combo: consecutive serves without losing a customer
	ComboBonusPerServe = 0.05,
	ComboMaxBonus = 0.5,
	FastServeWindow = 0.35, -- served within the first 35% of patience = tip
	FastServeTip = 0.25, -- +25% of the order as a tip

	-- Staff + register
	RegisterBaseCapacityServes = 8, -- register holds this many average sales at storage level 0
	RegisterCollectRadius = 10, -- studs from the register for auto-collect

	-- Leveling
	XpBase = 40,
	XpExponent = 1.5,
	LevelUpRewardServes = 5, -- level-up bonus, measured in "average sales"

	-- Character team slots unlocked by business tier
	TeamSlotsByTier = { 1, 2, 2, 3, 3 },

	-- Leaderboards
	GlobalLeaderboardRefresh = 120,
	GlobalLeaderboardSize = 10,

	-- Tutorial
	TutorialReward = 100,
}

return GameConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Products</string>
            <string name="Source"><![CDATA[-- Every sellable product.
--   Tier        = index into Businesses.luau (which business introduces it)
--   Price       = coins per sale at level 1
--   Time        = seconds to make one at speed level 0
--   Demand      = how often customers order it relative to other products
--   UnlockCost  = coins to add it to the menu (0 = free with the business)

export type Product = {
	Id: string,
	Name: string,
	Emoji: string,
	Tier: number,
	Price: number,
	Time: number,
	Demand: number,
	UnlockCost: number,
	Order: number,
}

local MAX_LEVEL = 10

local list: { Product } = {
	-- Lemonade Stand
	{ Id = "Lemonade", Name = "Lemonade", Emoji = "🍋", Tier = 1, Price = 5, Time = 2.0, Demand = 10, UnlockCost = 0, Order = 0 },
	{ Id = "StrawberryLemonade", Name = "Strawberry Lemonade", Emoji = "🍓", Tier = 1, Price = 9, Time = 2.4, Demand = 8, UnlockCost = 75, Order = 0 },
	{ Id = "OrangeJuice", Name = "Orange Juice", Emoji = "🍊", Tier = 1, Price = 16, Time = 2.8, Demand = 7, UnlockCost = 350, Order = 0 },
	{ Id = "FreshJuice", Name = "Fresh Juice", Emoji = "🥤", Tier = 1, Price = 28, Time = 3.2, Demand = 6, UnlockCost = 1100, Order = 0 },
	{ Id = "BlockheadsSpecial", Name = "Blockheads Special", Emoji = "🧃", Tier = 1, Price = 48, Time = 3.6, Demand = 5, UnlockCost = 3000, Order = 0 },

	-- Burger Shop
	{ Id = "ClassicBurger", Name = "Classic Burger", Emoji = "🍔", Tier = 2, Price = 85, Time = 3.6, Demand = 10, UnlockCost = 0, Order = 0 },
	{ Id = "Fries", Name = "Crispy Fries", Emoji = "🍟", Tier = 2, Price = 120, Time = 3.4, Demand = 8, UnlockCost = 6000, Order = 0 },
	{ Id = "Cheeseburger", Name = "Cheeseburger", Emoji = "🧀", Tier = 2, Price = 180, Time = 4.0, Demand = 7, UnlockCost = 14000, Order = 0 },
	{ Id = "DoubleStack", Name = "Double Stack", Emoji = "🥓", Tier = 2, Price = 280, Time = 4.4, Demand = 5, UnlockCost = 32000, Order = 0 },

	-- Pizza Shop
	{ Id = "CheeseSlice", Name = "Cheese Slice", Emoji = "🍕", Tier = 3, Price = 450, Time = 4.0, Demand = 10, UnlockCost = 0, Order = 0 },
	{ Id = "Pepperoni", Name = "Pepperoni Pizza", Emoji = "🌶️", Tier = 3, Price = 680, Time = 4.2, Demand = 8, UnlockCost = 55000, Order = 0 },
	{ Id = "VeggiePizza", Name = "Veggie Pizza", Emoji = "🫑", Tier = 3, Price = 950, Time = 4.4, Demand = 7, UnlockCost = 120000, Order = 0 },
	{ Id = "SupremePizza", Name = "Blockhead Supreme", Emoji = "👑", Tier = 3, Price = 1400, Time = 4.8, Demand = 5, UnlockCost = 260000, Order = 0 },

	-- Ice Cream Shop
	{ Id = "VanillaCone", Name = "Vanilla Cone", Emoji = "🍦", Tier = 4, Price = 2200, Time = 4.0, Demand = 10, UnlockCost = 0, Order = 0 },
	{ Id = "ChocoScoop", Name = "Choco Scoop", Emoji = "🍫", Tier = 4, Price = 3200, Time = 4.2, Demand = 8, UnlockCost = 450000, Order = 0 },
	{ Id = "Sundae", Name = "Cherry Sundae", Emoji = "🍒", Tier = 4, Price = 4600, Time = 4.6, Demand = 7, UnlockCost = 950000, Order = 0 },
	{ Id = "RainbowTower", Name = "Rainbow Tower", Emoji = "🌈", Tier = 4, Price = 6800, Time = 5.0, Demand = 5, UnlockCost = 2000000, Order = 0 },

	-- Restaurant
	{ Id = "Pasta", Name = "Pasta Bowl", Emoji = "🍝", Tier = 5, Price = 10500, Time = 4.4, Demand = 10, UnlockCost = 0, Order = 0 },
	{ Id = "Sushi", Name = "Sushi Platter", Emoji = "🍣", Tier = 5, Price = 15000, Time = 4.6, Demand = 8, UnlockCost = 3500000, Order = 0 },
	{ Id = "Steak", Name = "Sizzling Steak", Emoji = "🥩", Tier = 5, Price = 22000, Time = 5.0, Demand = 7, UnlockCost = 8000000, Order = 0 },
	{ Id = "ChefsFeast", Name = "Chef's Feast", Emoji = "🍱", Tier = 5, Price = 34000, Time = 5.4, Demand = 5, UnlockCost = 18000000, Order = 0 },
}

local byId: { [string]: Product } = {}
for index, product in list do
	product.Order = index
	byId[product.Id] = product
end

return {
	List = list,
	ById = byId,
	MaxLevel = MAX_LEVEL,
	PricePerLevel = 0.2, -- +20% price per product level
	UpgradeCostFactor = 14, -- level 2 costs Price * this
	UpgradeCostGrowth = 1.6, -- each further level costs this much more
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Quests</string>
            <string name="Source"><![CDATA[-- Daily objectives and the 7-day login reward track.
-- Coin rewards are measured in "average sales" so they scale with the player's shop.

export type QuestDef = {
	Id: string,
	Text: string, -- %d is replaced by the goal
	Event: string, -- progress event raised by the server (see QuestService)
	Goals: { number }, -- one goal is picked at random
	RewardServes: number,
	Xp: number,
}

local Pool: { QuestDef } = {
	{ Id = "Serve", Text = "Serve %d customers", Event = "Served", Goals = { 25, 40, 60 }, RewardServes = 12, Xp = 40 },
	{ Id = "Special", Text = "Serve %d Rich or VIP customers", Event = "ServedSpecial", Goals = { 3, 5 }, RewardServes = 15, Xp = 50 },
	{ Id = "Combo", Text = "Reach a x%d serve combo", Event = "Combo", Goals = { 8, 10 }, RewardServes = 12, Xp = 40 },
	{ Id = "Fast", Text = "Earn %d fast-service tips", Event = "FastServe", Goals = { 10, 15 }, RewardServes = 12, Xp = 40 },
	{ Id = "Upgrade", Text = "Buy %d upgrades", Event = "Upgrade", Goals = { 2, 3 }, RewardServes = 10, Xp = 30 },
	{ Id = "Rush", Text = "Score %d points in Customer Rushes", Event = "RushPoints", Goals = { 100, 200 }, RewardServes = 20, Xp = 60 },
	{ Id = "Hungry", Text = "Serve %d Hungry customers", Event = "ServedHungry", Goals = { 4, 6 }, RewardServes = 12, Xp = 40 },
}

return {
	Pool = Pool,
	PerDay = 3,

	-- Login streak: day 1..7, then loops. Missing a day resets to day 1.
	DailyRewardServes = { 8, 12, 16, 22, 30, 40, 80 },
	DailyMinimumCoins = 50,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Rush</string>
            <string name="Source"><![CDATA[-- Customer Rush event tuning.

return {
	FirstDelay = 150, -- seconds after server start before the first rush
	MinInterval = 240, -- seconds between rushes (random between Min and Max)
	MaxInterval = 360,
	Countdown = 10, -- "CUSTOMER RUSH STARTING!" warning time
	Duration = 75, -- seconds of rush

	SpawnIntervalMultiplier = 0.3, -- customers arrive this much faster (lower = faster)
	ExtraQueueSlots = 3,
	PatienceMultiplier = 0.8,

	-- Coin rewards are measured in "average sales" of the winner's own shop,
	-- so a prize is meaningful at every stage of progression.
	RewardServes = { 40, 25, 15 }, -- 1st, 2nd, 3rd
	ParticipationServes = 6, -- everyone else who scored at least MinPointsForReward
	MinPointsForReward = 30,

	-- Exclusive cosmetic for 1st place (see Cosmetics.luau).
	WinnerCosmetic = "Gold",
	MinPointsForWin = 100,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Theme</string>
            <string name="Source"><![CDATA[-- Shared look and feel: UI colours, fonts and built-in sound paths.

local Theme = {
	Font = Enum.Font.FredokaOne,
	BodyFont = Enum.Font.GothamMedium,
	BoldFont = Enum.Font.GothamBold,

	Panel = Color3.fromRGB(255, 250, 240),
	PanelStroke = Color3.fromRGB(46, 52, 84),
	Card = Color3.fromRGB(255, 255, 255),
	CardAlt = Color3.fromRGB(244, 238, 226),
	Text = Color3.fromRGB(46, 52, 84),
	SubText = Color3.fromRGB(120, 124, 150),
	White = Color3.fromRGB(255, 255, 255),

	Yellow = Color3.fromRGB(255, 205, 56),
	Green = Color3.fromRGB(76, 201, 110),
	Red = Color3.fromRGB(240, 84, 84),
	Blue = Color3.fromRGB(66, 150, 255),
	Purple = Color3.fromRGB(160, 100, 250),
	Orange = Color3.fromRGB(255, 150, 60),
	Pink = Color3.fromRGB(255, 120, 180),
	Grey = Color3.fromRGB(170, 174, 190),
	Dark = Color3.fromRGB(46, 52, 84),

	-- Sounds that ship inside the Roblox client (no asset IDs needed).
	-- Replace any of these with "rbxassetid://<your id>" when you have your own audio.
	Sounds = {
		Click = "rbxasset://sounds/button.wav",
		Coin = "rbxasset://sounds/electronicpingshort.wav",
		Purchase = "rbxasset://sounds/snap.wav",
		Error = "rbxasset://sounds/uuhhh.mp3",
		LevelUp = "rbxasset://sounds/victory.wav",
		Rush = "rbxasset://sounds/bass.wav",
		Lost = "rbxasset://sounds/splat.wav",
	},
	-- Background music is NOT included. Put a music asset id here to enable it,
	-- e.g. "rbxassetid://1234567890".
	Music = "",
}

return Theme
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Upgrades</string>
            <string name="Source"><![CDATA[-- Business upgrades. Cost of the next level = BaseCost * Growth ^ currentLevel.
-- The effect of each level is applied in Shared/Modules/Formulas.luau.

export type Upgrade = {
	Id: string,
	Name: string,
	Emoji: string,
	Description: string,
	MaxLevel: number,
	BaseCost: number,
	Growth: number,
	PerLevel: number,
}

local list: { Upgrade } = {
	{
		Id = "Speed",
		Name = "Faster Hands",
		Emoji = "⚡",
		Description = "Make products 6% faster per level.",
		MaxLevel = 10,
		BaseCost = 25,
		Growth = 2.2,
		PerLevel = 0.06,
	},
	{
		Id = "Quality",
		Name = "Premium Recipes",
		Emoji = "✨",
		Description = "Everything sells for 10% more per level.",
		MaxLevel = 10,
		BaseCost = 60,
		Growth = 2.4,
		PerLevel = 0.10,
	},
	{
		Id = "Capacity",
		Name = "Bigger Queue",
		Emoji = "👥",
		Description = "+1 queue spot and customers arrive 7% faster per level.",
		MaxLevel = 6,
		BaseCost = 120,
		Growth = 2.8,
		PerLevel = 0.07,
	},
	{
		Id = "Staff",
		Name = "Hire Staff",
		Emoji = "🧑‍🍳",
		Description = "Your team serves customers for you. Sales go to the register.",
		MaxLevel = 8,
		BaseCost = 400,
		Growth = 2.6,
		PerLevel = 0.25,
	},
	{
		Id = "Storage",
		Name = "Cash Register",
		Emoji = "💰",
		Description = "The register holds 2.5x more staff sales per level.",
		MaxLevel = 8,
		BaseCost = 300,
		Growth = 2.5,
		PerLevel = 2.5,
	},
	{
		Id = "Appearance",
		Name = "Curb Appeal",
		Emoji = "🌷",
		Description = "Decorate your shop. Attracts more Rich and VIP customers.",
		MaxLevel = 5,
		BaseCost = 250,
		Growth = 3.2,
		PerLevel = 0.25,
	},
}

local byId: { [string]: Upgrade } = {}
for _, upgrade in list do
	byId[upgrade.Id] = upgrade
end

return {
	List = list,
	ById = byId,
	-- Staff serve time = product time * (StaffSlowest - PerLevel * level)
	StaffSlowest = 3.25,
}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="15">
        <Properties>
          <string name="Name">Modules</string>
        </Properties>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">BlockheadBuilder</string>
            <string name="Source"><![CDATA[-- Builds blocky "Blockhead" figures out of plain parts (no asset IDs needed).
-- Used for NPC customers (client side) and collectible characters (server + UI).
--
-- A figure hangs off a flat invisible Root part whose position is the point on the
-- ground between the feet, facing Root.CFrame.LookVector. Move the Root's CFrame and
-- the whole figure follows.
--
-- If ReplicatedStorage > Assets > Characters contains a Model named after a character
-- Id, buildCharacter() uses that model instead of the placeholder.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Make = require(script.Parent.Make)
local Characters = require(script.Parent.Parent.Config.Characters)

local BlockheadBuilder = {}

local DARK = Color3.fromRGB(35, 38, 58)
local WHITE = Color3.fromRGB(255, 255, 255)

local SKINS = {
	Color3.fromRGB(255, 214, 102),
	Color3.fromRGB(255, 196, 170),
	Color3.fromRGB(236, 170, 120),
	Color3.fromRGB(196, 150, 110),
	Color3.fromRGB(150, 110, 80),
	Color3.fromRGB(180, 220, 255),
	Color3.fromRGB(190, 240, 170),
}
local SHIRTS = {
	Color3.fromRGB(64, 156, 255),
	Color3.fromRGB(255, 120, 160),
	Color3.fromRGB(120, 200, 80),
	Color3.fromRGB(255, 170, 60),
	Color3.fromRGB(160, 110, 250),
	Color3.fromRGB(80, 210, 200),
	Color3.fromRGB(240, 240, 240),
}
local PANTS = {
	Color3.fromRGB(52, 73, 110),
	Color3.fromRGB(70, 70, 80),
	Color3.fromRGB(110, 80, 60),
	Color3.fromRGB(60, 100, 80),
}
local EYES = { "Dot", "Dot", "Wide", "Sleepy" }
local MOUTHS = { "Smile", "Smile", "Grin", "Flat", "Open" }
local RANDOM_HATS = { "Cap", "Beanie" }

-- A random everyday look, stable for a given seed (so every client sees the same NPC).
function BlockheadBuilder.randomLook(seed: number)
	local rng = Random.new(seed)
	local look = {
		Skin = SKINS[rng:NextInteger(1, #SKINS)],
		Shirt = SHIRTS[rng:NextInteger(1, #SHIRTS)],
		Pants = PANTS[rng:NextInteger(1, #PANTS)],
		Eyes = EYES[rng:NextInteger(1, #EYES)],
		Mouth = MOUTHS[rng:NextInteger(1, #MOUTHS)],
		Hat = nil :: string?,
		HatColor = nil :: Color3?,
		Scale = 0.9 + rng:NextNumber() * 0.2,
	}
	if rng:NextNumber() < 0.3 then
		look.Hat = RANDOM_HATS[rng:NextInteger(1, #RANDOM_HATS)]
		look.HatColor = SHIRTS[rng:NextInteger(1, #SHIRTS)]
	end
	return look
end

local function block(root: BasePart, name: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?)
	local part = Make("Part", {
		Name = name,
		Size = size,
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
		TopSurface = Enum.SurfaceType.Smooth,
		BottomSurface = Enum.SurfaceType.Smooth,
		Anchored = false,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Massless = true,
		CastShadow = false,
		CFrame = root.CFrame * offset,
		Parent = root,
	})
	Make("Weld", { Part0 = root, Part1 = part, C0 = offset, Parent = part })
	return part
end

local function faceFrame(parent, position: UDim2, size: UDim2, color: Color3, round: boolean?)
	local frame = Make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = position,
		Size = size,
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Parent = parent,
	})
	Make("UICorner", { CornerRadius = UDim.new(round and 1 or 0.3, 0), Parent = frame })
	return frame
end

-- Draws eyes and a mouth into any GuiObject (a SurfaceGui on a head, or a UI frame).
function BlockheadBuilder.drawFace(parent, look)
	for _, x in { 0.3, 0.7 } do
		local at = UDim2.fromScale(x, 0.4)
		if look.Eyes == "Wide" then
			local white = faceFrame(parent, at, UDim2.fromScale(0.2, 0.24), WHITE, true)
			Make("UIStroke", { Color = DARK, Thickness = 2, Parent = white })
			faceFrame(white, UDim2.fromScale(0.5, 0.55), UDim2.fromScale(0.5, 0.5), DARK, true)
		elseif look.Eyes == "Sleepy" then
			faceFrame(parent, at, UDim2.fromScale(0.18, 0.05), DARK)
		elseif look.Eyes == "Star" then
			Make("TextLabel", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = at,
				Size = UDim2.fromScale(0.3, 0.3),
				BackgroundTransparency = 1,
				Text = "★",
				TextScaled = true,
				TextColor3 = DARK,
				Font = Enum.Font.GothamBold,
				Parent = parent,
			})
		else
			faceFrame(parent, at, UDim2.fromScale(0.12, 0.17), DARK, true)
		end
	end

	local mouthAt = UDim2.fromScale(0.5, 0.72)
	if look.Mouth == "Grin" then
		local mouth = faceFrame(parent, mouthAt, UDim2.fromScale(0.42, 0.18), DARK)
		faceFrame(mouth, UDim2.fromScale(0.5, 0.25), UDim2.fromScale(0.8, 0.35), WHITE)
	elseif look.Mouth == "Flat" then
		faceFrame(parent, mouthAt, UDim2.fromScale(0.26, 0.05), DARK)
	elseif look.Mouth == "Open" then
		faceFrame(parent, mouthAt, UDim2.fromScale(0.18, 0.18), DARK, true)
	else
		faceFrame(parent, mouthAt, UDim2.fromScale(0.34, 0.09), DARK)
	end
end

local function addHat(root: BasePart, look, scale: number, headTop: number)
	local color = look.HatColor or DARK
	local s = scale
	local function at(x: number, y: number, z: number): CFrame
		return CFrame.new(x * s, headTop + y * s, z * s)
	end
	local hat = look.Hat
	if hat == "Cap" then
		block(root, "Hat", Vector3.new(2.5, 0.5, 2.5) * s, at(0, 0.25, 0), color)
		block(root, "Brim", Vector3.new(2.5, 0.2, 1) * s, at(0, 0.1, -1.7), color)
	elseif hat == "Beanie" then
		block(root, "Hat", Vector3.new(2.6, 0.8, 2.6) * s, at(0, 0.3, 0), color)
		block(root, "Pom", Vector3.new(0.7, 0.7, 0.7) * s, at(0, 1.0, 0), WHITE)
	elseif hat == "ChefHat" then
		block(root, "Hat", Vector3.new(1.8, 1.2, 1.8) * s, at(0, 0.6, 0), color)
		block(root, "Puff", Vector3.new(2.4, 0.9, 2.4) * s, at(0, 1.6, 0), color)
	elseif hat == "TopHat" then
		block(root, "Brim", Vector3.new(3, 0.2, 3) * s, at(0, 0.1, 0), color)
		block(root, "Hat", Vector3.new(1.9, 1.6, 1.9) * s, at(0, 1.0, 0), color)
	elseif hat == "Crown" then
		block(root, "Hat", Vector3.new(2.2, 0.5, 2.2) * s, at(0, 0.25, 0), color, Enum.Material.Neon)
		for _, x in { -0.8, 0, 0.8 } do
			block(root, "Spike", Vector3.new(0.5, 0.6, 0.5) * s, at(x, 0.8, -0.8), color, Enum.Material.Neon)
			block(root, "Spike", Vector3.new(0.5, 0.6, 0.5) * s, at(x, 0.8, 0.8), color, Enum.Material.Neon)
		end
	elseif hat == "Headphones" then
		block(root, "Band", Vector3.new(2.8, 0.3, 0.5) * s, at(0, 0.15, 0), DARK)
		block(root, "EarL", Vector3.new(0.5, 1.2, 1.2) * s, at(-1.45, -1.2, 0), color, Enum.Material.Neon)
		block(root, "EarR", Vector3.new(0.5, 1.2, 1.2) * s, at(1.45, -1.2, 0), color, Enum.Material.Neon)
	elseif hat == "Bow" then
		block(root, "BowL", Vector3.new(0.9, 0.8, 0.5) * s, at(-0.55, 0.4, 0), color)
		block(root, "BowR", Vector3.new(0.9, 0.8, 0.5) * s, at(0.55, 0.4, 0), color)
		block(root, "Knot", Vector3.new(0.4, 0.5, 0.6) * s, at(0, 0.35, 0), WHITE)
	end
end

-- Adds the body parts for `look` to an existing Root part. Returns the head part.
function BlockheadBuilder.attach(root: BasePart, look): BasePart
	local s = look.Scale or 1
	block(root, "LegL", Vector3.new(0.9, 1.6, 0.9) * s, CFrame.new(-0.5 * s, 0.8 * s, 0), look.Pants)
	block(root, "LegR", Vector3.new(0.9, 1.6, 0.9) * s, CFrame.new(0.5 * s, 0.8 * s, 0), look.Pants)
	block(root, "Torso", Vector3.new(2, 1.8, 1.1) * s, CFrame.new(0, 2.5 * s, 0), look.Shirt)
	block(root, "ArmL", Vector3.new(0.7, 1.7, 0.8) * s, CFrame.new(-1.4 * s, 2.5 * s, 0), look.Skin)
	block(root, "ArmR", Vector3.new(0.7, 1.7, 0.8) * s, CFrame.new(1.4 * s, 2.5 * s, 0), look.Skin)
	local head = block(root, "Head", Vector3.new(2.4, 2.4, 2.4) * s, CFrame.new(0, 4.6 * s, 0), look.Skin)

	local face = Make("SurfaceGui", {
		Name = "Face",
		Face = Enum.NormalId.Front,
		CanvasSize = Vector2.new(100, 100),
		LightInfluence = 0.4,
		Parent = head,
	})
	local canvas = Make("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = face,
	})
	BlockheadBuilder.drawFace(canvas, look)

	if look.Hat then
		addHat(root, look, s, 5.8 * s)
	end
	return head
end

-- Creates the invisible Root part a figure hangs from.
function BlockheadBuilder.newRoot(cframe: CFrame): BasePart
	return Make("Part", {
		Name = "Root",
		Size = Vector3.new(2, 0.2, 2),
		Transparency = 1,
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CFrame = cframe,
	})
end

-- Builds a full standing figure in a Model. `cframe` is the ground point + facing.
function BlockheadBuilder.build(look, cframe: CFrame): Model
	local model = Instance.new("Model")
	model.Name = "Blockhead"
	local root = BlockheadBuilder.newRoot(cframe)
	root.Parent = model
	model.PrimaryPart = root
	BlockheadBuilder.attach(root, look)
	return model
end

-- Builds a collectible character. Prefers a custom model in
-- ReplicatedStorage.Assets.Characters[characterId] when one exists.
function BlockheadBuilder.buildCharacter(characterId: string, cframe: CFrame): Model?
	local character = Characters.ById[characterId]
	if not character then
		return nil
	end

	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local folder = assets and assets:FindFirstChild("Characters")
	local custom = folder and folder:FindFirstChild(characterId)
	if custom and custom:IsA("Model") and custom.PrimaryPart then
		local clone = custom:Clone()
		clone.Name = characterId
		for _, descendant in clone:GetDescendants() do
			if descendant:IsA("BasePart") then
				descendant.Anchored = true
				descendant.CanCollide = false
			end
		end
		-- Custom models pivot wherever the artist placed the pivot; we expect feet.
		clone:PivotTo(cframe)
		return clone
	end

	local model = BlockheadBuilder.build(character.Look, cframe)
	model.Name = characterId
	return model
end

return BlockheadBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">Format</string>
            <string name="Source"><![CDATA[-- Number and time formatting shared by the server (world signs) and client (UI).

local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa" }

-- 1234 -> "1,234"   1234567 -> "1.23M"
function Format.number(value: number): string
	value = math.floor(value + 0.5)
	if value < 100000 then
		local text = tostring(value)
		local formatted = text:reverse():gsub("(%d%d%d)", "%1,"):reverse()
		if formatted:sub(1, 1) == "," then
			formatted = formatted:sub(2)
		end
		return formatted
	end
	local index = 1
	local scaled = value
	while scaled >= 1000 and index < #SUFFIXES do
		scaled /= 1000
		index += 1
	end
	local text
	if scaled >= 100 then
		text = string.format("%.0f", scaled)
	elseif scaled >= 10 then
		text = string.format("%.1f", scaled)
	else
		text = string.format("%.2f", scaled)
	end
	return text .. SUFFIXES[index]
end

function Format.coins(value: number): string
	return "🪙 " .. Format.number(value)
end

-- 75 -> "1:15"
function Format.clock(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

function Format.percent(fraction: number): string
	return string.format("%d%%", math.floor(fraction * 100 + 0.5))
end

return Format
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Formulas</string>
            <string name="Source"><![CDATA[-- Every gameplay formula in one place. Pure functions of a player profile, so the
-- server (authority) and the client (UI previews) always agree on the numbers.

local Config = script.Parent.Parent.Config
local GameConfig = require(Config.GameConfig)
local Products = require(Config.Products)
local Upgrades = require(Config.Upgrades)
local Characters = require(Config.Characters)

local Formulas = {}

-- Cost to buy the next level of an upgrade, or nil when maxed.
function Formulas.upgradeCost(upgradeId: string, currentLevel: number): number?
	local upgrade = Upgrades.ById[upgradeId]
	if not upgrade or currentLevel >= upgrade.MaxLevel then
		return nil
	end
	return math.floor(upgrade.BaseCost * upgrade.Growth ^ currentLevel + 0.5)
end

-- Cost to raise a product from currentLevel to currentLevel + 1, or nil when maxed.
function Formulas.productUpgradeCost(productId: string, currentLevel: number): number?
	local product = Products.ById[productId]
	if not product or currentLevel >= Products.MaxLevel then
		return nil
	end
	local base = math.max(30, product.Price * Products.UpgradeCostFactor)
	return math.floor(base * Products.UpgradeCostGrowth ^ (currentLevel - 1) + 0.5)
end

-- Sum of the bonuses of all equipped characters, e.g. { Sales = 0.08, Speed = 0.03 }.
function Formulas.bonuses(profile): { [string]: number }
	local totals = { Sales = 0, Speed = 0, Patience = 0, Staff = 0, Xp = 0, Rush = 0 }
	for _, characterId in profile.Equipped do
		local character = Characters.ById[characterId]
		if character and profile.Characters[characterId] then
			for kind, amount in character.Bonus do
				totals[kind] = (totals[kind] or 0) + amount
			end
		end
	end
	return totals
end

function Formulas.productPrice(profile, productId: string): number
	local product = Products.ById[productId]
	local level = profile.Products[productId] or 1
	local price = product.Price
		* (1 + Products.PricePerLevel * (level - 1))
		* (1 + Upgrades.ById.Quality.PerLevel * profile.Upgrades.Quality)
		* (1 + Formulas.bonuses(profile).Sales)
	return math.max(1, math.floor(price + 0.5))
end

function Formulas.productTime(profile, productId: string): number
	local product = Products.ById[productId]
	local speed = 1 - Upgrades.ById.Speed.PerLevel * profile.Upgrades.Speed
	local seconds = product.Time * speed * (1 - Formulas.bonuses(profile).Speed)
	return math.max(0.4, seconds)
end

function Formulas.queueSize(profile): number
	return GameConfig.BaseQueueSize + profile.Upgrades.Capacity
end

function Formulas.spawnInterval(profile): number
	return GameConfig.BaseSpawnInterval * (1 - Upgrades.ById.Capacity.PerLevel * profile.Upgrades.Capacity)
end

function Formulas.patienceMultiplier(profile): number
	return 1 + Formulas.bonuses(profile).Patience
end

-- How many times slower than the player the staff are. nil = no staff hired.
function Formulas.staffTimeMultiplier(profile): number?
	local level = profile.Upgrades.Staff
	if level <= 0 then
		return nil
	end
	local multiplier = Upgrades.StaffSlowest - Upgrades.ById.Staff.PerLevel * level
	return math.max(1, multiplier / (1 + Formulas.bonuses(profile).Staff))
end

-- The products currently on the menu with their order weights.
-- Products from older businesses are ordered less often.
function Formulas.menu(profile): { { Id: string, Weight: number } }
	local menu = {}
	for _, product in Products.List do
		if profile.Products[product.Id] and product.Tier <= profile.BusinessTier then
			local age = profile.BusinessTier - product.Tier
			table.insert(menu, { Id = product.Id, Weight = product.Demand * 0.5 ^ age })
		end
	end
	return menu
end

-- "Average sale": the weighted mean price of the menu. Rewards are expressed in
-- multiples of this so they stay meaningful as the player grows.
function Formulas.serveWorth(profile): number
	local total, weight = 0, 0
	for _, entry in Formulas.menu(profile) do
		total += Formulas.productPrice(profile, entry.Id) * entry.Weight
		weight += entry.Weight
	end
	if weight <= 0 then
		return 1
	end
	return math.max(1, math.floor(total / weight + 0.5))
end

function Formulas.registerCapacity(profile): number
	local capacity = Formulas.serveWorth(profile)
		* GameConfig.RegisterBaseCapacityServes
		* Upgrades.ById.Storage.PerLevel ^ profile.Upgrades.Storage
	return math.floor(capacity + 0.5)
end

-- XP needed to go from `level` to `level + 1`.
function Formulas.xpForLevel(level: number): number
	return math.floor(GameConfig.XpBase * level ^ GameConfig.XpExponent + 0.5)
end

function Formulas.teamSlots(profile): number
	local slots = GameConfig.TeamSlotsByTier[profile.BusinessTier] or 1
	return math.min(slots, Characters.MaxTeamSize)
end

function Formulas.comboBonus(combo: number): number
	return math.min(GameConfig.ComboMaxBonus, GameConfig.ComboBonusPerServe * combo)
end

-- UTC day number, used for daily rewards and daily quests.
function Formulas.dayNumber(unixTime: number): number
	return unixTime // 86400
end

return Formulas
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Make</string>
            <string name="Source"><![CDATA[-- Tiny instance factory: Make("Part", { Size = ..., Parent = ... }, { child, child })
-- Parent is always assigned last so property changes replicate in one go.

local function Make(className: string, props: { [string]: any }?, children: { Instance }?): any
	local instance = Instance.new(className)
	local parent = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				(instance :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

return Make
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Net</string>
            <string name="Source"><![CDATA[-- Network object names. The server creates them (Server/Services/Remotes.luau);
-- the client fetches them with Net.get(name).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = {
	FolderName = "Remotes",

	-- RemoteEvents, server -> client
	Events = {
		"StateUpdate", -- (profile) the player's own saved state
		"Notify", -- (kind, data) toasts, sale popups, level ups
		"RushUpdate", -- (state) Customer Rush phase, timer and scores
	},
	-- RemoteFunctions, client -> server
	Functions = {
		"Action", -- (actionName, ...args) -> ok: boolean, message: string?
	},
}

function Net.get(name: string): any
	local folder = ReplicatedStorage:WaitForChild(Net.FolderName)
	return folder:WaitForChild(name)
end

return Net
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[-- Minimal Lua signal used for communication between modules on the same side
-- (server-to-server or client-to-client). Not a network object.

local Signal = {}
Signal.__index = Signal

function Signal.new()
	return setmetatable({ _handlers = {} }, Signal)
end

function Signal:Connect(handler)
	local connection = { Connected = true }
	local handlers = self._handlers
	table.insert(handlers, { fn = handler, connection = connection })
	function connection.Disconnect()
		connection.Connected = false
		for index, entry in handlers do
			if entry.connection == connection then
				table.remove(handlers, index)
				break
			end
		end
	end
	return connection
end

function Signal:Fire(...)
	-- Copy so handlers may disconnect while we iterate.
	for _, entry in table.clone(self._handlers) do
		if entry.connection.Connected then
			task.spawn(entry.fn, ...)
		end
	end
end

return Signal
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="22">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="23">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="24">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- BLOCKHEADS: HUSTLE & COLLECT - server entry point.
-- Loads every service in dependency order: Init() first (create objects), then
-- Start() (connect events, begin loops). All gameplay lives in Services/*.

local Services = script.Parent:WaitForChild("Services")

local ORDER = {
	"Remotes",
	"DataService",
	"EconomyService",
	"PlotService",
	"BusinessService",
	"CustomerService",
	"RushService",
	"CharacterService",
	"QuestService",
	"LeaderboardService",
}

local loaded = {}
for _, name in ORDER do
	loaded[name] = require(Services:WaitForChild(name))
end
for _, name in ORDER do
	loaded[name].Init()
end
for _, name in ORDER do
	loaded[name].Start()
end

-- Only now start loading player data (see DataService.Begin).
loaded.DataService.Begin()

print("[Blockheads] Server ready.")
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="25">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">BusinessService</string>
            <string name="Source"><![CDATA[-- Everything a player can buy for their shop: upgrades, products, product levels,
-- new business tiers and awning styles. Also advances the tutorial.
-- All prices come from shared config and are checked here on the server.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Businesses = require(Shared.Config.Businesses)
local Products = require(Shared.Config.Products)
local Upgrades = require(Shared.Config.Upgrades)
local Cosmetics = require(Shared.Config.Cosmetics)
local Formulas = require(Shared.Modules.Formulas)
local Signal = require(Shared.Modules.Signal)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local PlotService = require(script.Parent.PlotService)
local Remotes = require(script.Parent.Remotes)

local BusinessService = {
	Purchased = Signal.new(), -- (player, kind: "Upgrade"|"Product"|"ProductLevel"|"Business"|"Cosmetic", id)
}

local TUTORIAL_STEPS = 3 -- 1 serve a customer, 2 buy an upgrade, 3 unlock a product

-- Marks tutorial step `step` complete if it is the player's current step.
function BusinessService.advanceTutorial(player: Player, step: number)
	local profile = DataService.get(player)
	if not profile or profile.Tutorial ~= step then
		return
	end
	if step >= TUTORIAL_STEPS then
		profile.Tutorial = 0
		EconomyService.addCoins(player, GameConfig.TutorialReward)
		Remotes.notify(player, "Toast", {
			Text = `Tutorial complete! +{GameConfig.TutorialReward} coins`,
			Kind = "Reward",
		})
	else
		profile.Tutorial = step + 1
	end
	DataService.markDirty(player)
end

local function buyUpgrade(player: Player, upgradeId: any)
	local profile = DataService.get(player)
	if not profile or typeof(upgradeId) ~= "string" or not Upgrades.ById[upgradeId] then
		return false, "Unknown upgrade"
	end
	local level = profile.Upgrades[upgradeId] or 0
	local cost = Formulas.upgradeCost(upgradeId, level)
	if not cost then
		return false, "Already maxed"
	end
	if not EconomyService.trySpend(player, cost) then
		return false, "Not enough coins"
	end
	profile.Upgrades[upgradeId] = level + 1
	DataService.markDirty(player)
	if upgradeId == "Appearance" then
		PlotService.refresh(player)
	end
	BusinessService.Purchased:Fire(player, "Upgrade", upgradeId)
	BusinessService.advanceTutorial(player, 2)
	return true, `{Upgrades.ById[upgradeId].Name} is now level {level + 1}!`
end

local function buyProduct(player: Player, productId: any)
	local profile = DataService.get(player)
	local product = typeof(productId) == "string" and Products.ById[productId]
	if not profile or not product then
		return false, "Unknown product"
	end
	if profile.Products[productId] then
		return false, "Already on the menu"
	end
	if product.Tier > profile.BusinessTier then
		return false, `Needs a {Businesses[product.Tier].Name}`
	end
	if not EconomyService.trySpend(player, product.UnlockCost) then
		return false, "Not enough coins"
	end
	profile.Products[productId] = 1
	DataService.markDirty(player)
	BusinessService.Purchased:Fire(player, "Product", productId)
	BusinessService.advanceTutorial(player, 3)
	return true, `{product.Name} added to the menu!`
end

local function upgradeProduct(player: Player, productId: any)
	local profile = DataService.get(player)
	local product = typeof(productId) == "string" and Products.ById[productId]
	if not profile or not product then
		return false, "Unknown product"
	end
	local level = profile.Products[productId]
	if not level then
		return false, "Unlock it first"
	end
	local cost = Formulas.productUpgradeCost(productId, level)
	if not cost then
		return false, "Already maxed"
	end
	if not EconomyService.trySpend(player, cost) then
		return false, "Not enough coins"
	end
	profile.Products[productId] = level + 1
	DataService.markDirty(player)
	BusinessService.Purchased:Fire(player, "ProductLevel", productId)
	return true, `{product.Name} is now level {level + 1}!`
end

local function unlockBusiness(player: Player)
	local profile = DataService.get(player)
	if not profile then
		return false, "Loading"
	end
	local nextTier = profile.BusinessTier + 1
	local business = Businesses[nextTier]
	if not business then
		return false, "You own every business!"
	end
	if not EconomyService.trySpend(player, business.UnlockCost) then
		return false, "Not enough coins"
	end
	profile.BusinessTier = nextTier
	for _, product in Products.List do
		if product.Tier == nextTier and product.UnlockCost == 0 then
			profile.Products[product.Id] = profile.Products[product.Id] or 1
		end
	end
	DataService.markDirty(player)
	PlotService.refresh(player)
	BusinessService.Purchased:Fire(player, "Business", business.Id)
	Remotes.notifyAll("Toast", {
		Text = `{business.Emoji} {player.DisplayName} opened a {business.Name}!`,
		Kind = "Info",
	})
	return true, `Welcome to your new {business.Name}!`
end

local function buyCosmetic(player: Player, cosmeticId: any)
	local profile = DataService.get(player)
	local cosmetic = typeof(cosmeticId) == "string" and Cosmetics.ById[cosmeticId]
	if not profile or not cosmetic then
		return false, "Unknown style"
	end
	if profile.Cosmetics[cosmeticId] then
		return false, "Already owned"
	end
	if cosmetic.Unlock.Kind ~= "Coins" then
		return false, "This style cannot be bought"
	end
	if not EconomyService.trySpend(player, cosmetic.Unlock.Amount) then
		return false, "Not enough coins"
	end
	profile.Cosmetics[cosmeticId] = true
	profile.EquippedCosmetic = cosmeticId
	DataService.markDirty(player)
	PlotService.refresh(player)
	BusinessService.Purchased:Fire(player, "Cosmetic", cosmeticId)
	return true, `{cosmetic.Name} unlocked!`
end

local function equipCosmetic(player: Player, cosmeticId: any)
	local profile = DataService.get(player)
	if not profile or typeof(cosmeticId) ~= "string" or not Cosmetics.ById[cosmeticId] then
		return false, "Unknown style"
	end
	if not profile.Cosmetics[cosmeticId] then
		return false, "Not owned"
	end
	profile.EquippedCosmetic = cosmeticId
	DataService.markDirty(player)
	PlotService.refresh(player)
	return true
end

-- Grants a cosmetic earned through gameplay (rush wins, stats). Idempotent.
function BusinessService.grantCosmetic(player: Player, cosmeticId: string): boolean
	local profile = DataService.get(player)
	local cosmetic = Cosmetics.ById[cosmeticId]
	if not profile or not cosmetic or profile.Cosmetics[cosmeticId] then
		return false
	end
	profile.Cosmetics[cosmeticId] = true
	DataService.markDirty(player)
	Remotes.notify(player, "Toast", { Text = `New shop style unlocked: {cosmetic.Name}!`, Kind = "Reward" })
	return true
end

-- Unlocks cosmetics tied to lifetime stats.
function BusinessService.checkStatCosmetics(player: Player)
	local profile = DataService.get(player)
	if not profile then
		return
	end
	for _, cosmetic in Cosmetics.List do
		local unlock = cosmetic.Unlock
		if unlock.Kind == "Stat" and (profile.Stats[unlock.Stat] or 0) >= unlock.Amount then
			BusinessService.grantCosmetic(player, cosmetic.Id)
		end
	end
end

function BusinessService.Init() end

function BusinessService.Start()
	Remotes.register("BuyUpgrade", buyUpgrade)
	Remotes.register("BuyProduct", buyProduct)
	Remotes.register("UpgradeProduct", upgradeProduct)
	Remotes.register("UnlockBusiness", unlockBusiness)
	Remotes.register("BuyCosmetic", buyCosmetic)
	Remotes.register("EquipCosmetic", equipCosmetic)
end

return BusinessService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">CharacterService</string>
            <string name="Source"><![CDATA[-- The Blockheads collection: unlocking, buying and equipping characters.
-- Characters are never sold for Robux and never come from paid random rolls:
-- they are bought with coins, befriended as visiting customers, or earned.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Characters = require(Shared.Config.Characters)
local Formulas = require(Shared.Modules.Formulas)
local Signal = require(Shared.Modules.Signal)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local PlotService = require(script.Parent.PlotService)
local BusinessService = require(script.Parent.BusinessService)
local CustomerService = require(script.Parent.CustomerService)
local RushService = require(script.Parent.RushService)
local Remotes = require(script.Parent.Remotes)

local CharacterService = {
	Unlocked = Signal.new(), -- (player, characterId)
}

local rng = Random.new()

local function unlock(player: Player, characterId: string): boolean
	local profile = DataService.get(player)
	local character = Characters.ById[characterId]
	if not profile or not character or profile.Characters[characterId] then
		return false
	end
	profile.Characters[characterId] = true
	if #profile.Equipped < Formulas.teamSlots(profile) then
		table.insert(profile.Equipped, characterId)
		PlotService.refresh(player)
	end
	DataService.markDirty(player)
	Remotes.notify(player, "CharacterUnlocked", { Id = characterId })
	CharacterService.Unlocked:Fire(player, characterId)
	return true
end

-- Unlocks every character whose stat / business requirement is now met.
local function checkUnlocks(player: Player)
	local profile = DataService.get(player)
	if not profile then
		return
	end
	for _, character in Characters.List do
		if not profile.Characters[character.Id] then
			local rule = character.Unlock
			if rule.Kind == "Starter" then
				unlock(player, character.Id)
			elseif rule.Kind == "Stat" and (profile.Stats[rule.Stat] or 0) >= rule.Amount then
				unlock(player, character.Id)
			elseif rule.Kind == "Tier" and profile.BusinessTier >= rule.Amount then
				unlock(player, character.Id)
			elseif rule.Kind == "Befriend" and (profile.Befriend[character.Id] or 0) >= rule.Amount then
				unlock(player, character.Id)
			end
		end
	end
end

-- Which befriendable character (if any) may visit this player's shop next.
local function pickVisitor(profile): string?
	local candidates = {}
	for _, character in Characters.List do
		if character.Unlock.Kind == "Befriend" and not profile.Characters[character.Id] then
			table.insert(candidates, character.Id)
		end
	end
	if #candidates == 0 then
		return nil
	end
	return candidates[rng:NextInteger(1, #candidates)]
end

local function onServed(player: Player, info)
	local profile = DataService.get(player)
	if not profile then
		return
	end
	local characterId = info.CharacterId
	if characterId and not profile.Characters[characterId] then
		local character = Characters.ById[characterId]
		local count = (profile.Befriend[characterId] or 0) + 1
		profile.Befriend[characterId] = count
		DataService.markDirty(player)
		if count < character.Unlock.Amount then
			Remotes.notify(player, "Toast", {
				Text = `💛 {character.Name} liked that! Friendship {count}/{character.Unlock.Amount}`,
				Kind = "Info",
			})
		end
	end
	checkUnlocks(player)
end

local function buyCharacter(player: Player, characterId: any)
	local profile = DataService.get(player)
	local character = typeof(characterId) == "string" and Characters.ById[characterId]
	if not profile or not character then
		return false, "Unknown character"
	end
	if profile.Characters[characterId] then
		return false, "Already collected"
	end
	if character.Unlock.Kind ~= "Coins" then
		return false, "This Blockhead cannot be bought"
	end
	if not EconomyService.trySpend(player, character.Unlock.Amount) then
		return false, "Not enough coins"
	end
	unlock(player, characterId)
	return true, `{character.Name} joined your collection!`
end

local function equipCharacter(player: Player, characterId: any)
	local profile = DataService.get(player)
	if not profile or typeof(characterId) ~= "string" or not Characters.ById[characterId] then
		return false, "Unknown character"
	end
	if not profile.Characters[characterId] then
		return false, "Not collected yet"
	end
	if table.find(profile.Equipped, characterId) then
		return false, "Already on your team"
	end
	if #profile.Equipped >= Formulas.teamSlots(profile) then
		return false, "Your team is full"
	end
	table.insert(profile.Equipped, characterId)
	DataService.markDirty(player)
	PlotService.refresh(player)
	return true
end

local function unequipCharacter(player: Player, characterId: any)
	local profile = DataService.get(player)
	if not profile or typeof(characterId) ~= "string" then
		return false, "Unknown character"
	end
	local index = table.find(profile.Equipped, characterId)
	if not index then
		return false, "Not on your team"
	end
	table.remove(profile.Equipped, index)
	DataService.markDirty(player)
	PlotService.refresh(player)
	return true
end

function CharacterService.Init() end

function CharacterService.Start()
	CustomerService.VisitorPicker = pickVisitor
	CustomerService.Served:Connect(onServed)
	RushService.Scored:Connect(checkUnlocks)
	BusinessService.Purchased:Connect(function(player, kind)
		if kind == "Business" then
			checkUnlocks(player)
		end
	end)
	DataService.Loaded:Connect(checkUnlocks)

	Remotes.register("BuyCharacter", buyCharacter)
	Remotes.register("EquipCharacter", equipCharacter)
	Remotes.register("UnequipCharacter", unequipCharacter)
end

return CharacterService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">CustomerService</string>
            <string name="Source"><![CDATA[-- NPC customers: spawning, queueing, ordering, patience, serving, staff and the
-- cash register. One lightweight simulation per owned plot, ticked ten times a second.
--
-- Performance model: the server never animates anything. A customer is a single
-- invisible anchored part carrying attributes (where it is walking, what it ordered,
-- how patient it is). Each client builds the visible Blockhead and animates it locally
-- (see Client/Controllers/CustomerRenderer). All decisions and rewards stay here.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Customers = require(Shared.Config.Customers)
local Products = require(Shared.Config.Products)
local RushConfig = require(Shared.Config.Rush)
local Formulas = require(Shared.Modules.Formulas)
local Format = require(Shared.Modules.Format)
local Signal = require(Shared.Modules.Signal)
local BlockheadBuilder = require(Shared.Modules.BlockheadBuilder)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local PlotService = require(script.Parent.PlotService)
local BusinessService = require(script.Parent.BusinessService)
local Remotes = require(script.Parent.Remotes)

local CustomerService = {
	Served = Signal.new(), -- (player, info) info = { Type, By, Amount, RushPoints, Fast, Combo, CharacterId }
	Lost = Signal.new(), -- (player, typeId)

	-- Set by CharacterService: (profile) -> characterId? for "Blockhead Visitor" customers.
	VisitorPicker = nil :: ((profile: any) -> string?)?,

	RushActive = false,
	RushSeed = 0,
}

local TICK = 0.1
local MAX_SLOTS = 12
local PATIENCE_SLOTS = 3 -- patience only runs for customers near the front
local CUSTOMER_TAG = "Customer"

local sims: { [any]: any } = {} -- plot -> simulation
local nextCustomerId = 0

---------------------------------------------------------------------------------------
-- Geometry
---------------------------------------------------------------------------------------

local function slotPosition(plot, slot: number): Vector3
	local x, z
	if slot == 1 then
		x, z = 0, -6.5
	elseif slot <= 7 then
		x, z = (slot - 2) * 3, -9.5
	else
		x, z = 15 - (slot - 8) * 3, -12.5
	end
	return plot.CFrame:PointToWorldSpace(Vector3.new(x, 0, z))
end

local function lanePosition(plot, rng: Random): Vector3
	return plot.CFrame:PointToWorldSpace(Vector3.new(rng:NextNumber(-5, 5), 0, rng:NextNumber(-25, -20)))
end

-- A bus stop near the plot: customers appear at and leave from one of the closest.
local function busStop(plot, rng: Random): Vector3
	local stops = plot.NearStops
	if not stops then
		stops = table.clone(PlotService.Town.BusStops)
		local front = plot.CFrame:PointToWorldSpace(Vector3.new(0, 0, -21))
		table.sort(stops, function(a, b)
			return (a - front).Magnitude < (b - front).Magnitude
		end)
		while #stops > 3 do
			table.remove(stops)
		end
		plot.NearStops = stops
	end
	local base = stops[rng:NextInteger(1, #stops)]
	return base + Vector3.new(rng:NextNumber(-1.5, 1.5), 0, rng:NextNumber(-1.5, 1.5))
end

---------------------------------------------------------------------------------------
-- Movement (attribute driven; clients animate)
---------------------------------------------------------------------------------------

local function startLeg(customer, target: Vector3, now: number)
	local distance = (target - customer.Position).Magnitude
	local duration = math.max(0.05, distance / GameConfig.CustomerWalkSpeed)
	local root = customer.Root
	root:SetAttribute("MoveFrom", customer.Position)
	root:SetAttribute("MoveTo", target)
	root:SetAttribute("MoveDur", duration)
	root:SetAttribute("MoveStart", Workspace:GetServerTimeNow())
	customer.Position = target
	customer.MoveEnd = now + duration
end

-- Queues `points` to be walked in order after the current leg.
local function walk(customer, points: { Vector3 }, now: number)
	customer.Path = points
	if now >= customer.MoveEnd and #points > 0 then
		startLeg(customer, table.remove(points, 1) :: Vector3, now)
	end
end

local function isIdle(customer, now: number): boolean
	return #customer.Path == 0 and now >= customer.MoveEnd
end

---------------------------------------------------------------------------------------
-- Spawning
---------------------------------------------------------------------------------------

local function pickWeighted(list, rng: Random, weightOf)
	local total = 0
	for _, item in list do
		total += weightOf(item)
	end
	if total <= 0 then
		return nil
	end
	local roll = rng:NextNumber() * total
	for _, item in list do
		roll -= weightOf(item)
		if roll <= 0 then
			return item
		end
	end
	return list[#list]
end

local function pickType(sim, rng: Random)
	local profile = sim.Profile
	local boost = 1 + GameConfig.SpecialCustomerBoostPerAppearance * profile.Upgrades.Appearance
	local visitor = nil
	if not CustomerService.RushActive and CustomerService.VisitorPicker then
		visitor = CustomerService.VisitorPicker(profile)
	end
	local customerType = pickWeighted(Customers.List, rng, function(entry)
		if entry.Id == "Character" and not visitor then
			return 0
		end
		return if entry.Special then entry.Weight * boost else entry.Weight
	end) or Customers.ById.Normal
	return customerType, if customerType.Id == "Character" then visitor else nil
end

local function spawnCustomer(sim, now: number)
	local plot = sim.Plot
	local typeRng = sim.RushRng or sim.Rng
	local customerType, characterId = pickType(sim, typeRng)

	local menu = Formulas.menu(sim.Profile)
	local orders = {}
	for _ = 1, customerType.Items do
		local entry = pickWeighted(menu, sim.Rng, function(item)
			return item.Weight
		end)
		if entry then
			table.insert(orders, entry.Id)
		end
	end
	if #orders == 0 then
		return
	end

	nextCustomerId += 1
	local slot = #sim.Queue + 1
	local start = busStop(plot, sim.Rng)

	local root = BlockheadBuilder.newRoot(CFrame.new(start))
	root.Name = "Customer" .. nextCustomerId
	root:SetAttribute("Seed", sim.Rng:NextInteger(1, 1000000))
	root:SetAttribute("CType", customerType.Id)
	root:SetAttribute("Order", table.concat(orders, ","))
	root:SetAttribute("Face", plot.ServePoint.CFrame.Position)
	root:SetAttribute("OwnerUserId", sim.Player.UserId)
	if characterId then
		root:SetAttribute("CharacterId", characterId)
	end

	local customer = {
		Id = nextCustomerId,
		Root = root,
		Type = customerType,
		CharacterId = characterId,
		Orders = orders,
		Slot = slot,
		Position = start,
		MoveEnd = now,
		Path = {},
		PatienceStart = nil :: number?,
		PatienceEnd = nil :: number?,
		PatienceDur = 0,
	}
	table.insert(sim.Queue, customer)
	root:AddTag(CUSTOMER_TAG)
	root.Parent = PlotService.Town.NPCFolder
	walk(customer, { lanePosition(plot, sim.Rng), slotPosition(plot, slot) }, now)
end

---------------------------------------------------------------------------------------
-- Queue handling
---------------------------------------------------------------------------------------

local function sendAway(sim, customer, mood: string, now: number)
	customer.Root:SetAttribute("Mood", mood)
	customer.Root:SetAttribute("PatienceDur", 0)
	walk(customer, { lanePosition(sim.Plot, sim.Rng), busStop(sim.Plot, sim.Rng) }, now)
	table.insert(sim.Leaving, customer)
end

local function removeFromQueue(sim, customer, now: number)
	local index = table.find(sim.Queue, customer)
	if not index then
		return
	end
	table.remove(sim.Queue, index)
	for position = index, #sim.Queue do
		local other = sim.Queue[position]
		other.Slot = position
		walk(other, { slotPosition(sim.Plot, position) }, now)
	end
	if sim.Head == customer then
		sim.Head = nil
		sim.Plot.Prompt.Enabled = false
	end
end

local function serveTime(sim, customer): number
	local total = 0
	for index, productId in customer.Orders do
		local seconds = Formulas.productTime(sim.Profile, productId)
		total += if index == 1 then seconds else seconds * GameConfig.MultiOrderTimeFactor
	end
	return total
end

local function orderText(customer): string
	local parts = {}
	for _, productId in customer.Orders do
		local product = Products.ById[productId]
		table.insert(parts, `{product.Emoji} {product.Name}`)
	end
	return table.concat(parts, " + ")
end

local function updateRegisterLabel(sim)
	local profile = sim.Profile
	local label = sim.Plot.RegisterLabel
	local hasStaff = profile.Upgrades.Staff > 0
	if not hasStaff and profile.Register <= 0 then
		label.Visible = false
		return
	end
	local capacity = Formulas.registerCapacity(profile)
	local full = profile.Register >= capacity
	local text = if full
		then `💰 FULL! {Format.number(profile.Register)}`
		else `💰 {Format.number(profile.Register)} / {Format.number(capacity)}`
	if label.Text ~= text then
		label.Text = text
	end
	label.Visible = true
end

local function completeServe(sim, customer, by: string, now: number)
	local profile = sim.Profile
	local player = sim.Player

	local price = 0
	for _, productId in customer.Orders do
		price += Formulas.productPrice(profile, productId)
	end
	price *= customer.Type.PayMult

	local amount, fast = 0, false
	if by == "Player" then
		local comboBonus = Formulas.comboBonus(sim.Combo)
		sim.Combo += 1
		if customer.PatienceStart and customer.PatienceDur > 0 then
			fast = (now - customer.PatienceStart) <= customer.PatienceDur * GameConfig.FastServeWindow
		end
		amount = math.floor(price * (1 + comboBonus) * (1 + (if fast then GameConfig.FastServeTip else 0)) + 0.5)
		EconomyService.addCoins(player, amount)
		EconomyService.addXp(player, customer.Type.Xp)
		if sim.Combo > profile.Stats.BestCombo then
			profile.Stats.BestCombo = sim.Combo
		end
		player:SetAttribute("Combo", sim.Combo)
		Remotes.notify(player, "Sale", {
			Amount = amount,
			Position = customer.Position,
			Combo = sim.Combo,
			Fast = fast,
			Type = customer.Type.Id,
		})
	else
		amount = math.floor(price + 0.5)
		local capacity = Formulas.registerCapacity(profile)
		profile.Register = math.min(capacity, profile.Register + amount)
		EconomyService.addXp(player, math.max(1, customer.Type.Xp // 2))
	end

	profile.Stats.Served += 1
	DataService.markDirty(player)

	removeFromQueue(sim, customer, now)
	sendAway(sim, customer, "Happy", now)
	updateRegisterLabel(sim)

	if by == "Player" then
		BusinessService.advanceTutorial(player, 1)
	end
	CustomerService.Served:Fire(player, {
		Type = customer.Type.Id,
		By = by,
		Amount = amount,
		RushPoints = customer.Type.RushPoints,
		Fast = fast,
		Combo = sim.Combo,
		CharacterId = customer.CharacterId,
	})
end

local function loseCustomer(sim, customer, now: number)
	local player = sim.Player
	sim.Profile.Stats.Lost += 1
	sim.Combo = 0
	player:SetAttribute("Combo", 0)
	DataService.markDirty(player)
	Remotes.notify(player, "Lost", { Position = customer.Position })
	removeFromQueue(sim, customer, now)
	sendAway(sim, customer, "Angry", now)
	CustomerService.Lost:Fire(player, customer.Type.Id)
end

---------------------------------------------------------------------------------------
-- Simulation tick
---------------------------------------------------------------------------------------

local function nextSpawnDelay(sim): number
	local interval = Formulas.spawnInterval(sim.Profile)
	if CustomerService.RushActive then
		interval *= RushConfig.SpawnIntervalMultiplier
	end
	local rng = sim.RushRng or sim.Rng
	local jitter = GameConfig.SpawnIntervalJitter
	return interval * (1 + rng:NextNumber(-jitter, jitter))
end

local function tickSim(sim, now: number)
	local profile = sim.Profile
	local plot = sim.Plot

	-- Finish walking legs and clean up customers who reached the street end.
	for _, customer in sim.Queue do
		if now >= customer.MoveEnd and #customer.Path > 0 then
			startLeg(customer, table.remove(customer.Path, 1), now)
		end
	end
	for index = #sim.Leaving, 1, -1 do
		local customer = sim.Leaving[index]
		if now >= customer.MoveEnd then
			if #customer.Path > 0 then
				startLeg(customer, table.remove(customer.Path, 1), now)
			else
				customer.Root:Destroy()
				table.remove(sim.Leaving, index)
			end
		end
	end

	-- Spawn.
	local capacity = Formulas.queueSize(profile)
	if CustomerService.RushActive then
		capacity += RushConfig.ExtraQueueSlots
	end
	capacity = math.min(capacity, MAX_SLOTS)
	if now >= sim.NextSpawn then
		if #sim.Queue < capacity then
			spawnCustomer(sim, now)
		end
		sim.NextSpawn = now + nextSpawnDelay(sim)
	end

	-- Patience.
	local patienceScale = Formulas.patienceMultiplier(profile)
	if CustomerService.RushActive then
		patienceScale *= RushConfig.PatienceMultiplier
	end
	for index = #sim.Queue, 1, -1 do
		local customer = sim.Queue[index]
		if not customer.PatienceEnd then
			if customer.Slot <= PATIENCE_SLOTS and isIdle(customer, now) then
				customer.PatienceDur = customer.Type.Patience * patienceScale
				customer.PatienceStart = now
				customer.PatienceEnd = now + customer.PatienceDur
				customer.Root:SetAttribute("PatienceStart", Workspace:GetServerTimeNow())
				customer.Root:SetAttribute("PatienceDur", customer.PatienceDur)
			end
		elseif now >= customer.PatienceEnd then
			loseCustomer(sim, customer, now)
		end
	end

	-- Head of the queue: enable the serve prompt and let staff work.
	local head = sim.Queue[1]
	if head and isIdle(head, now) then
		if sim.Head ~= head then
			sim.Head = head
			sim.Holding = false
			sim.HeadReadyAt = now
			sim.HeadServeTime = serveTime(sim, head)
			plot.Prompt.HoldDuration = sim.HeadServeTime
			plot.Prompt.ObjectText = orderText(head)
			plot.Prompt.Enabled = true
		end
		-- Staff step aside while the owner is holding Serve, so a fast team can never
		-- snatch a customer (and the combo / rush points) out of the player's hands.
		local staffMultiplier = Formulas.staffTimeMultiplier(profile)
		if staffMultiplier and not sim.Holding and profile.Register < Formulas.registerCapacity(profile) then
			if now >= sim.HeadReadyAt + sim.HeadServeTime * staffMultiplier then
				completeServe(sim, head, "Staff", now)
			end
		end
	elseif sim.Head then
		sim.Head = nil
		plot.Prompt.Enabled = false
	end

	-- Register: auto-collect when the owner is at the counter.
	sim.RegisterTimer += TICK
	if sim.RegisterTimer >= 0.5 then
		sim.RegisterTimer = 0
		if profile.Register > 0 then
			local character = sim.Player.Character
			local rootPart = character and character.PrimaryPart
			if rootPart and (rootPart.CFrame.Position - plot.ServePoint.CFrame.Position).Magnitude <= GameConfig.RegisterCollectRadius then
				local amount = math.floor(profile.Register)
				profile.Register = 0
				EconomyService.addCoins(sim.Player, amount)
				Remotes.notify(sim.Player, "Collect", { Amount = amount, Position = plot.ServePoint.CFrame.Position })
			end
		end
		updateRegisterLabel(sim)
	end
end

local function onPromptTriggered(plot, player: Player)
	local sim = sims[plot]
	if not sim or sim.Player ~= player then
		return
	end
	local head = sim.Head
	local now = os.clock()
	if not head or sim.Queue[1] ~= head then
		return
	end
	-- The engine enforces the hold on honest clients; this stops exploiters who fire
	-- the prompt instantly. A little slack covers network latency.
	if now - sim.HeadReadyAt < sim.HeadServeTime * 0.8 - 0.25 then
		return
	end
	local character = player.Character
	local rootPart = character and character.PrimaryPart
	if not rootPart or (rootPart.CFrame.Position - plot.ServePoint.CFrame.Position).Magnitude > plot.Prompt.MaxActivationDistance + 8 then
		return
	end
	completeServe(sim, head, "Player", now)
end

---------------------------------------------------------------------------------------
-- Lifecycle
---------------------------------------------------------------------------------------

local function createSim(plot, player: Player, profile)
	local sim = {
		Plot = plot,
		Player = player,
		Profile = profile,
		Queue = {},
		Leaving = {},
		NextSpawn = os.clock() + 2,
		Combo = 0,
		Head = nil,
		HeadReadyAt = 0,
		HeadServeTime = 0,
		Holding = false,
		RegisterTimer = 0,
		Rng = Random.new(),
		RushRng = if CustomerService.RushActive then Random.new(CustomerService.RushSeed) else nil,
	}
	sims[plot] = sim
	player:SetAttribute("Combo", 0)
	updateRegisterLabel(sim)
end

local function destroySim(plot)
	local sim = sims[plot]
	if not sim then
		return
	end
	sims[plot] = nil
	for _, customer in sim.Queue do
		customer.Root:Destroy()
	end
	for _, customer in sim.Leaving do
		customer.Root:Destroy()
	end
	plot.Prompt.Enabled = false
end

-- Called by RushService. Every plot gets the same random seed, so every player
-- faces the same sequence of customer types during a rush.
function CustomerService.setRush(active: boolean, seed: number?)
	CustomerService.RushActive = active
	CustomerService.RushSeed = seed or 0
	local now = os.clock()
	for _, sim in sims do
		sim.RushRng = if active then Random.new(CustomerService.RushSeed) else nil
		if active then
			sim.NextSpawn = now + 0.5
		end
	end
end

function CustomerService.getCombo(player: Player): number
	local plot = PlotService.getPlot(player)
	local sim = plot and sims[plot]
	return if sim then sim.Combo else 0
end

function CustomerService.Init() end

function CustomerService.Start()
	for _, plot in PlotService.Plots do
		plot.Prompt.Triggered:Connect(function(player)
			onPromptTriggered(plot, player)
		end)
		plot.Prompt.PromptButtonHoldBegan:Connect(function(player)
			local sim = sims[plot]
			if sim and sim.Player == player then
				sim.Holding = true
			end
		end)
		plot.Prompt.PromptButtonHoldEnded:Connect(function(player)
			local sim = sims[plot]
			if sim and sim.Player == player then
				sim.Holding = false
			end
		end)
		if plot.Owner and DataService.get(plot.Owner) then
			createSim(plot, plot.Owner, DataService.get(plot.Owner))
		end
	end
	PlotService.Claimed:Connect(createSim)
	PlotService.Released:Connect(destroySim)

	task.spawn(function()
		while true do
			task.wait(TICK)
			local now = os.clock()
			for plot, sim in sims do
				local ok, err = pcall(tickSim, sim, now)
				if not ok then
					warn(`[CustomerService] Plot {plot.Index} tick failed: {err}`)
				end
			end
		end
	end)
end

return CustomerService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[-- Player data: loading, saving, session locking and replication to the owner.
--
-- Safety rules implemented here:
--   * A profile is only ever created by a successful DataStore read. If loading fails
--     the player is kicked and NOTHING is written, so a temporary outage can never
--     overwrite a good save with defaults.
--   * Each save carries a session lock (JobId). A server only writes if it still owns
--     the lock, which prevents two servers from duplicating or clobbering progress.
--   * Saves happen on leave, on shutdown (BindToClose) and every AutosaveInterval.
--   * Data is versioned; see MIGRATIONS for upgrading old saves.
--
-- In Studio, if "Enable Studio Access to API Services" is off, an in-memory store is
-- used so the game is still fully playable (nothing is saved between test sessions).

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Businesses = require(Shared.Config.Businesses)
local Characters = require(Shared.Config.Characters)
local Cosmetics = require(Shared.Config.Cosmetics)
local Formulas = require(Shared.Modules.Formulas)
local Signal = require(Shared.Modules.Signal)
local Remotes = require(script.Parent.Remotes)

local DataService = {
	Loaded = Signal.new(), -- (player, profile) profile is ready
	Releasing = Signal.new(), -- (player, profile) about to be saved and dropped
	Changed = Signal.new(), -- (player, profile) coalesced "something changed"
}

local profiles: { [Player]: any } = {}
local dirty: { [Player]: boolean } = {}
local releasing: { [Player]: boolean } = {}
local savingUsers: { [number]: boolean } = {} -- userIds whose final save is in flight
local store: any = nil
local usingMock = false
local shuttingDown = false

local function defaultProfile()
	return {
		Version = GameConfig.DataVersion,
		Coins = GameConfig.StartingCoins,
		TotalEarned = 0,
		Level = 1,
		XP = 0,
		BusinessTier = 1,
		Upgrades = { Speed = 0, Quality = 0, Capacity = 0, Staff = 0, Storage = 0, Appearance = 0 },
		Products = { Lemonade = 1 }, -- productId -> level
		Characters = { Brix = true }, -- characterId -> owned
		Equipped = { "Brix" }, -- ordered team
		Befriend = {}, -- characterId -> visits served
		Cosmetics = { [Cosmetics.Default] = true },
		EquippedCosmetic = Cosmetics.Default,
		Register = 0, -- coins waiting in the cash register (staff sales)
		Stats = {
			Served = 0,
			Lost = 0,
			BestCombo = 0,
			RushPoints = 0,
			RushWins = 0,
			RushesPlayed = 0,
			PlayTime = 0,
		},
		Daily = { LastDay = 0, Streak = 0 },
		Quests = { Day = 0, List = {} },
		Tutorial = 1, -- current tutorial step; 0 = finished
		Settings = { Sfx = true, Music = true },
	}
end

-- MIGRATIONS[n] upgrades a save from version n to n + 1.
local MIGRATIONS: { [number]: (data: any) -> () } = {
	-- [1] = function(data) data.NewField = 0 end,
}

local function deepCopy(value: any): any
	if typeof(value) ~= "table" then
		return value
	end
	local copy = {}
	for key, item in value do
		copy[key] = deepCopy(item)
	end
	return copy
end

-- Fills in any fields that are missing from an older save.
local function reconcile(data: any, template: any)
	for key, default in template do
		if data[key] == nil then
			data[key] = deepCopy(default)
		elseif typeof(default) == "table" and typeof(data[key]) == "table" then
			local firstKey = next(default)
			if typeof(firstKey) == "string" then
				reconcile(data[key], default)
			end
		end
	end
end

local function cleanNumber(value: any, fallback: number, minimum: number): number
	if typeof(value) ~= "number" or value ~= value or value == math.huge then
		return fallback
	end
	return math.max(minimum, value)
end

local function sanitize(data: any)
	data.Coins = cleanNumber(data.Coins, 0, 0)
	data.TotalEarned = cleanNumber(data.TotalEarned, 0, 0)
	data.Register = cleanNumber(data.Register, 0, 0)
	data.Level = math.floor(cleanNumber(data.Level, 1, 1))
	data.XP = cleanNumber(data.XP, 0, 0)
	data.BusinessTier = math.clamp(math.floor(cleanNumber(data.BusinessTier, 1, 1)), 1, #Businesses)

	local team = {}
	for _, characterId in data.Equipped do
		if Characters.ById[characterId] and data.Characters[characterId] and not table.find(team, characterId) then
			table.insert(team, characterId)
		end
	end
	while #team > Formulas.teamSlots(data) do
		table.remove(team)
	end
	data.Equipped = team

	if not Cosmetics.ById[data.EquippedCosmetic] or not data.Cosmetics[data.EquippedCosmetic] then
		data.EquippedCosmetic = Cosmetics.Default
	end
end

local function prepare(data: any)
	while data.Version < GameConfig.DataVersion do
		local migrate = MIGRATIONS[data.Version]
		if migrate then
			migrate(data)
		end
		data.Version += 1
	end
	reconcile(data, defaultProfile())
	sanitize(data)
end

---------------------------------------------------------------------------------------
-- Store access
---------------------------------------------------------------------------------------

-- In-memory stand-in with the same UpdateAsync contract. Studio only.
local function newMockStore()
	local contents = {}
	local mock = {}
	function mock:UpdateAsync(key: string, transform: (any) -> any)
		local result = transform(deepCopy(contents[key]))
		if result ~= nil then
			contents[key] = deepCopy(result)
		end
		return deepCopy(contents[key])
	end
	return mock
end

local function getStore()
	if store then
		return store
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(GameConfig.DataStoreName)
	end)
	if ok then
		store = result
	elseif RunService:IsStudio() then
		warn("[DataService] DataStores unavailable in Studio - using temporary in-memory data.")
		store = newMockStore()
		usingMock = true
	else
		error(result)
	end
	return store
end

local function keyFor(userId: number): string
	return "Player_" .. userId
end

-- Returns the loaded data, or nil plus a reason shown to the player.
local function loadAsync(player: Player): (any?, string?)
	local key = keyFor(player.UserId)
	local lastReason = "Your data could not be loaded. Please rejoin."

	for attempt = 1, 6 do
		if player.Parent == nil then
			return nil, "left"
		end
		local lockedElsewhere = false
		local ok, result = pcall(function()
			return getStore():UpdateAsync(key, function(old)
				local now = os.time()
				if
					old
					and old.Session
					and old.Session.JobId ~= game.JobId
					and now - (old.Session.Time or 0) < GameConfig.SessionLockTimeout
				then
					lockedElsewhere = true
					return nil -- cancel: another server still owns this save
				end
				lockedElsewhere = false
				local data = old or defaultProfile()
				data.Session = { JobId = game.JobId, Time = now }
				return data
			end)
		end)

		if ok and not lockedElsewhere and typeof(result) == "table" then
			return result, nil
		end

		if not ok and RunService:IsStudio() and not usingMock then
			-- Most likely "Enable Studio Access to API Services" is off. The mock never
			-- touches real saves, so falling back is always safe.
			warn(`[DataService] DataStore error in Studio ({result}) - using temporary in-memory data.`)
			store = newMockStore()
			usingMock = true
		elseif lockedElsewhere then
			lastReason = "Your data is still saving in another server. Please rejoin in a minute."
			task.wait(5)
		else
			if not ok then
				warn(`[DataService] Load attempt {attempt} failed for {player.Name}: {result}`)
			end
			task.wait(math.min(2 ^ attempt, 10))
		end
	end
	return nil, lastReason
end

-- Writes the profile. `release` clears the session lock (player is leaving).
local function saveAsync(userId: number, profile: any, release: boolean): boolean
	local key = keyFor(userId)
	for attempt = 1, 4 do
		local lostLock = false
		local ok, err = pcall(function()
			getStore():UpdateAsync(key, function(old)
				if not old or not old.Session or old.Session.JobId ~= game.JobId then
					lostLock = true
					return nil -- never overwrite a save this server no longer owns
				end
				local data = deepCopy(profile)
				if release then
					data.Session = nil
				else
					data.Session = { JobId = game.JobId, Time = os.time() }
				end
				return data
			end)
		end)
		if ok then
			if lostLock then
				warn(`[DataService] Lost session lock for {userId}; save skipped.`)
				return false
			end
			return true
		end
		warn(`[DataService] Save attempt {attempt} failed for {userId}: {err}`)
		if attempt < 4 then
			task.wait(2 * attempt)
		end
	end
	return false
end

-- Clears this server's session lock without changing anything else in the save.
local function unlockAsync(userId: number)
	pcall(function()
		getStore():UpdateAsync(keyFor(userId), function(old)
			if not old or not old.Session or old.Session.JobId ~= game.JobId then
				return nil
			end
			old.Session = nil
			return old
		end)
	end)
end

---------------------------------------------------------------------------------------
-- Public API
---------------------------------------------------------------------------------------

function DataService.get(player: Player): any?
	return profiles[player]
end

-- Call after changing a profile. The owner's client and listeners of
-- DataService.Changed are updated on the next flush (a few times per second).
function DataService.markDirty(player: Player)
	if profiles[player] then
		dirty[player] = true
	end
end

function DataService.all(): { [Player]: any }
	return profiles
end

local function onPlayerAdded(player: Player)
	if profiles[player] or shuttingDown then
		return
	end
	-- A quick rejoin to this same server must wait for the previous session's final
	-- save, otherwise it could load stale data.
	local waitUntil = os.clock() + 30
	while savingUsers[player.UserId] and os.clock() < waitUntil do
		task.wait(0.2)
	end
	if savingUsers[player.UserId] then
		player:Kick("Your data is still saving. Please rejoin in a moment.")
		return
	end
	if player.Parent == nil then
		return
	end

	local joinedAt = os.time()
	local data, reason = loadAsync(player)

	if not data then
		if reason ~= "left" then
			player:Kick(reason)
		end
		return
	end

	local ok, err = pcall(prepare, data)
	if not ok then
		-- Corrupt or unexpected data: leave the stored value alone, hand back only the
		-- session lock, and ask the player to rejoin.
		warn(`[DataService] Could not prepare data for {player.Name}: {err}`)
		unlockAsync(player.UserId)
		player:Kick("Your data could not be read. Please rejoin; if this keeps happening contact the developer.")
		return
	end

	if player.Parent == nil then
		-- Left while loading: hand the lock back without changing anything else.
		unlockAsync(player.UserId)
		return
	end

	profiles[player] = data
	player:SetAttribute("JoinedAt", joinedAt)
	player:SetAttribute("DataLoaded", true)
	DataService.Loaded:Fire(player, data)
	DataService.markDirty(player)
end

local function release(player: Player)
	local profile = profiles[player]
	if not profile or releasing[player] then
		return
	end
	releasing[player] = true
	local joinedAt = player:GetAttribute("JoinedAt")
	if typeof(joinedAt) == "number" then
		profile.Stats.PlayTime += math.max(0, os.time() - joinedAt)
	end
	local userId = player.UserId
	savingUsers[userId] = true
	DataService.Releasing:Fire(player, profile)
	saveAsync(userId, profile, true)
	profiles[player] = nil
	dirty[player] = nil
	releasing[player] = nil
	savingUsers[userId] = nil
end

function DataService.Init() end

function DataService.Start()
	Remotes.register("GetState", function(player)
		local profile = profiles[player]
		if not profile then
			return false, "Loading"
		end
		Remotes.Events.StateUpdate:FireClient(player, profile)
		return true
	end)

	Remotes.register("SetSetting", function(player, key: any, value: any)
		local profile = profiles[player]
		if not profile or typeof(key) ~= "string" or typeof(value) ~= "boolean" then
			return false, "Bad request"
		end
		if typeof(profile.Settings[key]) ~= "boolean" then
			return false, "Unknown setting"
		end
		profile.Settings[key] = value
		DataService.markDirty(player)
		return true
	end)

	Players.PlayerRemoving:Connect(release)

	-- Replicate coalesced changes.
	task.spawn(function()
		while true do
			task.wait(0.15)
			for player in dirty do
				dirty[player] = nil
				local profile = profiles[player]
				if profile and player.Parent then
					Remotes.Events.StateUpdate:FireClient(player, profile)
					DataService.Changed:Fire(player, profile)
				end
			end
		end
	end)

	-- Autosave, staggered so saves do not all land on the same frame.
	task.spawn(function()
		while true do
			task.wait(GameConfig.AutosaveInterval)
			for player, profile in profiles do
				if not releasing[player] and player.Parent then
					task.spawn(saveAsync, player.UserId, profile, false)
					task.wait(0.5)
				end
			end
		end
	end)

	game:BindToClose(function()
		shuttingDown = true
		for player in profiles do
			task.spawn(release, player)
		end
		-- Wait on the real state: a save started by PlayerRemoving just before
		-- shutdown is still in flight even though release() returns early for it.
		local deadline = os.clock() + 25
		while (next(profiles) ~= nil or next(savingUsers) ~= nil) and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

-- Called by Main after every service has started, so that all listeners of
-- DataService.Loaded exist before the first profile arrives.
function DataService.Begin()
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[-- The only place coins and XP are ever granted or spent.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Formulas = require(Shared.Modules.Formulas)
local Signal = require(Shared.Modules.Signal)
local DataService = require(script.Parent.DataService)
local Remotes = require(script.Parent.Remotes)

local EconomyService = {
	LeveledUp = Signal.new(), -- (player, newLevel)
}

-- Adds coins that count as earnings (sales, rewards).
function EconomyService.addCoins(player: Player, amount: number): boolean
	local profile = DataService.get(player)
	if not profile or amount ~= amount or amount <= 0 then
		return false
	end
	amount = math.floor(amount)
	profile.Coins += amount
	profile.TotalEarned += amount
	DataService.markDirty(player)
	return true
end

-- Spends coins if the player can afford it. Returns false (and changes nothing) if not.
function EconomyService.trySpend(player: Player, amount: number): boolean
	local profile = DataService.get(player)
	if not profile or amount ~= amount or amount < 0 then
		return false
	end
	if profile.Coins < amount then
		return false
	end
	profile.Coins -= amount
	DataService.markDirty(player)
	return true
end

function EconomyService.addXp(player: Player, amount: number)
	local profile = DataService.get(player)
	if not profile or amount <= 0 then
		return
	end
	profile.XP += amount * (1 + Formulas.bonuses(profile).Xp)
	local leveled = false
	while profile.XP >= Formulas.xpForLevel(profile.Level) do
		profile.XP -= Formulas.xpForLevel(profile.Level)
		profile.Level += 1
		leveled = true
		local reward = Formulas.serveWorth(profile) * GameConfig.LevelUpRewardServes
		EconomyService.addCoins(player, reward)
		Remotes.notify(player, "LevelUp", { Level = profile.Level, Reward = reward })
	end
	if leveled then
		EconomyService.LeveledUp:Fire(player, profile.Level)
	end
	DataService.markDirty(player)
end

function EconomyService.Init() end
function EconomyService.Start() end

return EconomyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[-- Server leaderboard (the built-in Roblox player list, via "leaderstats") and the
-- global all-time "Top Tycoons" board in the plaza (OrderedDataStore).

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Format = require(Shared.Modules.Format)
local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)

local LeaderboardService = {}

local nameCache: { [number]: string } = {}
local orderedStore: any = nil

local function setupLeaderstats(player: Player, profile)
	local folder = player:FindFirstChild("leaderstats")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "leaderstats"
		local coins = Instance.new("IntValue")
		coins.Name = "Coins"
		coins.Parent = folder
		local level = Instance.new("IntValue")
		level.Name = "Level"
		level.Parent = folder
		folder.Parent = player
	end
	folder.Coins.Value = math.floor(profile.Coins)
	folder.Level.Value = profile.Level
end

local function nameFor(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local player = Players:GetPlayerByUserId(userId)
	if player then
		nameCache[userId] = player.DisplayName
		return player.DisplayName
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	nameCache[userId] = if ok then name else "Player"
	return nameCache[userId]
end

local function localRanking(): { any }
	local entries = {}
	for player, profile in DataService.all() do
		table.insert(entries, { Name = player.DisplayName, Value = profile.TotalEarned })
	end
	table.sort(entries, function(a, b)
		return a.Value > b.Value
	end)
	return entries
end

local function refreshGlobalBoard()
	local label = PlotService.Town.Labels.GlobalLeaderboard
	local entries = nil

	local ok = pcall(function()
		orderedStore = orderedStore or DataStoreService:GetOrderedDataStore(GameConfig.LeaderboardStoreName)
		for player, profile in DataService.all() do
			-- Negative user ids are Studio test players; do not publish them.
			if player.UserId > 0 then
				orderedStore:SetAsync(tostring(player.UserId), math.floor(profile.TotalEarned))
			end
		end
		local pages = orderedStore:GetSortedAsync(false, GameConfig.GlobalLeaderboardSize)
		entries = {}
		for _, item in pages:GetCurrentPage() do
			local userId = tonumber(item.key)
			if userId then
				table.insert(entries, { Name = nameFor(userId), Value = item.value })
			end
		end
	end)

	local title = "All-time earnings"
	if not ok or not entries then
		-- DataStores unavailable (e.g. Studio without API access): show this server.
		entries = localRanking()
		title = "This server"
	end

	local lines = { `<b>{title}</b>` }
	for index, entry in entries do
		if index > GameConfig.GlobalLeaderboardSize then
			break
		end
		table.insert(lines, `{index}. {entry.Name}  -  {Format.number(entry.Value)}`)
	end
	if #lines == 1 then
		table.insert(lines, "Be the first tycoon!")
	end
	label.Text = table.concat(lines, "\n")
end

function LeaderboardService.Init() end

function LeaderboardService.Start()
	DataService.Loaded:Connect(setupLeaderstats)
	DataService.Changed:Connect(setupLeaderstats)
	for player, profile in DataService.all() do
		setupLeaderstats(player, profile)
	end

	task.spawn(function()
		task.wait(8)
		while true do
			refreshGlobalBoard()
			task.wait(GameConfig.GlobalLeaderboardRefresh)
		end
	end)
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">PlotService</string>
            <string name="Source"><![CDATA[-- Builds the town, owns the eight business plots and assigns one to each player.
--
-- A plot is a Model in Workspace.ShopPlots with:
--   Pad            the floor
--   ServePoint     invisible part at the counter holding the "Serve" ProximityPrompt
--   RegisterPoint  invisible part holding the register billboard
--   Stand          folder of visuals, rebuilt whenever the owner's shop changes
-- Attributes: OwnerUserId (0 = vacant), OwnerName.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Make = require(Shared.Modules.Make)
local Signal = require(Shared.Modules.Signal)
local Theme = require(Shared.Config.Theme)
local DataService = require(script.Parent.DataService)
local Remotes = require(script.Parent.Remotes)
local World = script.Parent.Parent.World
local TownBuilder = require(World.TownBuilder)
local StandBuilder = require(World.StandBuilder)
local Build = require(World.Build)

local PlotService = {
	Plots = {},
	Town = nil :: any,
	Claimed = Signal.new(), -- (plot, player, profile)
	Released = Signal.new(), -- (plot, player)
}

local byPlayer: { [Player]: any } = {}
local refreshQueued: { [Player]: boolean } = {}
local lastRefresh: { [Player]: number } = {}
local REFRESH_COOLDOWN = 1 -- seconds between rebuilds of one shop (rebuilds replicate to everyone)

local function createPlot(index: number, cframe: CFrame, size: number, parent: Instance)
	local model = Make("Model", { Name = "Plot" .. index })
	model:SetAttribute("OwnerUserId", 0)
	model:SetAttribute("OwnerName", "")
	model:SetAttribute("PlotIndex", index)

	local pad = Build.part({
		Name = "Pad",
		Size = Vector3.new(size, 0.4, size),
		CFrame = cframe * CFrame.new(0, -0.19, 0),
		Color = Color3.fromRGB(246, 238, 222),
		Parent = model,
	})
	model.PrimaryPart = pad

	local servePoint = Build.part({
		Name = "ServePoint",
		Size = Vector3.new(1, 1, 1),
		CFrame = cframe * CFrame.new(0, StandBuilder.CounterHeight + 0.5, StandBuilder.CounterZ),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Parent = model,
	})
	local prompt = Make("ProximityPrompt", {
		Name = "ServePrompt",
		ActionText = "Serve",
		ObjectText = "Customer",
		HoldDuration = 2,
		MaxActivationDistance = 11,
		RequiresLineOfSight = false,
		Enabled = false,
		Parent = servePoint,
	})

	local registerPoint = Build.part({
		Name = "RegisterPoint",
		Size = Vector3.new(1, 1, 1),
		CFrame = cframe * CFrame.new(4.4, StandBuilder.CounterHeight + 1.2, StandBuilder.CounterZ),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Parent = model,
	})
	local registerLabel = Build.billboard(registerPoint, "", Vector3.new(0, 1.6, 0), UDim2.fromScale(6, 1.2), { TextColor3 = Theme.Yellow })
	registerLabel.Visible = false

	local stand = StandBuilder.buildVacant(cframe)
	stand.Parent = model
	model.Parent = parent

	return {
		Index = index,
		CFrame = cframe,
		Model = model,
		ServePoint = servePoint,
		Prompt = prompt,
		RegisterLabel = registerLabel,
		Stand = stand,
		Owner = nil :: Player?,
	}
end

function PlotService.getPlot(player: Player)
	return byPlayer[player]
end

-- Rebuilds the visible shop. Safe to call many times; rebuilds are coalesced.
function PlotService.refresh(player: Player)
	if refreshQueued[player] or not byPlayer[player] then
		return
	end
	refreshQueued[player] = true
	local wait = math.max(0, REFRESH_COOLDOWN - (os.clock() - (lastRefresh[player] or 0)))
	task.delay(wait, function()
		refreshQueued[player] = nil
		lastRefresh[player] = os.clock()
		local plot = byPlayer[player]
		local profile = DataService.get(player)
		if not plot or not profile then
			return
		end
		local old = plot.Stand
		local stand = StandBuilder.build(plot.CFrame, player.DisplayName, profile)
		stand.Parent = plot.Model
		plot.Stand = stand
		if old then
			old:Destroy()
		end
	end)
end

-- Where the owner stands to serve: just behind the counter, facing the street.
function PlotService.homeCFrame(plot): CFrame
	return plot.CFrame * CFrame.new(0, 3.5, 0.5)
end

local function claim(player: Player, profile)
	for _, plot in PlotService.Plots do
		if not plot.Owner then
			plot.Owner = player
			byPlayer[player] = plot
			plot.Model:SetAttribute("OwnerUserId", player.UserId)
			plot.Model:SetAttribute("OwnerName", player.DisplayName)
			player:SetAttribute("PlotIndex", plot.Index)
			PlotService.refresh(player)
			PlotService.Claimed:Fire(plot, player, profile)
			return
		end
	end
	Remotes.notify(player, "Toast", { Text = "All shop plots are taken in this server.", Kind = "Error" })
end

local function releasePlot(player: Player)
	local plot = byPlayer[player]
	if not plot then
		return
	end
	byPlayer[player] = nil
	refreshQueued[player] = nil
	lastRefresh[player] = nil
	plot.Owner = nil
	plot.Model:SetAttribute("OwnerUserId", 0)
	plot.Model:SetAttribute("OwnerName", "")
	PlotService.Released:Fire(plot, player)
	if plot.Stand then
		plot.Stand:Destroy()
	end
	plot.Stand = StandBuilder.buildVacant(plot.CFrame)
	plot.Stand.Parent = plot.Model
	plot.Prompt.Enabled = false
	plot.RegisterLabel.Visible = false
end

function PlotService.Init()
	local town = TownBuilder.build()
	PlotService.Town = town
	for index, cframe in town.PlotCFrames do
		PlotService.Plots[index] = createPlot(index, cframe, town.PlotSize, town.PlotsFolder)
	end
end

function PlotService.Start()
	DataService.Loaded:Connect(claim)
	for player, profile in DataService.all() do
		if not byPlayer[player] then
			claim(player, profile)
		end
	end
	DataService.Releasing:Connect(releasePlot)
	Players.PlayerRemoving:Connect(function(player)
		-- Covers players who leave before their data finished loading.
		task.defer(releasePlot, player)
	end)

	Remotes.register("TeleportHome", function(player)
		local plot = byPlayer[player]
		local character = player.Character
		if not plot or not character then
			return false, "No shop yet"
		end
		character:PivotTo(PlotService.homeCFrame(plot))
		return true
	end)
end

return PlotService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">QuestService</string>
            <string name="Source"><![CDATA[-- Daily objectives and the daily login reward.
-- Both reset on the UTC day boundary. Quest picks are deterministic per player per
-- day, so rejoining never rerolls them.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Quests = require(Shared.Config.Quests)
local Formulas = require(Shared.Modules.Formulas)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local BusinessService = require(script.Parent.BusinessService)
local CustomerService = require(script.Parent.CustomerService)
local RushService = require(script.Parent.RushService)
local Remotes = require(script.Parent.Remotes)

local QuestService = {}

local defsById = {}
for _, def in Quests.Pool do
	defsById[def.Id] = def
end

local function today(): number
	return Formulas.dayNumber(os.time())
end

local function ensureQuests(player: Player)
	local profile = DataService.get(player)
	if not profile then
		return
	end
	local day = today()
	if profile.Quests.Day == day and #profile.Quests.List > 0 then
		return
	end
	local rng = Random.new(player.UserId % 1000000 + day * 7)
	local pool = table.clone(Quests.Pool)
	local list = {}
	for _ = 1, math.min(Quests.PerDay, #pool) do
		local def = table.remove(pool, rng:NextInteger(1, #pool))
		table.insert(list, {
			Id = def.Id,
			Goal = def.Goals[rng:NextInteger(1, #def.Goals)],
			Progress = 0,
			Claimed = false,
		})
	end
	profile.Quests = { Day = day, List = list }
	DataService.markDirty(player)
end

-- Adds progress to today's quests listening for `event`.
-- absolute = true means "progress is at least this value" (used for combos).
function QuestService.progress(player: Player, event: string, amount: number, absolute: boolean?)
	local profile = DataService.get(player)
	if not profile or profile.Quests.Day ~= today() then
		return
	end
	for _, quest in profile.Quests.List do
		local def = defsById[quest.Id]
		if def and def.Event == event and quest.Progress < quest.Goal then
			if absolute then
				quest.Progress = math.min(quest.Goal, math.max(quest.Progress, amount))
			else
				quest.Progress = math.min(quest.Goal, quest.Progress + amount)
			end
			if quest.Progress >= quest.Goal then
				Remotes.notify(player, "Toast", { Text = "📜 Daily quest complete! Claim your reward.", Kind = "Reward" })
			end
			DataService.markDirty(player)
		end
	end
end

local function claimQuest(player: Player, index: any)
	local profile = DataService.get(player)
	if not profile or typeof(index) ~= "number" then
		return false, "Bad request"
	end
	ensureQuests(player)
	local quest = profile.Quests.List[index]
	local def = quest and defsById[quest.Id]
	if not quest or not def then
		return false, "Unknown quest"
	end
	if quest.Claimed then
		return false, "Already claimed"
	end
	if quest.Progress < quest.Goal then
		return false, "Not finished yet"
	end
	quest.Claimed = true
	local coins = def.RewardServes * Formulas.serveWorth(profile)
	EconomyService.addCoins(player, coins)
	EconomyService.addXp(player, def.Xp)
	DataService.markDirty(player)
	Remotes.notify(player, "Reward", { Title = "Quest Complete!", Coins = coins })
	return true
end

local function claimDaily(player: Player)
	local profile = DataService.get(player)
	if not profile then
		return false, "Loading"
	end
	local day = today()
	local daily = profile.Daily
	if daily.LastDay >= day then
		return false, "Come back tomorrow!"
	end
	daily.Streak = if daily.LastDay == day - 1 then daily.Streak + 1 else 1
	daily.LastDay = day
	local track = Quests.DailyRewardServes
	local serves = track[(daily.Streak - 1) % #track + 1]
	local coins = math.max(Quests.DailyMinimumCoins, serves * Formulas.serveWorth(profile))
	EconomyService.addCoins(player, coins)
	DataService.markDirty(player)
	Remotes.notify(player, "Reward", { Title = `Daily Reward - Day {daily.Streak}`, Coins = coins })
	return true
end

function QuestService.Init() end

function QuestService.Start()
	DataService.Loaded:Connect(ensureQuests)
	for player in DataService.all() do
		ensureQuests(player)
	end

	CustomerService.Served:Connect(function(player, info)
		if info.By ~= "Player" then
			return
		end
		QuestService.progress(player, "Served", 1)
		if info.Type == "Rich" or info.Type == "VIP" then
			QuestService.progress(player, "ServedSpecial", 1)
		elseif info.Type == "Hungry" then
			QuestService.progress(player, "ServedHungry", 1)
		end
		if info.Fast then
			QuestService.progress(player, "FastServe", 1)
		end
		QuestService.progress(player, "Combo", info.Combo, true)
	end)
	RushService.Scored:Connect(function(player, points)
		QuestService.progress(player, "RushPoints", points)
	end)
	BusinessService.Purchased:Connect(function(player, kind)
		if kind == "Upgrade" or kind == "ProductLevel" then
			QuestService.progress(player, "Upgrade", 1)
		end
	end)

	Remotes.register("ClaimQuest", claimQuest)
	Remotes.register("ClaimDaily", claimDaily)

	-- Roll quests over at midnight UTC for players who stay online.
	task.spawn(function()
		while true do
			task.wait(60)
			for player in DataService.all() do
				ensureQuests(player)
			end
		end
	end)
end

return QuestService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Remotes</string>
            <string name="Source"><![CDATA[-- Creates every RemoteEvent / RemoteFunction and owns the single client -> server
-- entry point ("Action"). Services register named handlers:
--
--   Remotes.register("BuyUpgrade", function(player, upgradeId) ... return true, "Bought!" end)
--
-- Every call is rate limited and wrapped in pcall, and handlers must validate their
-- own arguments - nothing a client sends is trusted.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Modules.Net)

local Remotes = {
	Events = {} :: { [string]: RemoteEvent },
	Functions = {} :: { [string]: RemoteFunction },
}

local handlers: { [string]: (player: Player, ...any) -> (boolean, string?) } = {}
local lastCall: { [Player]: { [string]: number } } = {}
local callBudget: { [Player]: { count: number, windowStart: number } } = {}

local MIN_INTERVAL = 0.12 -- seconds between two calls of the same action
local MAX_CALLS_PER_WINDOW = 40 -- total calls allowed per WINDOW seconds
local WINDOW = 5

function Remotes.register(name: string, handler)
	assert(handlers[name] == nil, "Action registered twice: " .. name)
	handlers[name] = handler
end

function Remotes.notify(player: Player, kind: string, data: any?)
	Remotes.Events.Notify:FireClient(player, kind, data)
end

function Remotes.notifyAll(kind: string, data: any?)
	Remotes.Events.Notify:FireAllClients(kind, data)
end

local function allowed(player: Player, name: string): boolean
	local now = os.clock()

	local budget = callBudget[player]
	if not budget or now - budget.windowStart > WINDOW then
		budget = { count = 0, windowStart = now }
		callBudget[player] = budget
	end
	budget.count += 1
	if budget.count > MAX_CALLS_PER_WINDOW then
		return false
	end

	local calls = lastCall[player]
	if not calls then
		calls = {}
		lastCall[player] = calls
	end
	if calls[name] and now - calls[name] < MIN_INTERVAL then
		return false
	end
	calls[name] = now
	return true
end

function Remotes.Init()
	local folder = Instance.new("Folder")
	folder.Name = Net.FolderName
	for _, name in Net.Events do
		local remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = folder
		Remotes.Events[name] = remote
	end
	for _, name in Net.Functions do
		local remote = Instance.new("RemoteFunction")
		remote.Name = name
		remote.Parent = folder
		Remotes.Functions[name] = remote
	end
	folder.Parent = ReplicatedStorage

	Remotes.Functions.Action.OnServerInvoke = function(player: Player, name: any, ...: any)
		if typeof(name) ~= "string" then
			return false, "Bad request"
		end
		local handler = handlers[name]
		if not handler then
			return false, "Unknown action"
		end
		if not allowed(player, name) then
			return false, "Slow down!"
		end
		local ok, success, message = pcall(handler, player, ...)
		if not ok then
			warn(`[Remotes] Action {name} failed for {player.Name}: {success}`)
			return false, "Something went wrong"
		end
		return success == true, if typeof(message) == "string" then message else nil
	end

	Players.PlayerRemoving:Connect(function(player)
		lastCall[player] = nil
		callBudget[player] = nil
	end)
end

function Remotes.Start() end

return Remotes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">RushService</string>
            <string name="Source"><![CDATA[-- CUSTOMER RUSH: the signature server-wide event.
--
-- Every few minutes customers flood Business Street for ~75 seconds. Every shop gets
-- the same sequence of customer types (same random seed), so the contest is about
-- how well you serve, not luck. Only serves done by the player score - staff do not.
-- Prizes are paid exactly once, from one code path, when the rush ends.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local RushConfig = require(Shared.Config.Rush)
local Formulas = require(Shared.Modules.Formulas)
local Format = require(Shared.Modules.Format)
local Signal = require(Shared.Modules.Signal)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local PlotService = require(script.Parent.PlotService)
local BusinessService = require(script.Parent.BusinessService)
local CustomerService = require(script.Parent.CustomerService)
local Remotes = require(script.Parent.Remotes)

local RushService = {
	Scored = Signal.new(), -- (player, points)
	Finished = Signal.new(), -- (results) results = { { Player, Name, Points, Rank, Coins } }
}

local state = {
	Phase = "Idle", -- "Idle" | "Countdown" | "Active"
	RushId = 0,
	NextAt = 0, -- server time the next countdown starts
	EndsAt = 0, -- server time the current phase ends
	Scores = {} :: { [Player]: number },
	LastResults = {} :: { any },
}
local scoresDirty = false
local forceStart = false

local function serverNow(): number
	return Workspace:GetServerTimeNow()
end

local function ranking(): { any }
	local list = {}
	for player, points in state.Scores do
		if player.Parent and points > 0 then
			table.insert(list, { Player = player, Name = player.DisplayName, UserId = player.UserId, Points = points })
		end
	end
	table.sort(list, function(a, b)
		if a.Points == b.Points then
			return a.UserId < b.UserId
		end
		return a.Points > b.Points
	end)
	return list
end

local function snapshot()
	local scores = {}
	for index, entry in ranking() do
		scores[index] = { Name = entry.Name, UserId = entry.UserId, Points = entry.Points }
	end
	local results = {}
	for index, entry in state.LastResults do
		results[index] = { Name = entry.Name, UserId = entry.UserId, Points = entry.Points, Rank = entry.Rank, Coins = entry.Coins }
	end
	return {
		Phase = state.Phase,
		RushId = state.RushId,
		NextAt = state.NextAt,
		EndsAt = state.EndsAt,
		Scores = scores,
		Results = results,
	}
end

local function broadcast()
	scoresDirty = false
	Remotes.Events.RushUpdate:FireAllClients(snapshot())
end

local function updateBoards()
	local labels = PlotService.Town.Labels
	local now = serverNow()

	if state.Phase == "Active" then
		labels.EventBoard.Text = `<b>CUSTOMER RUSH!</b>\n{Format.clock(state.EndsAt - now)} left\nServe as many as you can!`
	elseif state.Phase == "Countdown" then
		labels.EventBoard.Text = `<b>CUSTOMER RUSH STARTING!</b>\nGet to your shop!\n{math.max(0, math.ceil(state.EndsAt - now))}`
	else
		labels.EventBoard.Text = `Next <b>Customer Rush</b> in\n{Format.clock(state.NextAt - now)}`
	end

	local lines = {}
	if state.Phase == "Active" then
		table.insert(lines, `<b>LIVE - {Format.clock(state.EndsAt - now)}</b>`)
		for index, entry in ranking() do
			if index > 6 then
				break
			end
			table.insert(lines, `{index}. {entry.Name} - {entry.Points}`)
		end
		if #lines == 1 then
			table.insert(lines, "No points yet!")
		end
	else
		table.insert(lines, `<b>Next rush in {Format.clock(state.NextAt - now)}</b>`)
		if #state.LastResults > 0 then
			table.insert(lines, "Last rush:")
			for index, entry in state.LastResults do
				if index > 5 then
					break
				end
				table.insert(lines, `{entry.Rank}. {entry.Name} - {entry.Points}`)
			end
		else
			table.insert(lines, "Serve customers at your shop\nto score points!")
		end
	end
	labels.ArenaBoard.Text = table.concat(lines, "\n")
end

local function updatePodium()
	local podium = PlotService.Town.Labels.Podium
	for place = 1, 3 do
		local entry = state.LastResults[place]
		podium[place].Text = if entry then entry.Name else "---"
	end
end

local function scheduleNext(delay: number?)
	state.Phase = "Idle"
	state.NextAt = serverNow() + (delay or math.random(RushConfig.MinInterval, RushConfig.MaxInterval))
	state.EndsAt = 0
end

local function startCountdown()
	state.Phase = "Countdown"
	state.RushId += 1
	state.Scores = {}
	state.EndsAt = serverNow() + RushConfig.Countdown
	Remotes.notifyAll("RushWarning", { Seconds = RushConfig.Countdown })
	broadcast()
end

local function startRush()
	state.Phase = "Active"
	state.EndsAt = serverNow() + RushConfig.Duration
	CustomerService.setRush(true, math.random(1, 2 ^ 30))
	broadcast()
end

local function finishRush()
	CustomerService.setRush(false)

	-- Take the scores out of shared state first so nothing can be rewarded twice.
	local ranked = ranking()
	state.Scores = {}

	local results = {}
	for rank, entry in ranked do
		local player = entry.Player
		local profile = DataService.get(player)
		if profile then
			local serves = RushConfig.RewardServes[rank]
			if not serves and entry.Points >= RushConfig.MinPointsForReward then
				serves = RushConfig.ParticipationServes
			end
			local coins = 0
			if serves then
				coins = serves * Formulas.serveWorth(profile)
				EconomyService.addCoins(player, coins)
			end
			profile.Stats.RushesPlayed += 1
			if rank == 1 and entry.Points >= RushConfig.MinPointsForWin then
				profile.Stats.RushWins += 1
				BusinessService.grantCosmetic(player, RushConfig.WinnerCosmetic)
			end
			BusinessService.checkStatCosmetics(player)
			DataService.markDirty(player)
			Remotes.notify(player, "RushResult", { Rank = rank, Points = entry.Points, Coins = coins })
			table.insert(results, {
				Player = player,
				Name = entry.Name,
				UserId = entry.UserId,
				Points = entry.Points,
				Rank = rank,
				Coins = coins,
			})
		end
	end

	state.LastResults = results
	scheduleNext()
	updatePodium()
	broadcast()
	RushService.Finished:Fire(results)
end

local function onServed(player: Player, info)
	if state.Phase ~= "Active" or info.By ~= "Player" then
		return
	end
	local profile = DataService.get(player)
	if not profile then
		return
	end
	local points = info.RushPoints * (1 + Formulas.bonuses(profile).Rush)
	if info.Fast then
		points *= 1.2
	end
	points = math.floor(points + 0.5)
	state.Scores[player] = (state.Scores[player] or 0) + points
	profile.Stats.RushPoints += points
	DataService.markDirty(player)
	scoresDirty = true
	RushService.Scored:Fire(player, points)
end

-- Starts a rush immediately (for testing / admin tools). Ignored mid-rush.
function RushService.forceStart()
	forceStart = true
end

function RushService.getPhase(): string
	return state.Phase
end

function RushService.Init() end

function RushService.Start()
	CustomerService.Served:Connect(onServed)
	Players.PlayerRemoving:Connect(function(player)
		state.Scores[player] = nil
		scoresDirty = true
	end)
	Remotes.register("GetRush", function(player)
		Remotes.Events.RushUpdate:FireClient(player, snapshot())
		return true
	end)

	-- Studio testing shortcut: set the Workspace attribute "ForceRush" to true
	-- (Explorer > Workspace > Attributes, on the server view) to start a rush now.
	if RunService:IsStudio() then
		Workspace:SetAttribute("ForceRush", false)
		Workspace:GetAttributeChangedSignal("ForceRush"):Connect(function()
			if Workspace:GetAttribute("ForceRush") == true then
				Workspace:SetAttribute("ForceRush", false)
				forceStart = true
			end
		end)
	end

	scheduleNext(RushConfig.FirstDelay)
	updatePodium()

	task.spawn(function()
		local sinceBroadcast = 0
		while true do
			task.wait(0.5)
			local now = serverNow()
			if state.Phase == "Idle" then
				local anyPlayers = next(DataService.all()) ~= nil
				if forceStart or (now >= state.NextAt and anyPlayers) then
					forceStart = false
					startCountdown()
				elseif now >= state.NextAt then
					-- Nobody here: check again shortly instead of rushing an empty town.
					state.NextAt = now + 30
				end
			elseif state.Phase == "Countdown" then
				if now >= state.EndsAt then
					startRush()
				end
			elseif state.Phase == "Active" then
				if now >= state.EndsAt then
					finishRush()
				end
			end

			sinceBroadcast += 0.5
			if scoresDirty and sinceBroadcast >= 1 then
				sinceBroadcast = 0
				broadcast()
			end
			updateBoards()
		end
	end)
end

return RushService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="36">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Build</string>
            <string name="Source"><![CDATA[-- Small helpers for building the town out of plain parts.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Make = require(Shared.Modules.Make)
local Theme = require(Shared.Config.Theme)

local Build = {}

-- An anchored, smooth part. `props` overrides any default.
function Build.part(props: { [string]: any }): Part
	local merged = {
		Anchored = true,
		Material = Enum.Material.SmoothPlastic,
		TopSurface = Enum.SurfaceType.Smooth,
		BottomSurface = Enum.SurfaceType.Smooth,
	}
	for key, value in props do
		merged[key] = value
	end
	return Make("Part", merged)
end

-- A flat disc lying on the ground (cylinders are built along the X axis).
function Build.disc(center: Vector3, radius: number, height: number, props: { [string]: any }): Part
	local merged = {
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, radius * 2, radius * 2),
		CFrame = CFrame.new(center) * CFrame.Angles(0, 0, math.pi / 2),
	}
	for key, value in props do
		merged[key] = value
	end
	return Build.part(merged)
end

-- Text on a part face. Returns the TextLabel so it can be updated later.
function Build.label(part: BasePart, face: Enum.NormalId, text: string, props: { [string]: any }?): TextLabel
	local gui = Make("SurfaceGui", {
		Name = "Label",
		Face = face,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = 30,
		LightInfluence = 0,
		Parent = part,
	})
	local labelProps = {
		Size = UDim2.fromScale(0.94, 0.9),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		Text = text,
		TextScaled = true,
		Font = Theme.Font,
		TextColor3 = Theme.White,
		Parent = gui,
	}
	if props then
		for key, value in props do
			labelProps[key] = value
		end
	end
	local label = Make("TextLabel", labelProps)
	Make("UIStroke", { Color = Theme.Dark, Thickness = 3, Parent = label })
	return label
end

-- A floating label that always faces the camera.
function Build.billboard(parent: Instance, text: string, offset: Vector3, size: UDim2?, props: { [string]: any }?): TextLabel
	local gui = Make("BillboardGui", {
		Name = "Billboard",
		Size = size or UDim2.fromScale(8, 2),
		StudsOffsetWorldSpace = offset,
		MaxDistance = 90,
		LightInfluence = 0,
		Parent = parent,
	})
	local labelProps = {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = text,
		TextScaled = true,
		Font = Theme.Font,
		TextColor3 = Theme.White,
		Parent = gui,
	}
	if props then
		for key, value in props do
			labelProps[key] = value
		end
	end
	local label = Make("TextLabel", labelProps)
	Make("UIStroke", { Color = Theme.Dark, Thickness = 2.5, Parent = label })
	return label
end

-- A standing notice board facing `cframe.LookVector`. Returns title and body labels.
function Build.board(parent: Instance, cframe: CFrame, size: Vector2, title: string, color: Color3): (TextLabel, TextLabel)
	local model = Make("Model", { Name = title, Parent = parent })
	for _, x in { -size.X / 2 + 0.6, size.X / 2 - 0.6 } do
		Build.part({
			Name = "Post",
			Size = Vector3.new(0.8, size.Y + 3, 0.8),
			CFrame = cframe * CFrame.new(x, (size.Y + 3) / 2, 0.3),
			Color = Theme.Dark,
			Parent = model,
		})
	end
	local header = Build.part({
		Name = "Header",
		Size = Vector3.new(size.X, 2.2, 0.8),
		CFrame = cframe * CFrame.new(0, size.Y + 3 - 1.1, 0),
		Color = color,
		Parent = model,
	})
	local body = Build.part({
		Name = "Body",
		Size = Vector3.new(size.X, size.Y - 2.2, 0.6),
		CFrame = cframe * CFrame.new(0, 3 + (size.Y - 2.2) / 2, 0),
		Color = Theme.Panel,
		Parent = model,
	})
	local titleLabel = Build.label(header, Enum.NormalId.Front, title)
	local bodyLabel = Build.label(body, Enum.NormalId.Front, "", {
		TextColor3 = Theme.Text,
		Font = Theme.BoldFont,
		TextScaled = true,
		RichText = true,
	})
	local stroke = bodyLabel:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke:Destroy()
	end
	return titleLabel, bodyLabel
end

-- A pedestal with a ProximityPrompt that opens a UI panel on the client
-- (the client listens for prompts carrying the "OpenPanel" attribute).
function Build.kiosk(parent: Instance, cframe: CFrame, title: string, panel: string, color: Color3): Part
	local base = Build.part({
		Name = title .. " Kiosk",
		Size = Vector3.new(4, 3.5, 4),
		CFrame = cframe * CFrame.new(0, 1.75, 0),
		Color = color,
		Parent = parent,
	})
	Build.part({
		Name = "Top",
		Size = Vector3.new(4.6, 0.5, 4.6),
		CFrame = cframe * CFrame.new(0, 3.75, 0),
		Color = Theme.White,
		Parent = base,
	})
	Build.billboard(base, title, Vector3.new(0, 5.2, 0), UDim2.fromScale(11, 2.2))
	local prompt = Make("ProximityPrompt", {
		ActionText = "Open",
		ObjectText = title,
		HoldDuration = 0,
		MaxActivationDistance = 12,
		RequiresLineOfSight = false,
		Parent = base,
	})
	prompt:SetAttribute("OpenPanel", panel)
	return base
end

function Build.tree(parent: Instance, position: Vector3, scale: number)
	local model = Make("Model", { Name = "Tree", Parent = parent })
	Build.part({
		Name = "Trunk",
		Size = Vector3.new(1.6, 6, 1.6) * scale,
		CFrame = CFrame.new(position + Vector3.new(0, 3 * scale, 0)),
		Color = Color3.fromRGB(132, 92, 62),
		Parent = model,
	})
	Build.part({
		Name = "Leaves",
		Size = Vector3.new(7, 5, 7) * scale,
		CFrame = CFrame.new(position + Vector3.new(0, 8 * scale, 0)),
		Color = Color3.fromRGB(88, 190, 96),
		Parent = model,
	})
	Build.part({
		Name = "LeavesTop",
		Size = Vector3.new(4.5, 3, 4.5) * scale,
		CFrame = CFrame.new(position + Vector3.new(0, 11.5 * scale, 0)),
		Color = Color3.fromRGB(110, 208, 110),
		Parent = model,
	})
end

function Build.lamp(parent: Instance, position: Vector3)
	local model = Make("Model", { Name = "Lamp", Parent = parent })
	Build.part({
		Name = "Pole",
		Size = Vector3.new(0.6, 10, 0.6),
		CFrame = CFrame.new(position + Vector3.new(0, 5, 0)),
		Color = Theme.Dark,
		Parent = model,
	})
	Build.part({
		Name = "Bulb",
		Size = Vector3.new(1.6, 1.6, 1.6),
		CFrame = CFrame.new(position + Vector3.new(0, 10.6, 0)),
		Color = Color3.fromRGB(255, 236, 170),
		Material = Enum.Material.Neon,
		Shape = Enum.PartType.Ball,
		Parent = model,
	})
end

return Build
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">StandBuilder</string>
            <string name="Source"><![CDATA[-- Builds the visible shop on a plot from the owner's profile: business tier, awning
-- style, Curb Appeal decorations and the equipped character team.
-- Purely visual - gameplay objects (serve prompt, register) live on the plot itself.
--
-- Plot space: the plot CFrame sits at ground level in the middle of the plot and
-- looks at the street, so local -Z is "towards the customers".

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Make = require(Shared.Modules.Make)
local Theme = require(Shared.Config.Theme)
local Businesses = require(Shared.Config.Businesses)
local Cosmetics = require(Shared.Config.Cosmetics)
local BlockheadBuilder = require(Shared.Modules.BlockheadBuilder)
local Build = require(script.Parent.Build)

local StandBuilder = {}

StandBuilder.CounterZ = -3 -- local Z of the counter on every tier
StandBuilder.CounterHeight = 3.2

local TEAM_SPOTS = { Vector3.new(-4.6, 0, 0.5), Vector3.new(4.6, 0, 0.5), Vector3.new(-2.2, 0, 3.2) }

local function roofProp(folder: Instance, origin: CFrame, business)
	local id = business.Id
	local function piece(name: string, size: Vector3, offset: CFrame, color: Color3, shape: Enum.PartType?, material: Enum.Material?)
		return Build.part({
			Name = name,
			Size = size,
			CFrame = origin * offset,
			Color = color,
			Shape = shape or Enum.PartType.Block,
			Material = material or Enum.Material.SmoothPlastic,
			CanCollide = false,
			Parent = folder,
		})
	end
	local flat = CFrame.Angles(0, 0, math.pi / 2)
	if id == "Burger" then
		piece("BunBottom", Vector3.new(1.4, 7, 7), CFrame.new(0, 0.7, 0) * flat, Color3.fromRGB(222, 160, 84), Enum.PartType.Cylinder)
		piece("Patty", Vector3.new(1.2, 7.4, 7.4), CFrame.new(0, 2, 0) * flat, Color3.fromRGB(120, 72, 48), Enum.PartType.Cylinder)
		piece("Cheese", Vector3.new(7.6, 0.4, 7.6), CFrame.new(0, 2.8, 0), Color3.fromRGB(255, 205, 56))
		piece("BunTop", Vector3.new(2.2, 7, 7), CFrame.new(0, 4.1, 0) * flat, Color3.fromRGB(232, 170, 90), Enum.PartType.Cylinder)
	elseif id == "Pizza" then
		local tilt = CFrame.Angles(math.rad(-70), 0, 0)
		piece("Crust", Vector3.new(0.8, 9, 9), CFrame.new(0, 4.6, 0) * tilt * flat, Color3.fromRGB(232, 170, 90), Enum.PartType.Cylinder)
		piece("Sauce", Vector3.new(0.9, 7.8, 7.8), CFrame.new(0, 4.6, 0) * tilt * flat, Color3.fromRGB(226, 72, 56), Enum.PartType.Cylinder)
		piece("Cheese", Vector3.new(1.0, 6.8, 6.8), CFrame.new(0, 4.6, 0) * tilt * flat, Color3.fromRGB(255, 222, 120), Enum.PartType.Cylinder)
	elseif id == "IceCream" then
		piece("Cone", Vector3.new(3, 4, 3), CFrame.new(0, 2, 0), Color3.fromRGB(232, 180, 110))
		piece("ScoopA", Vector3.new(4.4, 4.4, 4.4), CFrame.new(0, 5.4, 0), Color3.fromRGB(255, 150, 200), Enum.PartType.Ball)
		piece("ScoopB", Vector3.new(3.6, 3.6, 3.6), CFrame.new(0, 8, 0), Color3.fromRGB(255, 244, 214), Enum.PartType.Ball)
		piece("Cherry", Vector3.new(1.2, 1.2, 1.2), CFrame.new(0, 10.1, 0), Color3.fromRGB(226, 50, 60), Enum.PartType.Ball)
	elseif id == "Restaurant" then
		piece("HatBand", Vector3.new(5, 2.4, 5), CFrame.new(0, 1.2, 0), Theme.White)
		piece("HatPuff", Vector3.new(7, 3.4, 7), CFrame.new(0, 4, 0), Theme.White)
		piece("Star", Vector3.new(2, 2, 0.6), CFrame.new(0, 1.3, -2.6), Theme.Yellow, nil, Enum.Material.Neon)
	end
end

local function decorations(folder: Instance, cframe: CFrame, level: number, halfWidth: number, awningY: number, accent: Color3)
	if level >= 1 then
		for _, x in { -halfWidth - 1.5, halfWidth + 1.5 } do
			Build.part({ Name = "Planter", Size = Vector3.new(2.4, 1.6, 2.4), CFrame = cframe * CFrame.new(x, 0.8, -5), Color = Color3.fromRGB(176, 120, 84), Parent = folder })
			Build.part({ Name = "Bush", Size = Vector3.new(2.2, 1.6, 2.2), CFrame = cframe * CFrame.new(x, 2.3, -5), Color = Color3.fromRGB(88, 190, 96), Parent = folder })
			Build.part({ Name = "Flower", Size = Vector3.new(0.9, 0.9, 0.9), CFrame = cframe * CFrame.new(x, 3.4, -5), Color = Theme.Pink, Shape = Enum.PartType.Ball, CanCollide = false, Parent = folder })
		end
	end
	if level >= 2 then
		local colors = { Theme.Red, Theme.Yellow, Theme.Green, Theme.Blue, Theme.Pink }
		local count = 9
		for index = 1, count do
			local x = -halfWidth + (index - 1) * (halfWidth * 2 / (count - 1))
			Build.part({
				Name = "Light",
				Size = Vector3.new(0.7, 0.7, 0.7),
				CFrame = cframe * CFrame.new(x, awningY - 0.9, -6.2),
				Color = colors[(index - 1) % #colors + 1],
				Material = Enum.Material.Neon,
				Shape = Enum.PartType.Ball,
				CanCollide = false,
				Parent = folder,
			})
		end
	end
	if level >= 3 then
		Build.part({
			Name = "Carpet",
			Size = Vector3.new(6, 0.1, 9),
			CFrame = cframe * CFrame.new(0, 0.06, -10),
			Color = Color3.fromRGB(214, 60, 70),
			CanCollide = false,
			Parent = folder,
		})
	end
	if level >= 4 then
		for _, x in { -halfWidth - 4, halfWidth + 4 } do
			Build.part({ Name = "FlagPole", Size = Vector3.new(0.4, 14, 0.4), CFrame = cframe * CFrame.new(x, 7, -9), Color = Theme.White, Parent = folder })
			Build.part({ Name = "Flag", Size = Vector3.new(0.2, 2.6, 4), CFrame = cframe * CFrame.new(x, 12.5, -7), Color = accent, CanCollide = false, Parent = folder })
		end
	end
	if level >= 5 then
		local star = Build.part({
			Name = "Star",
			Size = Vector3.new(3, 3, 0.6),
			CFrame = cframe * CFrame.new(0, awningY + 6.4, -3.6) * CFrame.Angles(0, 0, math.rad(45)),
			Color = Theme.Yellow,
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = folder,
		})
		Make("ParticleEmitter", {
			Rate = 6,
			Lifetime = NumberRange.new(1, 1.6),
			Speed = NumberRange.new(2, 4),
			SpreadAngle = Vector2.new(180, 180),
			Size = NumberSequence.new(0.6, 0),
			Color = ColorSequence.new(Theme.Yellow),
			LightEmission = 0.8,
			Parent = star,
		})
		Make("PointLight", { Color = Theme.Yellow, Range = 18, Brightness = 1.2, Parent = star })
	end
end

-- "For rent" marker shown on plots nobody owns.
function StandBuilder.buildVacant(cframe: CFrame): Folder
	local folder = Make("Folder", { Name = "Stand" })
	Build.part({ Name = "Post", Size = Vector3.new(0.8, 7, 0.8), CFrame = cframe * CFrame.new(0, 3.5, -8), Color = Theme.Dark, Parent = folder })
	local sign = Build.part({ Name = "Sign", Size = Vector3.new(10, 4, 0.6), CFrame = cframe * CFrame.new(0, 7.5, -8), Color = Theme.White, Parent = folder })
	Build.label(sign, Enum.NormalId.Front, "FOR RENT", { TextColor3 = Theme.Red })
	return folder
end

function StandBuilder.build(cframe: CFrame, ownerName: string, profile): Folder
	local folder = Make("Folder", { Name = "Stand" })
	local tier = profile.BusinessTier
	local business = Businesses[tier]
	local cosmetic = Cosmetics.ById[profile.EquippedCosmetic] or Cosmetics.ById[Cosmetics.Default]
	local awningMaterial = if cosmetic.Neon then Enum.Material.Neon else Enum.Material.SmoothPlastic

	local counterWidth = 12
	local counterZ = StandBuilder.CounterZ
	local halfWidth = if tier == 1 then 7 else 9 + tier
	local awningY = if tier == 1 then 9 else 9.5 + tier * 0.5

	-- Counter (same place on every tier, so customers and the serve prompt never move).
	Build.part({
		Name = "Counter",
		Size = Vector3.new(counterWidth, StandBuilder.CounterHeight - 0.4, 2.2),
		CFrame = cframe * CFrame.new(0, (StandBuilder.CounterHeight - 0.4) / 2, counterZ),
		Color = business.Wall,
		Parent = folder,
	})
	Build.part({
		Name = "CounterTop",
		Size = Vector3.new(counterWidth + 0.6, 0.4, 2.8),
		CFrame = cframe * CFrame.new(0, StandBuilder.CounterHeight - 0.2, counterZ),
		Color = business.Accent,
		Parent = folder,
	})
	-- Little props on the counter.
	Build.part({
		Name = "Jug",
		Size = Vector3.new(1.2, 1.6, 1.2),
		CFrame = cframe * CFrame.new(-4, StandBuilder.CounterHeight + 0.8, counterZ),
		Color = business.Accent,
		Material = Enum.Material.Glass,
		Transparency = 0.25,
		CanCollide = false,
		Parent = folder,
	})
	Build.part({
		Name = "Register",
		Size = Vector3.new(1.6, 1.2, 1.4),
		CFrame = cframe * CFrame.new(4.4, StandBuilder.CounterHeight + 0.6, counterZ),
		Color = Theme.Dark,
		CanCollide = false,
		Parent = folder,
	})

	if tier == 1 then
		for _, x in { -halfWidth + 0.4, halfWidth - 0.4 } do
			Build.part({ Name = "Post", Size = Vector3.new(0.7, awningY, 0.7), CFrame = cframe * CFrame.new(x, awningY / 2, counterZ), Color = Theme.White, Parent = folder })
		end
	else
		local depth = 12 + tier * 2
		local backZ = 1.5 + depth
		Build.part({ Name = "Floor", Size = Vector3.new(halfWidth * 2, 0.2, depth + 5), CFrame = cframe * CFrame.new(0, 0.1, backZ - (depth + 5) / 2), Color = Theme.CardAlt, Parent = folder })
		Build.part({ Name = "BackWall", Size = Vector3.new(halfWidth * 2, awningY, 1), CFrame = cframe * CFrame.new(0, awningY / 2, backZ), Color = business.Wall, Parent = folder })
		for _, x in { -halfWidth + 0.5, halfWidth - 0.5 } do
			-- Side walls cover the back part only, leaving a walkway beside the counter.
			Build.part({ Name = "SideWall", Size = Vector3.new(1, awningY, depth - 4), CFrame = cframe * CFrame.new(x, awningY / 2, backZ - (depth - 4) / 2), Color = business.Wall, Parent = folder })
			Build.part({ Name = "Pillar", Size = Vector3.new(1.2, awningY, 1.2), CFrame = cframe * CFrame.new(x, awningY / 2, counterZ), Color = business.Accent, Parent = folder })
		end
		-- The roof covers the back of the shop only. The strip where the owner stands
		-- to serve stays open to the sky, so the camera is never pushed in by a ceiling.
		local roofFront = 3.5
		Build.part({ Name = "Roof", Size = Vector3.new(halfWidth * 2 + 2, 1, backZ + 1 - roofFront), CFrame = cframe * CFrame.new(0, awningY + 0.5, (backZ + 1 + roofFront) / 2), Color = business.Accent, Parent = folder })
		-- Shelves on the back wall.
		for row = 1, 2 do
			Build.part({ Name = "Shelf", Size = Vector3.new(halfWidth * 1.4, 0.3, 1.4), CFrame = cframe * CFrame.new(0, 2.5 + row * 2.2, backZ - 1.2), Color = business.Accent, Parent = folder })
		end
		roofProp(folder, cframe * CFrame.new(0, awningY + 1, backZ - depth / 2), business)
	end

	-- Awning with stripes.
	local awningDepth = 5.5
	Build.part({
		Name = "Awning",
		Size = Vector3.new(halfWidth * 2 + 1, 0.6, awningDepth),
		CFrame = cframe * CFrame.new(0, awningY, counterZ - 1.2) * CFrame.Angles(math.rad(8), 0, 0),
		Color = cosmetic.Color,
		Material = awningMaterial,
		CanCollide = false,
		Parent = folder,
	})
	local stripes = math.floor(halfWidth)
	for index = 1, stripes do
		local x = -halfWidth + (index - 0.5) * (halfWidth * 2 / stripes)
		if index % 2 == 0 then
			Build.part({
				Name = "Stripe",
				Size = Vector3.new(halfWidth * 2 / stripes, 0.64, awningDepth + 0.02),
				CFrame = cframe * CFrame.new(x, awningY, counterZ - 1.2) * CFrame.Angles(math.rad(8), 0, 0),
				Color = cosmetic.Stripe,
				CanCollide = false,
				Parent = folder,
			})
		end
	end

	-- Shop sign.
	local sign = Build.part({
		Name = "Sign",
		Size = Vector3.new(math.min(halfWidth * 2, 16), 3, 0.6),
		CFrame = cframe * CFrame.new(0, awningY + 2.4, counterZ - 0.6),
		Color = Theme.Dark,
		CanCollide = false,
		Parent = folder,
	})
	Build.label(sign, Enum.NormalId.Front, `{business.Emoji} {ownerName}'s {business.Name}`, { TextColor3 = cosmetic.Color })

	decorations(folder, cframe, profile.Upgrades.Appearance, halfWidth, awningY, business.Accent)

	-- The equipped team stands behind the counter.
	for index, characterId in profile.Equipped do
		local spot = TEAM_SPOTS[index]
		if spot then
			local position = cframe * CFrame.new(spot.X, if tier == 1 then 0 else 0.2, spot.Z)
			local figure = BlockheadBuilder.buildCharacter(characterId, position)
			if figure then
				figure.Parent = folder
			end
		end
	end

	return folder
end

return StandBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">TownBuilder</string>
            <string name="Source"><![CDATA[-- Builds BLOCKHEADS TOWN from code at server start, so the place file needs no
-- hand-built map. Each district is one function; add a new district by writing a
-- new build function and calling it from TownBuilder.build().
--
-- Layout (top-down, Y is up, ground at Y = 0):
--   Main Plaza         centre (0, 0, 0)
--   Business Street    north  (-Z), 8 plots, 4 per side
--   Character Center   east   (+X)
--   Competition Arena  west   (-X)
--   Upgrade District   south  (+Z)

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Make = require(Shared.Modules.Make)
local Theme = require(Shared.Config.Theme)
local GameConfig = require(Shared.Config.GameConfig)
local Characters = require(Shared.Config.Characters)
local BlockheadBuilder = require(Shared.Modules.BlockheadBuilder)
local Build = require(script.Parent.Build)

local TownBuilder = {}

local GROUND_Y = 0.2 -- top surface of every walkable pad
local PLAZA_RADIUS = 58
local DISTRICT_DISTANCE = 140
local DISTRICT_RADIUS = 38

local STREET_START_Z = -58
local PLOT_FIRST_Z = -98
local PLOT_SPACING = 46
local PLOT_X = 36
local PLOT_SIZE = 36
local STREET_END_Z = PLOT_FIRST_Z - PLOT_SPACING * 3 - 38

local STONE = Color3.fromRGB(236, 226, 206)
local PATH = Color3.fromRGB(222, 208, 182)
local ROAD = Color3.fromRGB(92, 98, 120)

local function pad(parent: Instance, name: string, size: Vector3, center: Vector3, color: Color3, material: Enum.Material?)
	return Build.part({
		Name = name,
		Size = size,
		CFrame = CFrame.new(center.X, GROUND_Y - size.Y / 2, center.Z),
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
		Parent = parent,
	})
end

local function setupLighting()
	Lighting.ClockTime = 14.5
	Lighting.Brightness = 2.6
	Lighting.Ambient = Color3.fromRGB(120, 120, 130)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 160)
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.4
	if not Lighting:FindFirstChildOfClass("Atmosphere") then
		Make("Atmosphere", {
			Density = 0.28,
			Offset = 0.1,
			Color = Color3.fromRGB(200, 225, 255),
			Decay = Color3.fromRGB(255, 240, 220),
			Glare = 0.1,
			Haze = 1.2,
			Parent = Lighting,
		})
	end
end

-- Portals teleport a character that touches the pad.
local portalCooldown: { [Player]: number } = {}

local function portal(parent: Instance, cframe: CFrame, title: string, color: Color3, destination: CFrame)
	local model = Make("Model", { Name = title .. " Portal", Parent = parent })
	for _, x in { -3.4, 3.4 } do
		Build.part({
			Name = "Pillar",
			Size = Vector3.new(1.2, 9, 1.2),
			CFrame = cframe * CFrame.new(x, 4.5, 0),
			Color = Theme.White,
			Parent = model,
		})
	end
	local top = Build.part({
		Name = "Top",
		Size = Vector3.new(9, 2, 1.4),
		CFrame = cframe * CFrame.new(0, 10, 0),
		Color = color,
		Parent = model,
	})
	Build.label(top, Enum.NormalId.Front, title)
	Build.label(top, Enum.NormalId.Back, title)
	Build.part({
		Name = "Glow",
		Size = Vector3.new(5.6, 8.6, 0.3),
		CFrame = cframe * CFrame.new(0, 4.5, 0),
		Color = color,
		Material = Enum.Material.Neon,
		Transparency = 0.45,
		CanCollide = false,
		Parent = model,
	})
	local trigger = Build.part({
		Name = "Trigger",
		Size = Vector3.new(5.6, 8, 2),
		CFrame = cframe * CFrame.new(0, 4.2, 0),
		Transparency = 1,
		CanCollide = false,
		Parent = model,
	})
	trigger.Touched:Connect(function(hit)
		local character = hit.Parent
		local player = character and Players:GetPlayerFromCharacter(character)
		if not player then
			return
		end
		local now = os.clock()
		if now - (portalCooldown[player] or 0) < 2 then
			return
		end
		portalCooldown[player] = now
		character:PivotTo(destination)
	end)
end

---------------------------------------------------------------------------------------
-- Districts
---------------------------------------------------------------------------------------

local function buildGround(town: Instance)
	Build.part({
		Name = "Grass",
		Size = Vector3.new(900, 4, 900),
		CFrame = CFrame.new(0, -2, 0),
		Color = Color3.fromRGB(126, 204, 116),
		Material = Enum.Material.Grass,
		Parent = town,
	})

	local decor = Make("Folder", { Name = "Decor", Parent = town })
	local rng = Random.new(2024)
	local placed = 0
	while placed < 46 do
		local x, z = rng:NextNumber(-250, 250), rng:NextNumber(-300, 250)
		local onStreet = z < STREET_START_Z + 10 and math.abs(x) < PLOT_X + PLOT_SIZE / 2 + 8
		local onCross = math.abs(x) < 14 or (math.abs(z) < 14 and z > -40)
		local nearCenter = Vector3.new(x, 0, z).Magnitude < PLAZA_RADIUS + 8
		local nearDistrict = false
		for _, center in { Vector3.new(DISTRICT_DISTANCE, 0, 0), Vector3.new(-DISTRICT_DISTANCE, 0, 0), Vector3.new(0, 0, DISTRICT_DISTANCE) } do
			if (Vector3.new(x, 0, z) - center).Magnitude < DISTRICT_RADIUS + 8 then
				nearDistrict = true
			end
		end
		if not (onStreet or onCross or nearCenter or nearDistrict) then
			Build.tree(decor, Vector3.new(x, 0, z), rng:NextNumber(0.9, 1.5))
			placed += 1
		end
	end
end

local function buildPlaza(town: Instance, result)
	local plaza = Make("Model", { Name = "MainPlaza", Parent = town })
	Build.disc(Vector3.new(0, GROUND_Y - 0.3, 0), PLAZA_RADIUS, 0.6, { Name = "Floor", Color = STONE, Parent = plaza })
	Build.disc(Vector3.new(0, GROUND_Y - 0.25, 0), 30, 0.6, { Name = "Ring", Color = Color3.fromRGB(255, 222, 140), Parent = plaza })

	-- Fountain with a golden Blockhead on top.
	Build.disc(Vector3.new(0, GROUND_Y + 0.8, 0), 11, 1.6, { Name = "FountainRim", Color = Theme.White, Parent = plaza })
	Build.disc(Vector3.new(0, GROUND_Y + 1.0, 0), 9.6, 1.6, {
		Name = "Water",
		Color = Color3.fromRGB(96, 196, 255),
		Material = Enum.Material.Neon,
		Transparency = 0.25,
		CanCollide = false,
		Parent = plaza,
	})
	Build.part({
		Name = "Pedestal",
		Size = Vector3.new(5, 5, 5),
		CFrame = CFrame.new(0, GROUND_Y + 2.5, 0),
		Color = Theme.White,
		Parent = plaza,
	})
	local gold = Color3.fromRGB(255, 200, 50)
	local statue = BlockheadBuilder.build({
		Skin = gold,
		Shirt = gold,
		Pants = gold,
		Eyes = "Dot",
		Mouth = "Grin",
		Hat = "Crown",
		HatColor = gold,
		Scale = 1.5,
	}, CFrame.lookAt(Vector3.new(0, GROUND_Y + 5, 0), Vector3.new(0, GROUND_Y + 5, 10)))
	statue.Name = "GoldenBlockhead"
	statue.Parent = plaza

	-- Spawn points around the fountain.
	for index = 1, 6 do
		local angle = math.rad(40 + index * 14)
		local position = Vector3.new(math.cos(angle) * 22, GROUND_Y + 0.5, math.sin(angle) * 22)
		Make("SpawnLocation", {
			Name = "Spawn" .. index,
			Size = Vector3.new(6, 1, 6),
			CFrame = CFrame.lookAt(position, Vector3.new(0, position.Y, -40)),
			Anchored = true,
			Transparency = 1,
			CanCollide = false,
			Neutral = true,
			Duration = 0,
			Parent = plaza,
		})
	end
	result.PlazaArrival = CFrame.lookAt(Vector3.new(0, GROUND_Y + 3.5, 24), Vector3.new(0, GROUND_Y + 3.5, 0))

	-- Boards, arranged around the southern half so the street view stays open.
	local function around(angleDegrees: number, radius: number): CFrame
		local angle = math.rad(angleDegrees)
		local position = Vector3.new(math.cos(angle) * radius, GROUND_Y, math.sin(angle) * radius)
		return CFrame.lookAt(position, Vector3.new(0, GROUND_Y, 0))
	end

	local _, welcome = Build.board(plaza, around(40, 48), Vector2.new(20, 11), "WELCOME TO BLOCKHEADS TOWN", Theme.Blue)
	welcome.Text = "Run your shop on <b>Business Street</b>\nServe customers. Earn Block Coins.\nCollect every Blockhead.\nWin the <b>Customer Rush</b>!"

	local _, leaderboard = Build.board(plaza, around(135, 48), Vector2.new(20, 13), "🏆 TOP TYCOONS", Theme.Orange)
	leaderboard.Text = "Loading..."
	leaderboard.TextXAlignment = Enum.TextXAlignment.Left
	result.Labels.GlobalLeaderboard = leaderboard

	local _, events = Build.board(plaza, around(68, 48), Vector2.new(18, 9), "📣 EVENTS", Theme.Red)
	events.Text = "Next Customer Rush soon!"
	result.Labels.EventBoard = events

	Build.kiosk(plaza, around(14, 44), "🎁 Daily Reward", "Daily", Theme.Green)
	Build.kiosk(plaza, around(166, 44), "📜 Daily Quests", "Quests", Theme.Purple)

	-- Lamps and benches.
	for index = 0, 11 do
		local angle = math.rad(index * 30 + 15)
		Build.lamp(plaza, Vector3.new(math.cos(angle) * (PLAZA_RADIUS - 3), GROUND_Y, math.sin(angle) * (PLAZA_RADIUS - 3)))
	end

	-- Portals to each district, just beside the walking paths.
	local east = CFrame.lookAt(Vector3.new(DISTRICT_DISTANCE - 22, GROUND_Y + 3.5, 0), Vector3.new(DISTRICT_DISTANCE, GROUND_Y + 3.5, 0))
	local west = CFrame.lookAt(Vector3.new(-DISTRICT_DISTANCE + 22, GROUND_Y + 3.5, 0), Vector3.new(-DISTRICT_DISTANCE, GROUND_Y + 3.5, 0))
	local south = CFrame.lookAt(Vector3.new(0, GROUND_Y + 3.5, DISTRICT_DISTANCE - 22), Vector3.new(0, GROUND_Y + 3.5, DISTRICT_DISTANCE))
	local north = CFrame.lookAt(Vector3.new(0, GROUND_Y + 3.5, STREET_START_Z - 14), Vector3.new(0, GROUND_Y + 3.5, STREET_END_Z))
	portal(plaza, around(-70, 44), "Business Street", Theme.Yellow, north)
	portal(plaza, around(-20, 44), "Character Center", Theme.Pink, east)
	portal(plaza, around(200, 44), "Arena", Theme.Red, west)
	portal(plaza, around(108, 44), "Upgrade District", Theme.Green, south)
	result.Arrivals = { East = east, West = west, South = south, North = north }
end

local function buildStreet(town: Instance, result)
	local street = Make("Model", { Name = "BusinessStreet", Parent = town })
	local length = STREET_START_Z - STREET_END_Z
	local centerZ = (STREET_START_Z + STREET_END_Z) / 2

	pad(street, "Road", Vector3.new(24, 0.4, length), Vector3.new(0, 0, centerZ), ROAD)
	for _, x in { -15, 15 } do
		pad(street, "Sidewalk", Vector3.new(6, 0.4, length), Vector3.new(x, 0, centerZ), STONE)
	end
	-- Dashed centre line.
	local z = STREET_START_Z - 6
	while z > STREET_END_Z + 6 do
		Build.part({
			Name = "Dash",
			Size = Vector3.new(0.8, 0.1, 5),
			CFrame = CFrame.new(0, GROUND_Y + 0.02, z),
			Color = Theme.Yellow,
			CanCollide = false,
			Parent = street,
		})
		z -= 12
	end

	-- Entrance arch.
	for _, x in { -13, 13 } do
		Build.part({
			Name = "ArchPost",
			Size = Vector3.new(2, 16, 2),
			CFrame = CFrame.new(x, GROUND_Y + 8, STREET_START_Z - 2),
			Color = Theme.Dark,
			Parent = street,
		})
	end
	local arch = Build.part({
		Name = "Arch",
		Size = Vector3.new(30, 5, 2),
		CFrame = CFrame.new(0, GROUND_Y + 17, STREET_START_Z - 2),
		Color = Theme.Yellow,
		Parent = street,
	})
	Build.label(arch, Enum.NormalId.Back, "BUSINESS STREET")
	Build.label(arch, Enum.NormalId.Front, "MAIN PLAZA")

	-- Bus stops on the sidewalks between the plots: customers arrive and leave here,
	-- so every shop has a stop a short walk away.
	local stops = {}
	for gap = 0, 4 do
		local stopZ = PLOT_FIRST_Z + PLOT_SPACING / 2 - PLOT_SPACING * gap
		for _, x in { -15, 15 } do
			table.insert(stops, Vector3.new(x, GROUND_Y, stopZ))
			Build.part({
				Name = "BusStopPole",
				Size = Vector3.new(0.4, 7, 0.4),
				CFrame = CFrame.new(x + (if x < 0 then -2.2 else 2.2), GROUND_Y + 3.5, stopZ),
				Color = Theme.White,
				Parent = street,
			})
			local stopSign = Build.part({
				Name = "BusStopSign",
				Size = Vector3.new(0.3, 2.4, 2.4),
				CFrame = CFrame.new(x + (if x < 0 then -2.2 else 2.2), GROUND_Y + 7.6, stopZ),
				Color = Theme.Blue,
				Parent = street,
			})
			Build.label(stopSign, if x < 0 then Enum.NormalId.Right else Enum.NormalId.Left, "🚌")
		end
	end

	-- A covered terminal at the far end of the street.
	local farZ = STREET_END_Z + 2
	Build.part({
		Name = "TerminalRoof",
		Size = Vector3.new(22, 0.8, 8),
		CFrame = CFrame.new(0, GROUND_Y + 10, farZ),
		Color = Theme.Blue,
		Parent = street,
	})
	for _, x in { -10, 10 } do
		Build.part({
			Name = "TerminalPost",
			Size = Vector3.new(1, 10, 1),
			CFrame = CFrame.new(x, GROUND_Y + 5, farZ - 3),
			Color = Theme.White,
			Parent = street,
		})
	end
	local busSign = Build.part({
		Name = "TerminalSign",
		Size = Vector3.new(14, 3, 0.6),
		CFrame = CFrame.new(0, GROUND_Y + 12, farZ + 3),
		Color = Theme.Blue,
		Parent = street,
	})
	Build.label(busSign, Enum.NormalId.Back, "🚌 BUS TERMINAL")

	for row = 0, 3 do
		local rowZ = PLOT_FIRST_Z - PLOT_SPACING * row
		Build.lamp(street, Vector3.new(-17, GROUND_Y, rowZ + PLOT_SPACING / 2))
		Build.lamp(street, Vector3.new(17, GROUND_Y, rowZ + PLOT_SPACING / 2))
	end

	result.BusStops = stops
	result.PlotCFrames = {}
	for index = 1, GameConfig.MaxPlots do
		local row = (index - 1) // 2
		local side = if (index - 1) % 2 == 0 then -1 else 1
		local position = Vector3.new(side * PLOT_X, GROUND_Y, PLOT_FIRST_Z - PLOT_SPACING * row)
		result.PlotCFrames[index] = CFrame.lookAt(position, Vector3.new(0, GROUND_Y, position.Z))
	end
	result.PlotSize = PLOT_SIZE
end

local function districtBase(town: Instance, name: string, center: Vector3, color: Color3, pathFrom: Vector3): Model
	local model = Make("Model", { Name = name, Parent = town })
	Build.disc(Vector3.new(center.X, GROUND_Y - 0.3, center.Z), DISTRICT_RADIUS, 0.6, { Name = "Floor", Color = STONE, Parent = model })
	Build.disc(Vector3.new(center.X, GROUND_Y - 0.25, center.Z), DISTRICT_RADIUS - 6, 0.6, { Name = "Inner", Color = color, Parent = model })

	-- Walking path back to the plaza.
	local delta = center - pathFrom
	local pathLength = delta.Magnitude - DISTRICT_RADIUS + 4
	local direction = delta.Unit
	local middle = pathFrom + direction * (pathLength / 2)
	Build.part({
		Name = "Path",
		Size = Vector3.new(16, 0.4, pathLength),
		CFrame = CFrame.lookAt(Vector3.new(middle.X, GROUND_Y - 0.21, middle.Z), Vector3.new(center.X, GROUND_Y - 0.21, center.Z)),
		Color = PATH,
		Parent = model,
	})
	return model
end

local function buildCharacterCenter(town: Instance, result)
	local center = Vector3.new(DISTRICT_DISTANCE, 0, 0)
	local model = districtBase(town, "CharacterCenter", center, Color3.fromRGB(255, 214, 232), Vector3.new(PLAZA_RADIUS - 4, 0, 0))

	local signCFrame = CFrame.lookAt(Vector3.new(center.X + 30, GROUND_Y, 0), Vector3.new(center.X, GROUND_Y, 0))
	Build.part({
		Name = "BackWall",
		Size = Vector3.new(44, 16, 2),
		CFrame = signCFrame * CFrame.new(0, 8, 0),
		Color = Theme.Pink,
		Parent = model,
	})
	local sign = Build.part({
		Name = "Sign",
		Size = Vector3.new(36, 5, 1),
		CFrame = signCFrame * CFrame.new(0, 13, -1.4),
		Color = Theme.White,
		Parent = model,
	})
	Build.label(sign, Enum.NormalId.Front, "CHARACTER CENTER", { TextColor3 = Theme.Pink })

	-- Display area: one pedestal per character in an arc.
	local display = Make("Folder", { Name = "Display", Parent = model })
	local count = #Characters.List
	for index, character in Characters.List do
		local angle = math.rad(-70 + (index - 1) * (140 / math.max(1, count - 1)))
		local position = Vector3.new(center.X + math.cos(angle) * 22, GROUND_Y, math.sin(angle) * 22)
		local facing = CFrame.lookAt(position, Vector3.new(center.X - 6, GROUND_Y, 0))
		local rarity = Characters.Rarities[character.Rarity]
		local pedestal = Build.part({
			Name = character.Id .. "Pedestal",
			Size = Vector3.new(4.4, 1.6, 4.4),
			CFrame = facing * CFrame.new(0, 0.8, 0),
			Color = rarity.Color,
			Parent = display,
		})
		local figure = BlockheadBuilder.buildCharacter(character.Id, facing * CFrame.new(0, 1.6, 0))
		if figure then
			figure.Parent = display
		end
		Build.billboard(pedestal, character.Name, Vector3.new(0, 9.4, 0), UDim2.fromScale(7, 1.4))
		Build.billboard(pedestal, character.Rarity, Vector3.new(0, 8.2, 0), UDim2.fromScale(5, 1), { TextColor3 = rarity.Color })
	end

	Build.kiosk(model, CFrame.new(center.X - 8, GROUND_Y, 0), "📖 Collection", "Characters:Collection", Theme.Pink)
	Build.kiosk(model, CFrame.new(center.X - 8, GROUND_Y, 12), "🧱 My Team", "Characters:Team", Theme.Blue)
	portal(model, CFrame.lookAt(Vector3.new(center.X - 18, GROUND_Y, -24), Vector3.new(center.X, GROUND_Y, 0)), "Main Plaza", Theme.Blue, result.PlazaArrival)
end

local function buildArena(town: Instance, result)
	local center = Vector3.new(-DISTRICT_DISTANCE, 0, 0)
	local model = districtBase(town, "Arena", center, Color3.fromRGB(255, 196, 170), Vector3.new(-PLAZA_RADIUS + 4, 0, 0))

	Build.disc(Vector3.new(center.X, GROUND_Y - 0.2, 0), 14, 0.6, { Name = "Stage", Color = Theme.Red, Parent = model })

	local boardCFrame = CFrame.lookAt(Vector3.new(center.X - 30, GROUND_Y, 0), Vector3.new(center.X, GROUND_Y, 0))
	local _, board = Build.board(model, boardCFrame, Vector2.new(30, 17), "⚡ CUSTOMER RUSH", Theme.Red)
	board.Text = "The next rush is coming..."
	result.Labels.ArenaBoard = board

	-- Winners' podium.
	result.Labels.Podium = {}
	local podium = {
		{ Place = 1, X = 0, Height = 5, Color = Color3.fromRGB(255, 205, 56) },
		{ Place = 2, X = -6, Height = 3.6, Color = Color3.fromRGB(200, 206, 220) },
		{ Place = 3, X = 6, Height = 2.6, Color = Color3.fromRGB(214, 140, 80) },
	}
	for _, step in podium do
		local block = Build.part({
			Name = "Podium" .. step.Place,
			Size = Vector3.new(6, step.Height, 6),
			CFrame = boardCFrame * CFrame.new(step.X, step.Height / 2, -18),
			Color = step.Color,
			Parent = model,
		})
		Build.label(block, Enum.NormalId.Front, "#" .. step.Place)
		result.Labels.Podium[step.Place] = Build.billboard(block, "---", Vector3.new(0, step.Height / 2 + 7.5, 0), UDim2.fromScale(9, 1.6))
	end

	Build.kiosk(model, CFrame.new(center.X + 14, GROUND_Y, 14), "🏆 Rush Info", "Rush", Theme.Red)
	portal(model, CFrame.lookAt(Vector3.new(center.X + 18, GROUND_Y, -24), Vector3.new(center.X, GROUND_Y, 0)), "Main Plaza", Theme.Blue, result.PlazaArrival)
end

local function buildUpgradeDistrict(town: Instance, result)
	local center = Vector3.new(0, 0, DISTRICT_DISTANCE)
	local model = districtBase(town, "UpgradeDistrict", center, Color3.fromRGB(196, 236, 204), Vector3.new(0, 0, PLAZA_RADIUS - 4))

	local back = CFrame.lookAt(Vector3.new(0, GROUND_Y, center.Z + 30), Vector3.new(0, GROUND_Y, center.Z))
	Build.part({
		Name = "Workshop",
		Size = Vector3.new(48, 14, 6),
		CFrame = back * CFrame.new(0, 7, 2),
		Color = Theme.Green,
		Parent = model,
	})
	local sign = Build.part({
		Name = "Sign",
		Size = Vector3.new(36, 5, 1),
		CFrame = back * CFrame.new(0, 16.5, 0),
		Color = Theme.White,
		Parent = model,
	})
	Build.label(sign, Enum.NormalId.Front, "UPGRADE DISTRICT", { TextColor3 = Theme.Green })

	Build.kiosk(model, back * CFrame.new(-14, 0, -8), "⬆️ Upgrades", "Upgrades", Theme.Green)
	Build.kiosk(model, back * CFrame.new(0, 0, -8), "🏪 New Shops", "Shop:Business", Theme.Orange)
	Build.kiosk(model, back * CFrame.new(14, 0, -8), "🎨 Shop Style", "Shop:Style", Theme.Purple)
	portal(model, CFrame.lookAt(Vector3.new(-24, GROUND_Y, center.Z - 18), Vector3.new(0, GROUND_Y, center.Z)), "Main Plaza", Theme.Blue, result.PlazaArrival)
end

---------------------------------------------------------------------------------------

function TownBuilder.build()
	local result = {
		Labels = {},
		PlotCFrames = {},
		BusStops = {},
		GroundY = GROUND_Y,
	}

	setupLighting()

	-- If the scripts were synced into Studio's default Baseplate template, remove its
	-- floor and its spawn (which would sit inside the fountain). Runtime only.
	for _, name in { "Baseplate", "SpawnLocation" } do
		local leftover = Workspace:FindFirstChild(name)
		if leftover and leftover:IsA("BasePart") then
			leftover:Destroy()
		end
	end

	local town = Make("Folder", { Name = "Town" })
	buildGround(town)
	buildPlaza(town, result)
	buildStreet(town, result)
	buildCharacterCenter(town, result)
	buildArena(town, result)
	buildUpgradeDistrict(town, result)
	town.Parent = Workspace

	result.Town = town
	result.PlotsFolder = Make("Folder", { Name = "ShopPlots", Parent = Workspace })
	result.NPCFolder = Make("Folder", { Name = "NPCs", Parent = Workspace })

	Players.PlayerRemoving:Connect(function(player)
		portalCooldown[player] = nil
	end)
	return result
end

return TownBuilder
]]></string>
